{%- doc -%}
  Senseless — cart add-on offer row (INLINE, in-drawer). NOT a popup.

  Per "Upsell & Cross-sell Strategy — site-wide": ONE suggested add, paired with the free-shipping
  bar, to complete the cart-upsell loop. No pop-ups / urgency / scarcity — value framing only.

  Offer LOGIC adapted from Totally Numb sections/tn-cart-upsell.liquid @ 36b0af4 (System 2):
  product wiring + the "already in cart" guard + AJAX add + dismiss state ONLY. The popup
  presentation is deliberately NOT ported, and System 1 (free-shipping bar =
  senseless-shipping-banner) is untouched.

  Add mechanism reuses Horizon <product-form-component> + add-to-cart-button (same plumbing as
  senseless-quick-add) → AJAX /cart/add → the cart drawer refreshes. Rendered from
  cart-summary.liquid, so it appears in the drawer + cart page and re-evaluates on every cart
  re-render (auto-hides the moment the offer product is added).

  Hidden when: product missing / unavailable · already in cart · dismissed this session ·
  a bundle suggestion is active (placeholder hook — the cart bundle-suggestion logic from the
  strategy page is NOT built yet; this defers to it cleanly once it exists).

  @param {string} [section_id] - host cart section id (wires product-form-component)
{%- enddoc -%}
{%- liquid
  assign offer_handle = 'vitamin-a-d-ointment-4-pack'
  assign offer = all_products[offer_handle]
  assign offer_variant = offer.selected_or_first_available_variant

  assign show = false
  if offer != blank and offer_variant != blank and offer_variant.available
    assign show = true
  endif

  # Already in the cart? (TN System-2 guard.) Re-evaluated on every cart re-render.
  if show
    for item in cart.items
      if item.variant_id == offer_variant.id
        assign show = false
        break
      endif
    endfor
  endif

  # Bundle-suggestion deference (one mechanism per moment). The cart bundle-suggestion logic
  # from the Upsell & Cross-sell Strategy is not yet built; this hook keeps the ointment offer
  # subordinate to it for when it lands. Currently always false → ointment shows.
  assign bundle_suggestion_active = false
  if bundle_suggestion_active
    assign show = false
  endif

  assign form_id = 'SSCartOffer-' | append: section_id | append: '-' | append: offer.id
-%}
{%- if show -%}
  {%- liquid
    assign price_str = offer_variant.price | money
  -%}
  <div class="ss-co" data-ss-cart-offer>
    <button type="button" class="ss-co__dismiss" data-ss-cart-offer-dismiss aria-label="Dismiss this suggestion">&times;</button>
    <div class="ss-co__head">
      <div class="ss-co__media">
        {%- if offer.featured_image -%}
          <img class="ss-co__img" src="{{ offer.featured_image | image_url: width: 120 }}" alt="{{ offer.featured_image.alt | default: offer.title | escape }}" width="56" height="56" loading="lazy">
        {%- else -%}
          <span class="ss-co__ph" aria-hidden="true">{{ 'image' | placeholder_svg_tag }}</span>
        {%- endif -%}
      </div>
      <div class="ss-co__text">
        <p class="ss-co__eyebrow">Complete your aftercare</p>
        <p class="ss-co__title">{{ offer.title | escape }}</p>
        <p class="ss-co__desc">Keeps freshly treated skin comfortable and protected.</p>
        <p class="ss-co__price">{{ price_str }} each</p>
      </div>
    </div>
    <div class="ss-co__actions">
      <div class="ss-co__qty" role="group" aria-label="Quantity">
        <button type="button" class="ss-co__qbtn" data-ss-co-dec aria-label="Decrease quantity">&minus;</button>
        <span class="ss-co__qval" data-ss-co-qval aria-live="polite">1</span>
        <button type="button" class="ss-co__qbtn" data-ss-co-inc aria-label="Increase quantity">+</button>
      </div>
      <product-form-component
        data-section-id="{{ section_id }}"
        data-product-id="{{ offer.id }}"
        on:submit="/handleSubmit"
        class="ss-co__form"
      >
        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
        {%- form 'product', offer, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" ref="variantId" value="{{ offer_variant.id }}">
          <input type="hidden" name="quantity" value="1" data-ss-co-qin>
          {% render 'add-to-cart-button',
            product: offer,
            can_add_to_cart: true,
            add_to_cart_text: 'Add to order',
            class: 'ss-co__add',
            id: form_id
          %}
        {%- endform -%}
      </product-form-component>
    </div>
  </div>

  {%- comment -%} Behaviour (dismiss + qty stepper + dismissed-state) is in assets/senseless-cart-offer.js,
     enqueued globally from layout/theme.liquid. It must NOT be inline here: this snippet is AJAX-injected
     into the cart drawer on re-render, and inline <script> inserted as HTML never executes. {%- endcomment -%}

  {%- style -%}
    .ss-co {
      --ss-co-purple: #6B3FA0; --ss-co-ink: #1A1816; --ss-co-body: #2B2730;
      --ss-co-border: #E5E2DC;
      --ss-co-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      position: relative; display: flex; flex-direction: column; gap: 12px;
      background: linear-gradient(180deg, #F4EEFB 0%, #FBF9FE 100%);
      border: 1px solid rgba(107, 63, 160, 0.28); border-radius: 12px;
      padding: 14px; margin: 0 0 14px; font-family: var(--ss-co-sans);
      box-shadow: 0 1px 3px rgba(107, 63, 160, 0.10);
    }
    .ss-co[hidden] { display: none; }
    .ss-co__head { display: flex; align-items: center; gap: 12px; padding-right: 20px; }
    .ss-co__media { flex: 0 0 56px; width: 56px; height: 56px; border-radius: 8px; overflow: hidden; background: #fff; border: 1px solid var(--ss-co-border); }
    .ss-co__img, .ss-co__media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ss-co__ph { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
    .ss-co__ph svg { width: 60%; opacity: 0.22; fill: var(--ss-co-purple); }
    .ss-co__text { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .ss-co__eyebrow { margin: 0; font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ss-co-purple); }
    .ss-co__title { margin: 0; font-size: 14px; font-weight: 600; line-height: 1.3; color: var(--ss-co-ink); }
    .ss-co__desc { margin: 1px 0 0; font-size: 12.5px; font-weight: 400; line-height: 1.4; color: var(--ss-co-body); }
    .ss-co__price { margin: 3px 0 0; font-size: 12.5px; font-weight: 600; color: var(--ss-co-purple); }
    .ss-co__actions { display: flex; align-items: stretch; gap: 10px; }
    .ss-co__qty {
      flex: 0 0 auto; display: inline-flex; align-items: center; background: #fff;
      border: 1px solid rgba(107, 63, 160, 0.30); border-radius: 14px; overflow: hidden;
    }
    .ss-co__qbtn {
      width: 36px; height: 44px; border: 0; background: transparent; color: var(--ss-co-purple);
      font-size: 18px; line-height: 1; cursor: pointer; padding: 0;
      transition: background-color 0.12s ease;
    }
    .ss-co__qbtn:hover { background: rgba(107, 63, 160, 0.08); }
    .ss-co__qval { min-width: 26px; text-align: center; font-size: 14px; font-weight: 600; color: var(--ss-co-ink); }
    .ss-co__form { flex: 1 1 auto; min-width: 0; }
    .ss-co .ss-co__add {
      width: 100%; box-sizing: border-box; min-height: 44px; display: flex; align-items: center; justify-content: center;
      border-radius: 14px; border: 1px solid var(--ss-co-purple); background: var(--ss-co-purple); color: #fff;
      font-family: var(--ss-co-sans); font-weight: 600; font-size: 14px; line-height: 1; padding: 0 16px; cursor: pointer;
      box-shadow: 0 2px 8px rgba(107, 63, 160, 0.28);
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.1s ease, box-shadow 0.15s ease;
    }
    .ss-co .ss-co__add:hover { background: #5A3489; border-color: #5A3489; box-shadow: 0 4px 14px rgba(107, 63, 160, 0.34); }
    .ss-co .ss-co__add:active { transform: translateY(1px); }
    .ss-co__dismiss {
      position: absolute; top: 8px; right: 10px; width: 22px; height: 22px; border: 0; background: transparent;
      color: var(--ss-co-body); opacity: 0.4; font-size: 18px; line-height: 1; cursor: pointer; padding: 0; z-index: 2;
    }
    .ss-co__dismiss:hover { opacity: 0.85; }
    @media (prefers-reduced-motion: reduce) { .ss-co .ss-co__add { transition: none; transform: none; } }
  {%- endstyle -%}
{%- endif -%}
