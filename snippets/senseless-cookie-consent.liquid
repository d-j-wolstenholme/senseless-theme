{%- comment -%}
  Senseless — Cookie consent banner (global component, Canonical State §6).
  UK GDPR + PECR compliant. Rendered once from layout/theme.liquid before </body>.
  GENUINELY gates non-essential cookies via Shopify's Customer Privacy / Consent Tracking API
  (window.Shopify.customerPrivacy — loadFeatures + setTrackingConsent). Analytics + Marketing
  default to DENIED: nothing is recorded until the visitor clicks. A synchronous first-party flag
  (localStorage 'ss_cookie_choice_v1') is the source of truth for WHETHER the banner shows — it
  survives full page navigations, so the banner does not re-show; on init the stored choice is
  re-asserted to the Shopify API for pixel/marketing gating. Re-openable from the footer "Cookie settings" link
  ([data-ss-cookie-settings]). Equal-prominence Accept / Reject (PECR: reject as easy as accept).
  Policy link is interim → /policies/privacy-policy until the Stage F page lands (FLAG to repoint).
{%- endcomment -%}

{%- style -%}
  .ss-cc { --cc-purple:#6B3FA0; --cc-purple-hover:#5A3489; --cc-cream:#f7f7f5; --cc-ink:#2B2730; --cc-muted:#5C5853; --cc-border:rgba(26,24,22,0.14);
    --cc-sans:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    position:fixed; left:0; right:0; bottom:0; z-index:1000; font-family:var(--cc-sans); }
  .ss-cc[hidden]{ display:none; }
  .ss-cc__inner{ max-width:1100px; margin:0 auto 16px; background:var(--cc-cream); color:var(--cc-ink); border:1px solid var(--cc-border); border-radius:14px; box-shadow:0 12px 40px rgba(36,24,54,0.16); padding:18px 20px; display:flex; flex-wrap:wrap; align-items:center; gap:16px 24px; }
  .ss-cc__body{ flex:1 1 320px; min-width:0; }
  .ss-cc__title{ font-weight:700; font-size:14px; margin:0 0 4px; color:var(--cc-ink); }
  .ss-cc__text{ font-weight:400; font-size:13px; line-height:1.5; margin:0; color:var(--cc-muted); max-width:64ch; }
  .ss-cc__link{ color:var(--cc-purple); text-decoration:underline; }
  .ss-cc__actions{ display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
  .ss-cc__btn{ font-family:var(--cc-sans); font-weight:600; font-size:13px; border-radius:12px; cursor:pointer; transition:background-color .15s ease,color .15s ease,border-color .15s ease; }
  .ss-cc__btn--primary{ height:42px; padding:0 18px; min-width:160px; background:var(--cc-purple); color:#fff; border:1px solid var(--cc-purple); }
  .ss-cc__btn--primary:hover{ background:var(--cc-purple-hover); border-color:var(--cc-purple-hover); }
  .ss-cc__btn--text{ height:42px; padding:0 10px; background:transparent; color:var(--cc-purple); border:1px solid transparent; text-decoration:underline; }
  .ss-cc__btn:focus-visible{ outline:2px solid var(--cc-purple); outline-offset:2px; }

  .ss-cc__panel{ position:fixed; left:0; right:0; bottom:0; z-index:1001; display:flex; justify-content:center; padding:0 16px 16px; }
  .ss-cc__panel[hidden]{ display:none; }
  .ss-cc__panelinner{ width:100%; max-width:520px; background:#fff; color:var(--cc-ink); border:1px solid var(--cc-border); border-radius:16px; box-shadow:0 16px 48px rgba(36,24,54,0.22); padding:22px; }
  .ss-cc__panelhead{ display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
  .ss-cc__paneltitle{ font-weight:700; font-size:16px; margin:0; }
  .ss-cc__close{ width:36px; height:36px; border:0; background:transparent; color:var(--cc-ink); font-size:22px; line-height:1; cursor:pointer; border-radius:8px; }
  .ss-cc__close:focus-visible{ outline:2px solid var(--cc-purple); outline-offset:2px; }
  .ss-cc__cats{ list-style:none; margin:0 0 16px; padding:0; display:flex; flex-direction:column; }
  .ss-cc__cat{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:14px 0; border-bottom:1px solid var(--cc-border); }
  .ss-cc__catname{ font-weight:600; font-size:14px; margin:0 0 2px; }
  .ss-cc__catdesc{ font-size:12.5px; line-height:1.45; color:var(--cc-muted); margin:0; max-width:42ch; }
  .ss-cc__toggle{ position:relative; flex:0 0 auto; width:44px; height:26px; display:inline-block; }
  .ss-cc__toggle input{ position:absolute; opacity:0; width:44px; height:26px; margin:0; cursor:pointer; }
  .ss-cc__toggle span{ position:absolute; inset:0; background:#cfcbc4; border-radius:999px; transition:background .15s ease; pointer-events:none; }
  .ss-cc__toggle span::after{ content:''; position:absolute; top:3px; left:3px; width:20px; height:20px; background:#fff; border-radius:50%; transition:transform .15s ease; }
  .ss-cc__toggle input:checked + span{ background:var(--cc-purple); }
  .ss-cc__toggle input:checked + span::after{ transform:translateX(18px); }
  .ss-cc__toggle input:disabled + span{ opacity:.7; }
  .ss-cc__toggle input:focus-visible + span{ outline:2px solid var(--cc-purple); outline-offset:2px; }
  .ss-cc__panelactions{ display:flex; justify-content:flex-end; }

  @media (max-width:640px){
    .ss-cc__inner{ flex-direction:column; align-items:stretch; }
    .ss-cc__actions{ display:grid; grid-template-columns:1fr 1fr; }
    .ss-cc__btn--primary{ min-width:0; }
    .ss-cc__btn--text{ grid-column:1 / -1; }
  }
{%- endstyle -%}

<div class="ss-cc" data-ss-cookie hidden role="region" aria-label="Cookie consent">
  <div class="ss-cc__inner">
    <div class="ss-cc__body">
      <p class="ss-cc__title">Cookies</p>
      <p class="ss-cc__text">We use essential cookies to make the site work. With your consent we'd also use analytics and marketing cookies to understand visits and improve Senseless. You can change your choice any time. <a class="ss-cc__link" href="/pages/cookie-policy">Privacy &amp; cookies</a>.</p>
    </div>
    <div class="ss-cc__actions">
      <button type="button" class="ss-cc__btn ss-cc__btn--primary" data-ss-accept>Accept all</button>
      <button type="button" class="ss-cc__btn ss-cc__btn--primary" data-ss-reject>Reject non-essential</button>
      <button type="button" class="ss-cc__btn ss-cc__btn--text" data-ss-manage aria-haspopup="dialog" aria-controls="ss-cc-panel">Manage preferences</button>
    </div>
  </div>

  <div class="ss-cc__panel" data-ss-cookie-panel id="ss-cc-panel" role="dialog" aria-modal="true" aria-label="Cookie preferences" hidden>
    <div class="ss-cc__panelinner">
      <div class="ss-cc__panelhead">
        <p class="ss-cc__paneltitle" tabindex="-1" data-ss-panel-title>Cookie preferences</p>
        <button type="button" class="ss-cc__close" data-ss-cookie-close aria-label="Close cookie preferences">&times;</button>
      </div>
      <ul class="ss-cc__cats">
        <li class="ss-cc__cat">
          <div><p class="ss-cc__catname">Necessary</p><p class="ss-cc__catdesc">Always on. Required for the site, your cart and security.</p></div>
          <label class="ss-cc__toggle"><input type="checkbox" checked disabled aria-label="Necessary cookies (always on)"><span></span></label>
        </li>
        <li class="ss-cc__cat">
          <div><p class="ss-cc__catname">Analytics</p><p class="ss-cc__catdesc">Helps us understand how the site is used so we can improve it.</p></div>
          <label class="ss-cc__toggle"><input type="checkbox" data-ss-analytics aria-label="Analytics cookies"><span></span></label>
        </li>
        <li class="ss-cc__cat">
          <div><p class="ss-cc__catname">Marketing</p><p class="ss-cc__catdesc">Used to measure and improve our advertising.</p></div>
          <label class="ss-cc__toggle"><input type="checkbox" data-ss-marketing aria-label="Marketing cookies"><span></span></label>
        </li>
      </ul>
      <div class="ss-cc__panelactions">
        <button type="button" class="ss-cc__btn ss-cc__btn--primary" data-ss-save>Save preferences</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('[data-ss-cookie]');
    if (!root) return;
    var panel = root.querySelector('[data-ss-cookie-panel]');
    var elAnalytics = root.querySelector('[data-ss-analytics]');
    var elMarketing = root.querySelector('[data-ss-marketing]');
    var lastFocus = null;
    var STORE_KEY = 'ss_cookie_choice_v1';

    function decisionMade() { try { return !!localStorage.getItem(STORE_KEY); } catch (e) { return false; } }
    function readDecision() { try { return JSON.parse(localStorage.getItem(STORE_KEY)); } catch (e) { return null; } }
    function recordDecision(c) {
      try { localStorage.setItem(STORE_KEY, JSON.stringify({ a: !!c.analytics, m: !!c.marketing, p: !!c.preferences, t: Date.now() })); } catch (e) {}
    }

    function show() { root.hidden = false; }
    function hide() { root.hidden = true; }

    // Pixel/marketing gating only — does NOT control whether the banner shows.
    function setAPI(c) {
      try {
        if (window.Shopify && Shopify.customerPrivacy && Shopify.customerPrivacy.setTrackingConsent) {
          Shopify.customerPrivacy.setTrackingConsent({
            analytics: !!c.analytics,
            marketing: !!c.marketing,
            preferences: !!c.preferences,
            sale_of_data: c.marketing ? 'enabled' : 'disabled'
          }, function () {});
        }
      } catch (e) {}
    }

    function openPanel() {
      lastFocus = document.activeElement;
      var d = readDecision();
      var apiC = null;
      try { apiC = (window.Shopify && Shopify.customerPrivacy) ? Shopify.customerPrivacy.currentVisitorConsent() : null; } catch (e) {}
      if (elAnalytics) elAnalytics.checked = d ? !!d.a : (apiC ? apiC.analytics === 'yes' : false);
      if (elMarketing) elMarketing.checked = d ? !!d.m : (apiC ? apiC.marketing === 'yes' : false);
      panel.hidden = false;
      var t = panel.querySelector('[data-ss-panel-title]');
      if (t) t.focus();
    }
    function closePanel() {
      panel.hidden = true;
      if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
    }
    function choose(c) {
      recordDecision(c); setAPI(c); closePanel(); hide();
      // Announce the decision so consent-gated tags (senseless-clarity) can react in
      // THIS pageview instead of waiting for a reload. Verified live 8 Aug 2026:
      // Shopify's own `visitorConsentCollected` does NOT fire on this path even though
      // Shopify.customerPrivacy.setTrackingConsent is available, so do not rely on it.
      try {
        document.dispatchEvent(new CustomEvent('ss:consent', {
          detail: { analytics: !!c.analytics, marketing: !!c.marketing, preferences: !!c.preferences }
        }));
      } catch (e) {}
    }

    root.querySelector('[data-ss-accept]').addEventListener('click', function () { choose({ analytics: true, marketing: true, preferences: true }); });
    root.querySelector('[data-ss-reject]').addEventListener('click', function () { choose({ analytics: false, marketing: false, preferences: false }); });
    root.querySelector('[data-ss-manage]').addEventListener('click', openPanel);
    root.querySelector('[data-ss-cookie-close]').addEventListener('click', closePanel);
    root.querySelector('[data-ss-save]').addEventListener('click', function () {
      choose({ analytics: elAnalytics ? elAnalytics.checked : false, marketing: elMarketing ? elMarketing.checked : false, preferences: false });
    });

    document.addEventListener('keydown', function (e) {
      if (panel.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); closePanel(); return; }
      if (e.key === 'Tab') {
        var f = panel.querySelectorAll('button, input, a[href], [tabindex]:not([tabindex="-1"])');
        if (!f.length) return;
        var first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    document.addEventListener('click', function (e) {
      var t = e.target.closest('[data-ss-cookie-settings]');
      if (t) { e.preventDefault(); show(); openPanel(); }
    });

    // Local choice decides whether to SHOW. Shopify API is only for pixel gating.
    function init() {
      if (decisionMade()) {
        var d = readDecision() || {};
        setAPI({ analytics: !!d.a, marketing: !!d.m, preferences: !!d.p });
        hide();
        return;
      }
      show(); // no decision yet — show banner, record nothing until a click
    }

    if (window.Shopify && window.Shopify.loadFeatures) {
      try { Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function () { init(); }); }
      catch (e) { init(); }
    } else {
      init();
    }
  })();
</script>
