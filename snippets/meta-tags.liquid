{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- comment -%}
  Bing Webmaster Tools site-ownership proof. Independent of the Google Search Console
  import the property was originally verified by — Microsoft periodically re-syncs that
  import against the Google account, so if GSC access to the property ever lapses the
  Bing verification lapses with it. This tag is the documented fallback and keeps
  ownership provable on its own. Do not change the value; it is issued per account by
  Bing (site menu -> Verification code).
{%- endcomment -%}
<meta
  name="msvalidate.01"
  content="76C3F6F0B269C99286C6AFFEAF4785B1"
>

{%- liquid
  # Brand-independent title/SEO (Phase 13: do not derive from shop.name — survives the shop rename).
  assign brand_name = 'Senseless'
  assign home_title = 'UK Numbing Cream for Tattoos & Aesthetics | Senseless'
  # Reverted 6 Aug: the "preparation" cluster this targeted ("aesthetic preparation products",
  # "topical preparation for aesthetic procedures", "cosmetic topical preparation UK") returns NO DATA
  # in Ahrefs GB. It came from an agency sheet whose figures do not reconcile with Ahrefs.
  assign home_desc = 'UK-formulated numbing cream, gel and spray for tattooing, microneedling, laser, SPMU and more. Three strengths matched to your appointment. CPSR-assessed.'
  assign og_title = page_title | default: brand_name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: home_desc

  if request.page_type == 'index'
    assign og_title = home_title
    assign og_description = home_desc
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ brand_name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  # Resolve a share image: prefer the page's own image (product/collection/article),
  # else fall back to the theme default (settings.share_image) so home + /pages/* still get an og:image.
  assign share_img = page_image
  if share_img == blank
    assign share_img = settings.share_image
  endif
-%}
{%- if share_img != blank -%}
  <meta
    property="og:image"
    content="https:{{ share_img | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ share_img | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ share_img.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ share_img.height }}"
  >
  <meta
    name="twitter:image"
    content="https:{{ share_img | image_url }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- capture doc_title -%}
  {%- if request.page_type == 'index' -%}{{ home_title }}
  {%- else -%}{{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains brand_name %} | {{ brand_name }}{% endunless -%}
  {%- endif -%}
{%- endcapture -%}
<title>{{ doc_title | strip_newlines | strip }}</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if request.page_type == 'index' -%}
  <meta
    name="description"
    content="{{ home_desc | escape }}"
  >
{%- elsif page_description -%}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{%- endif -%}
