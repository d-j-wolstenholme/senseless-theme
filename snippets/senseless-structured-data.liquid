{%- comment -%}
  Senseless — structured data (JSON-LD), GEO/SEO layer.
  Rendered once from layout/theme.liquid <head>. Dispatches on request.page_type so it emits
  the RIGHT schema per template and never duplicates schema already emitted elsewhere:
    - Organization + WebSite/SearchAction → emitted here on the homepage ('index'); the bespoke senseless-header replaced Horizon header.liquid which previously emitted Organization
    - FAQPage       → already emitted by sections/senseless-faq-accordion.liquid
    - Article       → already emitted by Horizon sections/main-blog-post.liquid
  This snippet adds the MISSING types:
    - Product + Offer        (product pages)
    - CollectionPage + ItemList (collection pages)
    - BreadcrumbList         (product, collection, page)
  All strings are emitted through the `json` filter, which adds quotes + escapes — guaranteeing
  valid JSON. Prices/availability/currency come from live product data (no hardcoding); seller
  legalName is the parent company "Matrix Health Group Ltd". Description is claim-free.
{%- endcomment -%}
{%- liquid
  assign base = shop.url
  assign seller_name = 'Senseless'
  assign seller_legal = 'Matrix Health Group Ltd'
  assign cur = cart.currency.iso_code | default: shop.currency
-%}
{%- case request.page_type -%}

{%- when 'product' -%}
  {%- assign pd = product.description | strip_html | strip_newlines | truncate: 480 -%}
  {%- if pd == blank -%}{%- assign pd = product.title | append: ' — a topical cosmetic preparation by Senseless.' -%}{%- endif -%}
  {%- comment -%} Judge.me rating, synced to the reviews.* metafields. rating is a `rating`-type
     metafield → its .value is a Rating object whose .value is the number. rating_count is a plain
     integer. aggregateRating emitted ONLY when there are reviews (count > 0) — kits/no-review
     products have null metafields and emit nothing (an empty/zero aggregateRating is an RRT error).
     Rating object only — no review text. {%- endcomment -%}
  {%- assign ss_rating = product.metafields.reviews.rating.value -%}
  {%- assign ss_rcount = product.metafields.reviews.rating_count.value -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ pd | json }},
    "url": {{ base | append: product.url | json }},
    {%- if product.images.size > 0 -%}
    "image": [
      {%- for image in product.images limit: 5 -%}
        {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    {%- endif -%}
    "brand": { "@type": "Brand", "name": {{ seller_name | json }} },
    "manufacturer": { "@type": "Organization", "name": {{ seller_legal | json }} },
    {%- if ss_rcount and ss_rcount > 0 and ss_rating != blank -%}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ ss_rating.rating }}",
      "reviewCount": "{{ ss_rcount }}",
      "bestRating": "5",
      "worstRating": "1"
    },
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
      {
        "@type": "Offer",
        {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
        "name": {{ variant.title | json }},
        "price": "{{ variant.price | divided_by: 100.0 }}",
        "priceCurrency": {{ cur | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ base | append: variant.url | json }},
        "seller": { "@type": "Organization", "name": {{ seller_name | json }}, "legalName": {{ seller_legal | json }} },
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": { "@type": "MonetaryAmount", "value": "1.99", "currency": "GBP" },
          "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "GB" },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 0, "maxValue": 1, "unitCode": "DAY" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 4, "maxValue": 6, "unitCode": "DAY" }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "GB",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/ReturnFeesCustomerResponsibility"
        }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
  </script>
  {%- render 'senseless-breadcrumbs-jsonld', base: base, crumb_type: 'product' -%}

{%- when 'collection' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "CollectionPage",
    "name": {{ collection.title | json }},
    "url": {{ base | append: collection.url | json }},
    {%- if collection.description != blank -%}"description": {{ collection.description | strip_html | strip_newlines | truncate: 300 | json }},{%- endif -%}
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ collection.all_products_count }},
      "itemListElement": [
        {%- for prod in collection.products limit: 48 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "name": {{ prod.title | json }},
          "url": {{ base | append: prod.url | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  }
  </script>
  {%- render 'senseless-breadcrumbs-jsonld', base: base, crumb_type: 'collection' -%}

{%- when 'page' -%}
  {%- render 'senseless-breadcrumbs-jsonld', base: base, crumb_type: 'page' -%}

{%- when 'index' -%}
  {%- comment -%} Homepage: Organization + WebSite/SearchAction + BreadcrumbList. The bespoke senseless-header replaced Horizon's header.liquid (which used to emit Organization), so it is emitted here. {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ seller_name | json }},
    "legalName": {{ seller_legal | json }},
    "url": {{ base | json }},
    "logo": {{ 'senseless-logo.png' | asset_url | prepend: 'https:' | json }},
    "address": { "@type": "PostalAddress", "streetAddress": "Paddock Business Centre, Paddock Road", "addressLocality": "Skelmersdale", "postalCode": "WN8 9PL", "addressCountry": "GB" },
    "telephone": "+443330495549",
    "areaServed": "GB",
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+443330495549",
      "email": "cs@senseless.uk",
      "contactType": "customer service",
      "areaServed": "GB",
      "availableLanguage": "English"
    },
    "brand": { "@type": "Brand", "name": {{ seller_name | json }} }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ seller_name | json }},
    "url": {{ base | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{ base }}/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ base | json }} }
    ]
  }
  </script>

{%- endcase -%}
