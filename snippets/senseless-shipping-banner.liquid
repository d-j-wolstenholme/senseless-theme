{%- comment -%}
  Senseless — shipping-threshold banner (top of the header, part of the always-sticky unit).
  Two cart-driven modes, read live via the cart AJAX API (/cart.js), re-render on add/remove:
   - empty basket → static explainer.
   - items in basket → 2-milestone progress bar (£40 free standard → £80 free next-day), subtotal-driven.
  Same-day-dispatch line present in all states. NO paid-price references. Tokens: #6B3FA0 fill, #f7f7f5 ground.
  ⚠ DISPLAY ONLY — the real free-shipping discounts (standard ≥£40, next-day ≥£80) must exist as Shopify rules.
{%- endcomment -%}
{%- style -%}
  .ss-shipbar { background:#ffffff; border-bottom:1px solid rgba(26,24,22,0.10); color:#1A1816;
    font-family:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; }
  .ss-shipbar__inner { max-width:1100px; margin:0 auto; padding:7px 20px; text-align:center; }
  .ss-shipbar__empty { margin:0; font-size:12.5px; line-height:1.4; color:#2B2730; }
  .ss-shipbar__progress { display:flex; flex-direction:column; gap:5px; align-items:center; }
  .ss-shipbar__msg { margin:0; font-size:12.5px; font-weight:600; line-height:1.35; color:#1A1816; }
  .ss-shipbar__bar { position:relative; width:100%; max-width:420px; height:6px; border-radius:999px; background:#ECEAE6; overflow:hidden; }
  .ss-shipbar__fill { position:absolute; left:0; top:0; bottom:0; width:0%; background:#6B3FA0; border-radius:999px; transition:width 300ms ease-out; }
  /* One-shot pulse when a free-delivery threshold is newly crossed; pairs with the width transition (different property, no double-animate). */
  .ss-shipbar__fill[data-pulse] { animation:ss-shipbar-pulse 500ms ease-out; }
  /* Inset glow (parent .ss-shipbar__bar has overflow:hidden, so an outward spread would be clipped). */
  @keyframes ss-shipbar-pulse {
    0%   { box-shadow:inset 0 0 0 6px rgba(255,255,255,0.85); }
    100% { box-shadow:inset 0 0 0 6px rgba(255,255,255,0); }
  }
  .ss-shipbar__mid { position:absolute; left:50%; top:-2px; bottom:-2px; width:2px; background:#ffffff; box-shadow:0 0 0 1px rgba(26,24,22,0.18); z-index:1; }
  .ss-shipbar__same { margin:0; font-size:11.5px; line-height:1.35; color:#5C5853; }
  [hidden] { display:none !important; }
  @media (prefers-reduced-motion: reduce){ .ss-shipbar__fill { transition:none; animation:none; } }
{%- endstyle -%}
<div class="ss-shipbar" data-shipbar role="region" aria-label="Delivery information">
  <div class="ss-shipbar__inner">
    <p class="ss-shipbar__empty" data-shipbar-empty>Free UK standard delivery over £40 · Free next-day over £80 · Order before 1pm for same-day dispatch</p>
    <div class="ss-shipbar__progress" data-shipbar-progress hidden aria-live="polite">
      <p class="ss-shipbar__msg" data-shipbar-msg></p>
      <div class="ss-shipbar__bar"><span class="ss-shipbar__mid" aria-hidden="true"></span><span class="ss-shipbar__fill" data-shipbar-fill></span></div>
      <p class="ss-shipbar__same" data-shipbar-same>Order before 1pm for same-day dispatch</p>
    </div>
  </div>
</div>
<script>
  (function () {
    if (window.__ssShipbar) { window.__ssShipbar(); return; }
    var T1 = 4000, T2 = 8000; // pence (£40 / £80)
    var prevTier = null; // 0 = below £40, 1 = free standard unlocked, 2 = free next-day unlocked
    function money(p) { var n = p / 100; return '£' + (n % 1 === 0 ? n.toFixed(0) : n.toFixed(2)); }
    // One-shot pulse on the fill when a threshold is newly crossed; restart-safe (remove → reflow → re-add).
    function pulse(fill) {
      if (!fill) return;
      fill.removeAttribute('data-pulse');
      void fill.offsetWidth; // force reflow so the animation re-triggers on a repeat crossing
      fill.setAttribute('data-pulse', '');
      setTimeout(function () { fill.removeAttribute('data-pulse'); }, 600);
    }
    function render(cart) {
      // Re-query each time: the header may be morphed/restored, so cached refs can go stale.
      var empty = document.querySelector('[data-shipbar-empty]'),
          prog  = document.querySelector('[data-shipbar-progress]'),
          msg   = document.querySelector('[data-shipbar-msg]'),
          fill  = document.querySelector('[data-shipbar-fill]'),
          same  = document.querySelector('[data-shipbar-same]');
      if (!empty || !prog) return;
      var n = (cart && cart.item_count) || 0;
      var sub = (cart && cart.items_subtotal_price != null) ? cart.items_subtotal_price : ((cart && cart.total_price) || 0);
      if (n === 0) { empty.hidden = false; prog.hidden = true; prevTier = 0; return; }
      empty.hidden = true; prog.hidden = false;
      var pct, m, showSame = true, tier;
      if (sub < T1) { tier = 0; pct = sub / T2 * 100; m = "You're " + money(T1 - sub) + " away from free standard delivery"; }
      else if (sub < T2) { tier = 1; pct = sub / T2 * 100; m = "Free standard delivery unlocked — " + money(T2 - sub) + " more for free next-day"; }
      else { tier = 2; pct = 100; m = "Free next-day delivery unlocked — order before 1pm for same-day dispatch"; showSame = false; }
      if (msg) msg.textContent = m;
      if (fill) fill.style.width = Math.min(Math.max(pct, 0), 100) + '%';
      if (same) same.hidden = !showSame;
      // Pulse only when a free-delivery threshold (£40 / £80) is NEWLY crossed upward; not on first paint.
      if (prevTier != null && tier > prevTier) pulse(fill);
      prevTier = tier;
    }
    // Cache-busted fetch so a previously-cached empty /cart.js can't keep the banner stuck on the empty state.
    function refresh(retry) {
      fetch('/cart.js', { headers: { 'Accept': 'application/json' }, cache: 'no-store' })
        .then(function (r) { if (!r.ok) throw r.status; return r.json(); })
        .then(render)
        .catch(function () { if (retry !== false) setTimeout(function () { refresh(false); }, 700); });
    }
    window.__ssShipbar = refresh;
    // Initialise from the CURRENT cart on first parse, on DOM ready, and on bfcache restore
    // (Horizon's own cart UI re-syncs on pageshow for exactly this reason).
    refresh();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { refresh(); });
    window.addEventListener('pageshow', function () { refresh(); });
    // Cart events — Horizon dispatches 'cart:update'; keep legacy aliases for safety.
    ['cart:update', 'cart:updated', 'cart:refresh', 'cart:change'].forEach(function (ev) {
      document.addEventListener(ev, function () { setTimeout(refresh, 60); });
    });
    // Catch any AJAX cart mutation (quick-add, drawer qty changes, remove).
    var of = window.fetch;
    if (of && !of.__ssWrapped) {
      window.fetch = function () {
        var a = arguments;
        return of.apply(this, a).then(function (res) {
          try { var u = (a[0] && a[0].url) || a[0] || ''; if (typeof u === 'string' && /\/cart\/(add|change|update|clear)/i.test(u)) setTimeout(refresh, 80); } catch (e) {}
          return res;
        });
      };
      window.fetch.__ssWrapped = true;
    }
  })();
</script>
