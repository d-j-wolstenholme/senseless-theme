<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- render 'meta-tags' -%}
    {{ content_for_header }}
    {%- liquid
      assign body_font = settings.type_body_font
    -%}
    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      :root {
        --ss-purple: #6B3FA0;
        --ss-purple-hover: #5A3489;
        --ss-canvas: #f7f7f5;
        --ss-ink: #1A1816;
        --ss-secondary: #5C5853;
        --ss-error: #c0392b;
        --ss-sans: {{ body_font.family }}, {{ body_font.fallback_families }};
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--ss-canvas);
        color: var(--ss-ink);
        font-family: var(--ss-sans);
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        -webkit-font-smoothing: antialiased;
      }
      .ss-pw { width: 100%; max-width: 420px; text-align: center; display: flex; flex-direction: column; align-items: center; }
      .ss-pw__logo { display: block; margin: 0 auto 32px; }
      .ss-pw__logo svg { width: 200px; max-width: 70vw; height: auto; display: block; }
      .ss-pw__logo svg [fill] { fill: var(--ss-ink); }
      .ss-pw__title { font-weight: 400; font-size: clamp(1.875rem, 1.4rem + 2vw, 2.5rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 12px; color: var(--ss-ink); }
      .ss-pw__subtitle { font-weight: 400; font-size: 1rem; line-height: 1.55; color: var(--ss-secondary); margin: 0 0 28px; }
      .ss-pw__form { width: 100%; max-width: 360px; display: flex; flex-direction: column; gap: 12px; }
      .ss-pw__input {
        width: 100%; height: 50px; padding: 0 16px;
        font-family: var(--ss-sans); font-size: 1rem; color: var(--ss-ink);
        background: #ffffff; border: 1px solid var(--ss-purple); border-radius: 4px;
        outline: none; transition: box-shadow 0.15s ease;
      }
      .ss-pw__input::placeholder { color: #8E8A82; }
      .ss-pw__input:focus { box-shadow: 0 0 0 3px rgba(107, 63, 160, 0.18); }
      .ss-pw__submit {
        width: 100%; height: 50px; border: 0; border-radius: 14px; cursor: pointer;
        background: var(--ss-purple); color: #ffffff;
        font-family: var(--ss-sans); font-weight: 600; font-size: 0.9375rem; letter-spacing: 0.01em;
        transition: background-color 0.15s ease;
      }
      .ss-pw__submit:hover { background: var(--ss-purple-hover); }
      .ss-pw__error { margin: 2px 0 0; font-size: 0.8125rem; line-height: 1.4; color: var(--ss-error); }
      .ss-pw__caption { position: fixed; bottom: 16px; left: 0; right: 0; text-align: center; font-size: 0.6875rem; letter-spacing: 0.04em; color: #8E8A82; }
      @media (prefers-reduced-motion: reduce) { .ss-pw__input, .ss-pw__submit { transition: none; } }
    {% endstyle %}
  </head>

  <body>
    <main class="ss-pw" role="main">
      <span class="ss-pw__logo" aria-label="{{ shop.name }}">
        {{ 'senseless-logo-header.svg' | inline_asset_content }}
      </span>

      <h1 class="ss-pw__title">Something beautiful is coming.</h1>
      <p class="ss-pw__subtitle">Enter your access code to preview the store.</p>

      {%- form 'storefront_password' -%}
        <div class="ss-pw__form">
          <label for="Password" class="visually-hidden" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">Access code</label>
          <input
            type="password"
            name="password"
            id="Password"
            class="ss-pw__input"
            placeholder="Access code"
            autocomplete="current-password"
            autofocus
            {% if form.errors %}aria-invalid="true" aria-describedby="ss-pw-error"{% endif %}
          >
          <button type="submit" class="ss-pw__submit">Enter</button>
          {%- if form.errors -%}
            <p id="ss-pw-error" class="ss-pw__error" tabindex="-1">That access code isn’t right. Please try again.</p>
          {%- endif -%}
        </div>
      {%- endform -%}
    </main>

    <p class="ss-pw__caption">Senseless — by Matrix Health Group Ltd</p>

    {%- comment -%} Shopify requires {{ content_for_layout }} in every layout's body. This branded page builds its own content above, so the storefront password template renders into a hidden container (present for the requirement, not shown). {%- endcomment -%}
    <div hidden aria-hidden="true">{{ content_for_layout }}</div>
  </body>
</html>
