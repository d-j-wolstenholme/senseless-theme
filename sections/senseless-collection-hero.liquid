{%- comment -%}
  Senseless — Coll hero (category-led)
  Eyebrow + headline + subhead + 2 CTAs + image. Distinct from the homepage brand-led hero.
  Primary CTA can anchor-scroll (e.g. #product-grid). All fields editable; URLs/image wired per template.
{%- endcomment -%}

{%- style -%}

  .ss-chero {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-chero__inner { max-width: 1200px; margin: 0 auto; padding: 44px 20px; display: grid; gap: 28px; }
  .ss-chero__content { display: flex; flex-direction: column; gap: 16px; }
  .ss-chero__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; line-height: 1.2; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-chero__headline { font-family: var(--ss-head); font-weight: 400; font-size: 36px; line-height: 1.1; letter-spacing: -0.02em; margin: 0; }
  .ss-chero__subhead { font-family: var(--ss-sans); font-weight: 400; font-size: 17px; line-height: 1.55; color: var(--ss-body); margin: 0; max-width: 46ch; }
  .ss-chero__subhead p { margin: 0; }
  .ss-chero__ctas { display: flex; flex-direction: column; gap: 12px; margin-top: 4px; }
  .ss-chero__btn { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 28px; border-radius: 14px; font-family: var(--ss-sans); font-weight: 500; font-size: 16px; text-decoration: none; cursor: pointer; transition: background-color 200ms ease-out, border-color 200ms ease-out, color 200ms ease-out; }
  .ss-chero__btn--primary { background: var(--ss-purple); color: #fff; border: 1px solid var(--ss-purple); }
  .ss-chero__btn--primary:hover { background: var(--ss-purple-hover); border-color: var(--ss-purple-hover); }
  .ss-chero__btn--secondary { background: transparent; color: var(--ss-text); border: 1px solid var(--ss-text); }
  .ss-chero__btn--secondary:hover { background: var(--ss-text); color: var(--ss-bg); }
  .ss-chero__media { position: relative; border-radius: 4px; overflow: hidden; background: var(--ss-surface); border: 1px solid var(--ss-border); aspect-ratio: 1 / 1; }
  .ss-chero__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-chero__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-chero__placeholder svg { width: 40%; opacity: 0.22; fill: var(--ss-purple); }

  @media (min-width: 1024px) {
    .ss-chero__inner { grid-template-columns: 1fr 1fr; align-items: center; gap: 64px; padding: 96px 40px; }
    .ss-chero__headline { font-size: 52px; line-height: 1.05; }
    .ss-chero__subhead { font-size: 18px; }
    .ss-chero__ctas { flex-direction: row; }
    .ss-chero__media { aspect-ratio: 1 / 1; }
  }
  @media (prefers-reduced-motion: reduce) { .ss-chero__btn { transition: none; } }
{%- endstyle -%}

<section class="ss-chero" aria-label="{{ section.settings.headline | default: 'Collection' | escape }}">
  <div class="ss-chero__inner">
    <div class="ss-chero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ss-chero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.headline != blank -%}<h1 class="ss-chero__headline">{% render 'senseless-accent', text: section.settings.headline, word: section.settings.accent_word %}</h1>{%- endif -%}
      {%- if section.settings.subhead != blank -%}<div class="ss-chero__subhead">{{ section.settings.subhead }}</div>{%- endif -%}
      <div class="ss-chero__ctas">
        {%- if section.settings.primary_cta_label != blank -%}<a class="ss-chero__btn ss-chero__btn--primary" href="{{ section.settings.primary_cta_url | default: '#' }}">{{ section.settings.primary_cta_label | escape }}</a>{%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}<a class="ss-chero__btn ss-chero__btn--secondary" href="{{ section.settings.secondary_cta_url | default: '#' }}">{{ section.settings.secondary_cta_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="ss-chero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 50vw, 100vw', widths: '480, 768, 1024, 1280, 1600', alt: section.settings.image_alt }}
      {%- else -%}
        <div class="ss-chero__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Coll hero",
  "tag": "section",
  "class": "senseless-section senseless-collection-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "text", "id": "accent_word", "label": "Italic accent word (one word, optional)" },
    { "type": "richtext", "id": "subhead", "label": "Subhead" },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary CTA link", "info": "Can be an anchor like #product-grid (set in template)." },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary CTA link" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless range on a warm off-white background" }
  ],
  "presets": [ { "name": "Senseless — Coll hero" } ]
}
{% endschema %}
