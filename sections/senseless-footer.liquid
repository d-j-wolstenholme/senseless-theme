{%- comment -%}
  Senseless — bespoke footer (Strand 2 — Global Components).
  Brand block + FOUR link columns (Shop / The System / Help / Company) + a full-width legal bar.
  Columns are menu-driven (linklists): senseless-footer-shop / -explore / -help / -company.
  Legal bar: company line (Matrix Health Group Ltd registered details) + Privacy/Terms/Cookie +
  cookie-settings + social. Brand rule: purple is accent only.
  Injectable-clean: footer is ad-facing — no links into injectable collections.
{%- endcomment -%}

{%- liquid
  assign col1_handle = section.settings.col1_menu | default: 'senseless-footer-shop'
  assign col2_handle = section.settings.col2_menu | default: 'senseless-footer-explore'
  assign col3_handle = section.settings.col3_menu | default: 'senseless-footer-help'
  assign col4_handle = section.settings.col4_menu | default: 'senseless-footer-company'
  assign shop_menu = linklists[col1_handle]
  assign sys_menu = linklists[col2_handle]
  assign help_menu = linklists[col3_handle]
  assign company_menu = linklists[col4_handle]
  assign logo_h = section.settings.logo_height | default: 40
  assign mhg_show = section.settings.mhg_show
  assign mhg_url = section.settings.mhg_url | default: 'https://matrixhealthgroup.co.uk'
  assign mhg_label = section.settings.mhg_label | default: 'Matrix Health Group Ltd — parent company of Senseless'
  assign mhg_h = section.settings.mhg_logo_height | default: 26
-%}

{%- style -%}
  .ss-ft {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    font-family: var(--ss-head);
  }
  .ss-ft--ink { --ss-ground: #1A1816; --ss-fg: #F3F1EE; --ss-muted: #A6A19B; --ss-line: rgba(255,255,255,0.12); }
  .ss-ft--canvas { --ss-ground: #f7f7f5; --ss-fg: #1A1816; --ss-muted: #5C5853; --ss-line: rgba(26,24,22,0.12); }
  .ss-ft--surface { --ss-ground: #ffffff; --ss-fg: #1A1816; --ss-muted: #5C5853; --ss-line: rgba(26,24,22,0.12); }
  .ss-ft--sunken { --ss-ground: #efece4; --ss-fg: #1A1816; --ss-muted: #5C5853; --ss-line: rgba(26,24,22,0.12); }
  .ss-ft { background: var(--ss-ground); color: var(--ss-fg); border-top: 1px solid var(--ss-line); }
  .ss-ft__inner { max-width: 1200px; margin: 0 auto; padding: 56px 24px 28px; }
  .ss-ft__top { display: grid; grid-template-columns: minmax(220px, 0.9fr) 2.6fr; gap: 40px 48px; align-items: start; }
  .ss-ft__brand { display: flex; flex-direction: column; gap: 16px; }
  .ss-ft__logo { display: inline-block; color: var(--ss-fg); }
  .ss-ft__logo svg { display: block; width: auto; height: {{ logo_h }}px; max-width: 100%; }
  .ss-ft__logo svg path { fill: currentColor; }
  .ss-ft__tagline { margin: 0; max-width: 34ch; font-size: 0.9375rem; line-height: 1.55; color: var(--ss-muted); font-weight: 400; }
  .ss-ft__contact { margin: 0; font-size: 0.9375rem; line-height: 1.5; font-weight: 500; }
  .ss-ft__contact a { color: var(--ss-muted); text-decoration: none; }
  .ss-ft__contact a:hover { color: var(--ss-purple); }

  .ss-ft__cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .ss-ft__colhead { margin: 0 0 14px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ss-fg); }
  .ss-ft__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ss-ft__list a { font-size: 0.9375rem; line-height: 1.3; font-weight: 500; color: var(--ss-muted); text-decoration: none; transition: color 0.15s ease; }
  .ss-ft__list a:hover { color: var(--ss-purple); }

  .ss-ft__legal { margin-top: 44px; padding-top: 20px; border-top: 1px solid var(--ss-line); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .ss-ft__legalleft { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; font-size: 0.75rem; color: var(--ss-muted); }
  .ss-ft__legalleft a { color: var(--ss-muted); text-decoration: none; }
  .ss-ft__legalleft a:hover { color: var(--ss-purple); }
  .ss-ft__company { display: block; width: 100%; margin: 0 0 4px; }
  .ss-ft__policies { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .ss-ft__cookiebtn { font: inherit; font-size: 0.75rem; color: var(--ss-muted); background: none; border: 0; padding: 0; cursor: pointer; }
  .ss-ft__cookiebtn:hover { color: var(--ss-purple); }
  .ss-ft__social { display: flex; gap: 16px; }
  .ss-ft__social a { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ss-muted); text-decoration: none; }
  .ss-ft__social a:hover { color: var(--ss-purple); }

  /* Parent-company (Matrix Health Group) mark — light-band lockup, sits above the company line. */
  .ss-ft__mhg { display: inline-flex; align-items: center; line-height: 0; opacity: 0.9; transition: opacity 0.15s ease; }
  .ss-ft__mhg:hover { opacity: 1; }
  .ss-ft__mhg img { display: block; height: {{ mhg_h }}px; width: auto; max-width: 100%; }

  @media (max-width: 990px) {
    .ss-ft__top { grid-template-columns: 1fr; gap: 32px; }
    .ss-ft__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 24px; }
  }
  @media (max-width: 560px) {
    .ss-ft__inner { padding: 40px 20px 24px; }
    .ss-ft__legal { flex-direction: column; align-items: flex-start; }
    /* Mobile (2026-06-07): the caps column heading is the section label, but its links were larger
       (15px) than the heading, softening the hierarchy. Trim links + lift the heading so each
       column reads as label-then-links. Desktop unchanged. */
    .ss-ft__colhead { margin-bottom: 12px; color: var(--ss-fg); }
    .ss-ft__list { gap: 9px; }
    .ss-ft__list a { font-size: 0.875rem; }
  }
{%- endstyle -%}

<div class="ss-ft ss-ft--{{ section.settings.band | default: 'sunken' }}">
  <div class="ss-ft__inner">
    <div class="ss-ft__top">

      <div class="ss-ft__brand">
        <a href="{{ routes.root_url }}" class="ss-ft__logo" aria-label="{{ shop.name | escape }} — home">
          {{ 'senseless-logo-header.svg' | inline_asset_content }}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="ss-ft__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        <p class="ss-ft__contact"><a href="tel:+443330495549">0333&nbsp;049&nbsp;5549</a> &middot; <a href="mailto:cs@senseless.uk">cs@senseless.uk</a></p>
      </div>

      <div class="ss-ft__cols">

        {%- comment -%} Column 1 — Shop {%- endcomment -%}
        <div class="ss-ft__col">
          <h2 class="ss-ft__colhead">{{ section.settings.col1_heading | default: 'Shop' | escape }}</h2>
          <ul class="ss-ft__list">
            {%- if shop_menu.links.size > 0 -%}
              {%- for link in shop_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
            {%- else -%}
              <li><a href="/collections/numbing-cream">Numbing Cream</a></li>
              <li><a href="/collections/numbing-gel">Numbing Gel</a></li>
              <li><a href="/collections/numbing-spray">Numbing Spray</a></li>
              <li><a href="/collections/shop-all">Shop all</a></li>
            {%- endif -%}
          </ul>
        </div>

        {%- comment -%} Column 2 — Learn (hubs/cornerstones; the Articles hub gathers individual guides) {%- endcomment -%}
        <div class="ss-ft__col">
          <h2 class="ss-ft__colhead">{{ section.settings.col2_heading | default: 'Learn' | escape }}</h2>
          <ul class="ss-ft__list">
            {%- if sys_menu.links.size > 0 -%}
              {%- for link in sys_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
            {%- else -%}
              <li><a href="/pages/the-senseless-system">The Senseless System</a></li>
              <li><a href="/pages/articles">Articles</a></li>
            {%- endif -%}
          </ul>
        </div>

        {%- comment -%} Column 3 — Help {%- endcomment -%}
        <div class="ss-ft__col">
          <h2 class="ss-ft__colhead">{{ section.settings.col3_heading | default: 'Help' | escape }}</h2>
          <ul class="ss-ft__list">
            {%- if help_menu.links.size > 0 -%}
              {%- for link in help_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
            {%- else -%}
              <li><a href="/pages/faq">FAQ</a></li>
              <li><a href="/pages/contact">Contact</a></li>
            {%- endif -%}
          </ul>
        </div>

        {%- comment -%} Column 4 — Company {%- endcomment -%}
        <div class="ss-ft__col">
          <h2 class="ss-ft__colhead">{{ section.settings.col4_heading | default: 'Company' | escape }}</h2>
          <ul class="ss-ft__list">
            {%- if company_menu.links.size > 0 -%}
              {%- for link in company_menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
            {%- else -%}
              <li><a href="/pages/about">About</a></li>
              <li><a href="/pages/trade">Trade &amp; wholesale</a></li>
            {%- endif -%}
          </ul>
        </div>

      </div>
    </div>

    <div class="ss-ft__legal">
      <div class="ss-ft__legalleft">
        {%- comment -%} Parent-company logo → holding company (matches Totally Numb). Links out; new tab. {%- endcomment -%}
        {%- if mhg_show and mhg_url != blank -%}
          <a class="ss-ft__mhg" href="{{ mhg_url | escape }}" target="_blank" rel="noopener noreferrer" title="{{ mhg_label | escape }}">
            <img src="{{ 'matrix-health-group-logo.webp' | asset_url }}" alt="{{ mhg_label | escape }}" width="449" height="132" loading="lazy">
          </a>
        {%- endif -%}
        <span class="ss-ft__company">&copy; Matrix Health Group Ltd {{ 'now' | date: '%Y' }} &middot; Company no. 17099304 &middot; Paddock Business Centre, 2 Paddock Road, Skelmersdale WN8 9PL</span>
        <span class="ss-ft__policies">
          <a href="/pages/privacy-policy">Privacy Policy</a>
          <a href="/pages/terms-conditions">Terms &amp; Conditions</a>
          <a href="/pages/cookie-policy">Cookie Policy</a>
          <a href="/pages/rewards-terms">Rewards Terms</a>
          {%- comment -%} Re-opens the cookie consent preferences panel. {%- endcomment -%}
          <button type="button" class="ss-ft__cookiebtn" data-ss-cookie-settings>Cookie settings</button>
        </span>
      </div>

      <div class="ss-ft__social">
        {%- if section.settings.instagram_url != blank -%}<a href="{{ section.settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a>{%- endif -%}
        {%- if section.settings.tiktok_url != blank -%}<a href="{{ section.settings.tiktok_url }}" rel="noopener" target="_blank">TikTok</a>{%- endif -%}
        {%- if section.settings.facebook_url != blank -%}<a href="{{ section.settings.facebook_url }}" rel="noopener" target="_blank">Facebook</a>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Senseless — Footer",
  "tag": "div",
  "class": "ss-ft-section",
  "settings": [
    { "type": "select", "id": "band", "label": "Background", "default": "sunken", "options": [
      { "value": "sunken", "label": "Sunken (warm light) — locked default" },
      { "value": "ink", "label": "Ink (dark)" },
      { "value": "canvas", "label": "Canvas (off-white)" },
      { "value": "surface", "label": "Surface (white)" }
    ] },
    { "type": "range", "id": "logo_height", "label": "Wordmark height", "min": 24, "max": 96, "step": 4, "unit": "px", "default": 40 },
    { "type": "text", "id": "tagline", "label": "Brand tagline", "default": "UK-formulated topical preparation for aesthetic and cosmetic procedures." },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "col1_heading", "label": "Column 1 heading", "default": "Shop" },
    { "type": "link_list", "id": "col1_menu", "label": "Column 1 menu", "info": "Defaults to senseless-footer-shop." },
    { "type": "text", "id": "col2_heading", "label": "Column 2 heading", "default": "Learn" },
    { "type": "link_list", "id": "col2_menu", "label": "Column 2 menu", "info": "Defaults to senseless-footer-explore." },
    { "type": "text", "id": "col3_heading", "label": "Column 3 heading", "default": "Help" },
    { "type": "link_list", "id": "col3_menu", "label": "Column 3 menu", "info": "Defaults to senseless-footer-help." },
    { "type": "text", "id": "col4_heading", "label": "Column 4 heading", "default": "Company" },
    { "type": "link_list", "id": "col4_menu", "label": "Column 4 menu", "info": "Defaults to senseless-footer-company." },
    { "type": "header", "content": "Parent company" },
    { "type": "checkbox", "id": "mhg_show", "label": "Show parent-company logo", "default": true },
    { "type": "text", "id": "mhg_url", "label": "Parent company link", "default": "https://matrixhealthgroup.co.uk", "info": "Opens in a new tab." },
    { "type": "text", "id": "mhg_label", "label": "Parent company label (alt / title)", "default": "Matrix Health Group Ltd — parent company of Senseless" },
    { "type": "range", "id": "mhg_logo_height", "label": "Parent-company logo height", "min": 18, "max": 44, "step": 2, "unit": "px", "default": 26, "info": "Lockup is built for the light footer bands (charcoal wordmark)." },
    { "type": "header", "content": "Legal bar" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" }
  ],
  "presets": [
    { "name": "Senseless — Footer" }
  ]
}
{% endschema %}
