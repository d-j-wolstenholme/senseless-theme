{%- comment -%}
  Senseless — Header (fully custom, replaces Horizon's native header)
  Strand 2 — Global Components. Centred nav, large wordmark, sticky + frosted.

  Two BESPOKE dropdowns (not menu-driven — keyed on the top-level title):
    • "Shop"       → 5-column mega (By product w/ format→strength flyouts, By strength,
                     By procedure, Bundles, Merchandise) + swappable featured card + filled
                     "Shop all" CTA. Merchandise is branded accessories — NOT cosmetic products,
                     no strength tier, no CPSR.
    • "The System" → learning hub (Layout B): read-first System card + 3 groups
                     (Understand by procedure / Application guides / Comfort & pain).
  Any OTHER top-level item with menu children (e.g. Help) renders a generic dropdown.

  INJECTABLE-CLEAN: both menus render on every page incl. ad landing pages — NO Botox /
  lip filler / injection labels or links anywhere in either menu. Verified by grep at build.

  Interaction: desktop = hover OR keyboard-focus opens panels; By-product formats reveal
  their 3 strengths in an inline sub-panel (aria-expanded, keyboard-operable, not hover-only).
  Mobile = hamburger drawer with nested accordions (tap a format to expand its strengths).
  Cart drawer / predictive search / account are preserved via Horizon's own snippets.
  Top-level nav order is driven by the linklist in settings (default: senseless-main).
{%- endcomment -%}

{%- liquid
  assign uid = section.id | replace: '-', '' | append: section.index
  assign menu = linklists[section.settings.menu]
  assign logo_h = section.settings.logo_height | default: 48

  # By-product data (size-agnostic strength slugs: <strength>-strength-<format>)
  assign fmt_handles = 'numbing-cream,numbing-gel,numbing-spray' | split: ','
  assign fmt_labels  = 'Numbing Cream,Numbing Gel,Numbing Spray' | split: ','
  assign fmt_slugs   = 'cream,gel,spray' | split: ','
  assign str_labels  = 'Clinical,Advanced,Professional' | split: ','
  assign str_slugs   = 'clinical,advanced,professional' | split: ','
  # By-strength flyout reveals the 3 formats of that strength
  assign str_fmt_labels = 'Cream,Gel,Spray' | split: ','
  assign str_fmt_slugs  = 'cream,gel,spray' | split: ','
  # Bundles flyout: Clinical & Advanced are triggers revealing Starter (kit-small) / Ultimate
  # (kit-large); Professional is a flat direct link (large only, no Starter). Linked by handle.
  assign bundle_tiers = 'Clinical,Advanced' | split: ','
  assign bundle_tier_slugs = 'clinical,advanced' | split: ','
  # Featured card: Professional Complete (SBUN-PR-L). Image pulled DYNAMICALLY from the
  # product's own featured media so real photography auto-populates; optional setting override.
  assign feat_product = all_products['professional-numbing-kit-large']
  if section.settings.shop_feat_product != blank
    assign feat_product = section.settings.shop_feat_product
  endif
  assign feat_title = section.settings.shop_feat_title | default: feat_product.title
  assign feat_url = section.settings.shop_feat_url | default: feat_product.url
-%}

{%- style -%}
  .ss-hdr {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-secondary: #5C5853;
    --ss-border: rgba(26,24,22,0.12);
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-pad: 18px;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247,247,245,0.82);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--ss-border);
    color: var(--ss-text);
    font-family: var(--ss-head);
  }
  .ss-hdr__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    max-width: 1280px;
    margin: 0 auto;
    padding: var(--ss-pad) 20px;
    transition: padding 200ms ease-out;
  }
  .ss-hdr[data-scrolled="true"] .ss-hdr__bar { --ss-pad: 12px; }

  .ss-hdr__left { display: flex; align-items: center; gap: 10px; justify-self: start; }
  .ss-hdr__right { display: flex; align-items: center; gap: 8px; justify-self: end; }

  /* Wordmark */
  .ss-hdr__logo { display: inline-flex; align-items: center; text-decoration: none; color: var(--ss-text); }
  .ss-hdr__logo-svg { display: inline-flex; align-items: center; }
  .ss-hdr__logo-img, .ss-hdr__logo-svg svg { display: block; width: auto; height: 28px; max-width: min(62vw, 220px); object-fit: contain; }
  @media (min-width: 1024px) { .ss-hdr__logo-img, .ss-hdr__logo-svg svg { height: var(--ss-logo-h, 48px); max-width: 420px; } }
  .ss-hdr__wordmark { font-family: var(--ss-head); font-weight: 700; letter-spacing: -0.02em; line-height: 1; color: var(--ss-text); font-size: 26px; }
  .ss-hdr__logo--mobile { justify-self: center; }
  .ss-hdr__logo--desktop { display: none; }

  /* Burger */
  .ss-hdr__burger { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: transparent; color: var(--ss-text); cursor: pointer; padding: 0; }
  .ss-hdr__burger svg { width: 24px; height: 24px; }

  /* Desktop nav */
  .ss-hdr__nav { display: none; justify-self: center; }
  .ss-hdr__navlist { display: flex; align-items: center; gap: 4px; list-style: none; margin: 0; padding: 0; }
  .ss-hdr__item { position: static; }
  .ss-hdr__navlink {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--ss-head); font-weight: 600; font-size: 14px; letter-spacing: 0.01em;
    color: var(--ss-text); background: transparent; border: 0; cursor: pointer;
    padding: 10px 14px; border-radius: 8px; text-decoration: none;
    transition: color 200ms ease-out, background-color 200ms ease-out;
  }
  .ss-hdr__navlink:hover, .ss-hdr__navlink[aria-expanded="true"] { color: var(--ss-purple); }
  .ss-hdr__navlink--subtle { color: var(--ss-secondary); font-weight: 500; }
  .ss-hdr__caret { width: 12px; height: 12px; transition: transform 200ms ease-out; }
  .ss-hdr__navlink[aria-expanded="true"] .ss-hdr__caret { transform: rotate(180deg); }

  /* Full-width dropdown / mega panels */
  .ss-hdr__panels { position: absolute; left: 0; right: 0; top: 100%; z-index: 99; }
  .ss-hdr__panel {
    position: absolute; left: 0; right: 0; top: 0;
    background: #ffffff;
    border-bottom: 1px solid rgba(26,24,22,0.18);
    box-shadow: 0 18px 40px rgba(26,24,22,0.22);
  }
  .ss-hdr__panel[hidden] { display: none; }
  .ss-hdr__panelinner { max-width: 1180px; margin: 0 auto; padding: 36px 20px 40px; }
  /* Shop mega carries one more column than the other panels (Merchandise); widen it to the
     header bar's own 1280px so the four existing columns keep their width instead of being squeezed. */
  .ss-hdr__panelinner--wide { max-width: 1280px; }
  .ss-hdr__cols { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 40px; }
  .ss-hdr__col-title { font-family: var(--ss-head); font-weight: 600; font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0 0 14px; }
  .ss-hdr__sublist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ss-hdr__sublink { font-family: var(--ss-head); font-weight: 500; font-size: 16px; color: var(--ss-body); text-decoration: none; transition: color 200ms ease-out; }
  .ss-hdr__sublink:hover { color: var(--ss-purple); }
  .ss-hdr__colfoot { margin-top: auto; padding-top: 12px; border-top: 1px solid var(--ss-border); }
  .ss-hdr__sublink--foot { color: var(--ss-purple); font-weight: 600; font-size: 15px; }
  .ss-hdr__sublink--foot::after { content: ' →'; }
  .ss-hdr__megacta { margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--ss-border); }
  .ss-hdr__megacta a { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 24px; border-radius: 14px; background: var(--ss-purple); color: #fff; font-family: var(--ss-head); font-weight: 600; font-size: 15px; text-decoration: none; transition: background-color 200ms ease-out; }
  .ss-hdr__megacta a:hover { background: var(--ss-purple-hover); }
  .ss-hdr__megacta a::after { content: '\2192'; }

  /* ---- Shop mega: 4 columns + featured card ---- */
  /* Equal-height nav columns (footer CTAs pin to one baseline) + vertical hairline dividers */
  .ss-hdr__shopgrid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)) minmax(150px, 0.8fr) minmax(210px, 280px); column-gap: 0; row-gap: 28px; align-items: stretch; }
  .ss-hdr__colgroup { min-width: 0; }
  .ss-hdr__shopgrid > .ss-hdr__colgroup { display: flex; flex-direction: column; padding: 0 20px; }
  .ss-hdr__shopgrid > .ss-hdr__colgroup:first-child { padding-left: 0; }
  .ss-hdr__shopgrid > .ss-hdr__colgroup + .ss-hdr__colgroup { border-left: 1px solid var(--ss-border); }
  .ss-hdr__shopgrid > .ss-hdr__colgroup > .ss-hdr__sublist { flex: 1 1 auto; }
  .ss-hdr__shopgrid > .ss-hdr__featured { margin-left: 20px; }

  /* By-product format rows + inline strength flyout */
  .ss-fmt { position: relative; }
  .ss-fmt__row { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
  .ss-fmt__toggle { flex: 0 0 auto; width: 28px; height: 28px; display: inline-flex; align-items: center; justify-content: center; background: transparent; border: 0; border-radius: 6px; color: var(--ss-secondary); cursor: pointer; padding: 0; }
  .ss-fmt__toggle:hover { color: var(--ss-purple); }
  .ss-fmt__toggle svg { width: 12px; height: 12px; transition: transform 200ms ease-out; }
  .ss-fmt__toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .ss-fmt__flyout { margin: 8px 0 4px 12px; padding-left: 12px; border-left: 2px solid var(--ss-border); }
  .ss-fmt__flyout[hidden] { display: none; }
  .ss-fmt__flyout .ss-hdr__sublist { gap: 8px; }
  .ss-fmt__flyout .ss-hdr__sublink { font-size: 15px; }
  .ss-fmt__flyfoot { margin-top: 8px; }
  .ss-fmt__flyfoot a { font-family: var(--ss-head); font-weight: 600; font-size: 14px; color: var(--ss-purple); text-decoration: none; }
  .ss-fmt__flyfoot a::after { content: ' →'; }

  /* By-strength: the strength word is a flyout TRIGGER only (button, never a link) */
  .ss-str__head { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 6px; background: transparent; border: 0; cursor: pointer; padding: 0; font-family: var(--ss-head); font-weight: 500; font-size: 16px; color: var(--ss-body); text-align: left; }
  .ss-str__head:hover { color: var(--ss-purple); }
  .ss-str__head svg { flex: 0 0 auto; width: 12px; height: 12px; color: var(--ss-secondary); transition: transform 200ms ease-out; }
  .ss-str__head:hover svg { color: var(--ss-purple); }
  .ss-str__head[aria-expanded="true"] svg { transform: rotate(180deg); }

  /* Featured card (Shop) */
  .ss-hdr__featured { display: flex; flex-direction: column; gap: 10px; padding: 16px; background: var(--ss-bg); border: 1px solid var(--ss-border); border-radius: 12px; }
  .ss-hdr__featured-media { display: block; width: 100%; aspect-ratio: 1 / 1; border-radius: 8px; object-fit: cover; background: linear-gradient(135deg, #efeae9, #f7f7f5); }
  .ss-hdr__featured-ph { display: flex; align-items: center; justify-content: center; border: 1px solid var(--ss-border); color: var(--ss-secondary); font-weight: 600; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; }
  .ss-hdr__featured-eyebrow { font-weight: 600; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ss-purple); margin: 2px 0 0; }
  .ss-hdr__featured-title { font-weight: 600; font-size: 16px; color: var(--ss-text); margin: 0; }
  .ss-hdr__featured-text { font-weight: 500; font-size: 13.5px; line-height: 1.5; color: var(--ss-secondary); margin: 0; }
  .ss-hdr__featured-cta { margin-top: 2px; font-family: var(--ss-head); font-weight: 600; font-size: 14px; color: var(--ss-purple); text-decoration: none; }
  .ss-hdr__featured-cta::after { content: ' →'; }

  /* ---- The System: read-first card + 3 groups ---- */
  .ss-hdr__sysgrid { display: grid; grid-template-columns: minmax(240px, 320px) 1fr; gap: 36px; align-items: stretch; }
  .ss-hdr__sysfeat { display: flex; flex-direction: column; gap: 12px; padding: 22px; background: var(--ss-bg); border: 1px solid var(--ss-border); border-radius: 12px; }
  .ss-hdr__sysfeat-eyebrow { font-weight: 600; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-hdr__sysfeat-title { font-weight: 400; letter-spacing: -0.02em; font-size: 24px; line-height: 1.1; color: var(--ss-text); margin: 0; }
  .ss-hdr__sysfeat-text { font-weight: 500; font-size: 14px; line-height: 1.55; color: var(--ss-secondary); margin: 0; }
  .ss-hdr__sysfeat-cta { margin-top: 4px; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 22px; border-radius: 14px; background: var(--ss-purple); color: #fff; font-family: var(--ss-head); font-weight: 600; font-size: 14px; text-decoration: none; transition: background-color 200ms ease-out; }
  .ss-hdr__sysfeat-cta:hover { background: var(--ss-purple-hover); }
  .ss-hdr__sysgroups { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); column-gap: 0; row-gap: 28px; align-items: stretch; }
  .ss-hdr__sysgroups > .ss-hdr__colgroup { display: flex; flex-direction: column; padding: 0 20px; }
  .ss-hdr__sysgroups > .ss-hdr__colgroup:first-child { padding-left: 0; }
  .ss-hdr__sysgroups > .ss-hdr__colgroup + .ss-hdr__colgroup { border-left: 1px solid var(--ss-border); }
  .ss-hdr__groupnote { font-weight: 500; font-size: 13px; line-height: 1.5; color: var(--ss-secondary); margin: 12px 0 0; }

  /* Reuse: tone Horizon action icons to brand text, hide search/account on mobile */
  .ss-hdr__right { color: var(--ss-text); display: flex; align-items: center; gap: 2px; }
  .ss-hdr__right .header-actions__action, .ss-hdr__right svg { color: var(--ss-text); }
  .ss-hdr__right header-actions { display: inline-flex; align-items: center; gap: 2px; }
  .ss-hdr__right search-button, .ss-hdr__right .search-action { display: inline-flex; align-items: center; }
  .ss-hdr__right .search-action,
  .ss-hdr__right .header-actions__action,
  .ss-hdr__right cart-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; min-width: 40px; padding: 0; margin: 0;
  }
  .ss-hdr__right .svg-wrapper { display: inline-flex; align-items: center; justify-content: center; }
  .ss-hdr__right svg { width: auto; height: 19px; display: block; }

  /* Drawer */
  .ss-hdr__scrim { position: fixed; inset: 0; background: rgba(26,24,22,0.4); z-index: 110; opacity: 0; transition: opacity 250ms ease-in-out; }
  .ss-hdr__scrim[hidden] { display: none; }
  .ss-hdr__scrim[data-open="true"] { opacity: 1; }
  .ss-hdr__drawer {
    /* Drawer + scrim render OUTSIDE .ss-hdr (its backdrop-filter would trap position:fixed),
       so they DON'T inherit .ss-hdr's brand vars — define them here or var(--ss-bg) is empty. */
    --ss-purple: #6B3FA0; --ss-purple-hover: #5A3489; --ss-bg: #f7f7f5; --ss-surface: #ffffff;
    --ss-text: #1A1816; --ss-body: #2B2730; --ss-secondary: #5C5853; --ss-border: rgba(26,24,22,0.12);
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    position: fixed; top: 0; left: 0; height: 100%; width: 85%; max-width: 380px;
    background: #f7f7f5; z-index: 120; transform: translateX(-100%);
    transition: transform 250ms ease-in-out; display: flex; flex-direction: column;
    overflow-y: auto; -webkit-overflow-scrolling: touch;
  }
  .ss-hdr__drawer[data-open="true"] { transform: translateX(0); }
  .ss-hdr__drawerhead { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--ss-border); }
  /* Pinned Shop-all CTA at top of mobile drawer — full-width filled-purple brand button. */
  /* Scoped above .ss-hdr__accpanel a (the child-link rule) so the white label isn't overridden. */
  .ss-hdr__accpanel a.ss-hdr__drawercta { display: flex; align-items: center; justify-content: center; gap: 8px; margin: 4px 0 14px; padding: 0; height: 48px; border-radius: 14px; background: var(--ss-purple); color: #fff; font-family: var(--ss-head); font-weight: 600; font-size: 16px; text-decoration: none; transition: background-color 200ms ease-out; }
  .ss-hdr__accpanel a.ss-hdr__drawercta::after { content: '\2192'; }
  .ss-hdr__accpanel a.ss-hdr__drawercta:hover, .ss-hdr__accpanel a.ss-hdr__drawercta:active { background: var(--ss-purple-hover); color: #fff; }
  .ss-hdr__close { width: 44px; height: 44px; border: 0; background: transparent; color: var(--ss-text); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .ss-hdr__close svg { width: 22px; height: 22px; }
  .ss-hdr__drawernav { list-style: none; margin: 0; padding: 8px 0; }
  .ss-hdr__drawernav > li { border-bottom: 1px solid #E5E0EC; }
  .ss-hdr__acc { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; background: transparent; border: 0; cursor: pointer; font-family: var(--ss-head); font-weight: 600; font-size: 16px; color: var(--ss-text); padding: 16px 20px; text-align: left; }
  .ss-hdr__drawerlink { display: block; font-family: var(--ss-head); font-weight: 600; font-size: 16px; color: var(--ss-text); text-decoration: none; padding: 16px 20px; }
  .ss-hdr__acc .ss-hdr__caret { width: 14px; height: 14px; }
  .ss-hdr__accpanel { padding: 0 20px 12px; }
  .ss-hdr__accpanel[hidden] { display: none; }
  /* Mobile drawer hierarchy (revises 7ab4daa): group titles dominate; child links subordinate +
     indented; 1px #E5E0EC rule between TOP-LEVEL groups only (none between child links). */
  .ss-hdr__accgroup { margin: 0; padding: 16px 0; }
  .ss-hdr__accgroup + .ss-hdr__accgroup { border-top: 1px solid #E5E0EC; }
  .ss-hdr__accgroup-title { font-family: var(--ss-head); font-weight: 600; font-size: 16px; line-height: 1.3; letter-spacing: -0.01em; color: var(--ss-text); margin: 0 0 8px; }
  .ss-hdr__accpanel a { display: block; font-family: var(--ss-head); font-weight: 500; font-size: 14px; color: var(--ss-secondary); text-decoration: none; padding: 8px 0 8px 16px; }
  .ss-hdr__accpanel a:hover, .ss-hdr__accpanel a:active { color: var(--ss-purple); }
  /* Drawer nested format accordion */
  .ss-hdr__subacc { border-top: 0; }
  .ss-hdr__subacc-btn { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; background: transparent; border: 0; cursor: pointer; font-family: var(--ss-head); font-weight: 500; font-size: 14px; color: var(--ss-secondary); padding: 8px 0 8px 16px; text-align: left; }
  .ss-hdr__subacc-btn:hover, .ss-hdr__subacc-btn:active { color: var(--ss-purple); }
  .ss-hdr__subacc-btn svg { width: 12px; height: 12px; transition: transform 200ms ease-out; }
  .ss-hdr__subacc-btn[aria-expanded="true"] svg { transform: rotate(180deg); }
  .ss-hdr__subacc-panel { padding: 0 0 6px 12px; border-left: 2px solid var(--ss-border); margin-left: 2px; }
  .ss-hdr__subacc-panel[hidden] { display: none; }
  .ss-hdr__subacc-panel a { padding: 7px 0; }
  .ss-hdr__acc-foot { font-weight: 600 !important; color: var(--ss-purple) !important; }
  .ss-hdr__drawerfoot { margin-top: auto; padding: 16px 20px 28px; border-top: 1px solid var(--ss-border); display: flex; flex-direction: column; gap: 4px; }
  .ss-hdr__drawerfoot a { font-family: var(--ss-head); font-weight: 600; font-size: 15px; color: var(--ss-text); text-decoration: none; padding: 12px 0; display: inline-flex; align-items: center; gap: 10px; }
  .ss-hdr__drawerfoot svg { width: 18px; height: 18px; }

  @media (min-width: 1024px) {
    .ss-hdr__nav { display: block; }
    .ss-hdr__logo--desktop { display: inline-flex; }
    .ss-hdr__logo--mobile, .ss-hdr__burger { display: none; }
    .ss-hdr__wordmark { font-size: 34px; }
  }
  @media (max-width: 1199px) {
    .ss-hdr__shopgrid { grid-template-columns: repeat(2, minmax(0,1fr)); column-gap: 28px; row-gap: 28px; }
    .ss-hdr__shopgrid > .ss-hdr__colgroup { padding: 0; border-left: 0; }
    .ss-hdr__shopgrid > .ss-hdr__featured { grid-column: 1 / -1; margin-left: 0; flex-direction: row; align-items: center; }
    .ss-hdr__featured-media { width: 120px; flex: 0 0 120px; aspect-ratio: 1; }
  }
  @media (max-width: 1023px) {
    .ss-hdr__panels { display: none; }
    .ss-hdr__right .account-button, .ss-hdr__right .search-action { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-hdr__bar, .ss-hdr__scrim, .ss-hdr__drawer, .ss-hdr__caret, .ss-hdr__navlink, .ss-hdr__sublink, .ss-fmt__toggle svg, .ss-hdr__subacc-btn svg { transition: none; }
  }
{%- endstyle -%}

{%- liquid
  # SVG logos return blank from image_url (Shopify can't transform SVG), so the
  # picker path only works for raster images. Precedence: raster picker > inline brand SVG.
  assign logo_src = ''
  assign logo_w = 0
  if section.settings.logo_image != blank
    assign logo_src = section.settings.logo_image | image_url: width: 600
    assign logo_w = logo_h | times: section.settings.logo_image.aspect_ratio | round
  endif
-%}
{%- capture logo_markup -%}
  {%- if logo_src != blank -%}
    <img class="ss-hdr__logo-img" src="{{ logo_src }}" alt="{{ shop.name | escape }}" width="{{ logo_w }}" height="{{ logo_h }}" loading="eager">
  {%- else -%}
    <span class="ss-hdr__logo-svg" role="img" aria-label="{{ shop.name | default: 'Senseless' | escape }}">{{ 'senseless-logo-header.svg' | inline_asset_content }}</span>
  {%- endif -%}
{%- endcapture -%}

<header class="ss-hdr" data-ss-header style="--ss-logo-h: {{ logo_h }}px;">
  {%- render 'senseless-shipping-banner' -%}
  <div class="ss-hdr__bar">
    <div class="ss-hdr__left">
      <button class="ss-hdr__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="ss-drawer-{{ uid }}" data-ss-burger>
        {{ 'icon-menu.svg' | inline_asset_content }}
      </button>
