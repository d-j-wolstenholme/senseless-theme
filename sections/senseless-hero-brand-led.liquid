{%- comment -%}
  Senseless — Hero
  Homepage-only hero. Two-column split (Homepage spec "Section 1 — Hero · Desktop text-left, image-right"):
  LEFT = eyebrow → large H1 → one lead → primary + secondary CTA, left-aligned. RIGHT = product
  still-life image beside the text on a soft radial backdrop, single soft shadow, small caption.
  MOBILE: vertical stack (text then image), full-width CTAs. Graceful placeholder.
  All copy, links and image are editable in the theme editor; wired in templates/index.json.
{%- endcomment -%}

{%- style -%}

  .ss-hero {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-secondary: #5C5853;
    --ss-border: rgba(26,26,26,0.10);
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-hero__grid {
    max-width: 1200px;
    margin: 0 auto;
    padding-block: 96px;
    padding-inline: 24px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }
  .ss-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: 18px;
  }
  .ss-hero__eyebrow { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; line-height: 1.2; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-hero__headline {
    font-family: var(--ss-head);
    font-weight: 400;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ss-text);
  }
  .ss-hero__headline em, .ss-hero__headline i { font-style: italic; font-weight: 500; }
  .ss-hero__subhead {
    font-family: var(--ss-sans);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ss-secondary);
    margin: 0;
    max-width: 52ch;
  }
  .ss-hero__subhead p { margin: 0; }
  .ss-hero__ctas { display: flex; flex-direction: column; gap: 12px; margin-top: 6px; width: 100%; }
  .ss-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 0 28px;
    border-radius: 14px;
    font-family: var(--ss-sans);
    font-weight: 500;
    font-size: 16px;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 200ms ease-out, border-color 200ms ease-out, color 200ms ease-out;
  }
  .ss-hero__btn--primary { background: var(--ss-purple); color: #ffffff; border: 1px solid var(--ss-purple); }
  .ss-hero__btn--primary:hover { background: var(--ss-purple-hover); border-color: var(--ss-purple-hover); }
  .ss-hero__btn--secondary { background: transparent; color: var(--ss-purple); border: 1px solid var(--ss-purple); }
  .ss-hero__btn--secondary:hover { background: var(--ss-purple); color: #ffffff; border-color: var(--ss-purple); }

  .ss-hero__gallery { width: 100%; }
  .ss-hero__stage {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 50% 38%, #ffffff 0%, #f2f0ec 58%, #eae6df 100%);
  }
  .ss-hero__stage img { width: 78%; height: 78%; object-fit: contain; display: block; filter: drop-shadow(0 24px 40px rgba(36,24,54,0.16)); }
  .ss-hero__placeholder { width: 56%; height: 56%; display: flex; align-items: center; justify-content: center; }
  .ss-hero__placeholder svg { width: 100%; height: auto; opacity: 0.22; fill: var(--ss-purple); }
  .ss-hero__caption { margin: 14px 0 0; font-family: var(--ss-sans); font-weight: 400; font-size: 13px; line-height: 1.45; color: var(--ss-secondary); text-align: left; }

  @media (min-width: 990px) {
    .ss-hero__grid { grid-template-columns: 1.05fr 1fr; gap: 56px; }
    .ss-hero__subhead { font-size: 21px; }
    .ss-hero__ctas { flex-direction: row; justify-content: flex-start; width: auto; }
    .ss-hero__btn { width: auto; }
    .ss-hero__stage { aspect-ratio: 1 / 1; }
  }
  @media (max-width: 989px) { .ss-hero__grid { padding-block: 56px; } }
  @media (max-width: 749px) {
    .ss-hero__grid { padding-block: 44px; }
    .ss-hero__headline { line-height: 1.08; }
    .ss-hero__ctas { gap: 10px; }
    .ss-hero__btn { height: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-hero__btn { transition: none; }
  }
{%- endstyle -%}

<section class="ss-hero" aria-label="{{ section.settings.headline | escape }}">
  <div class="ss-hero__grid">
    <div class="ss-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ss-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.headline != blank -%}
        <h1 class="ss-hero__headline">{{ section.settings.headline }}</h1>
      {%- endif -%}
      {%- if section.settings.subhead != blank -%}
        <div class="ss-hero__subhead">{{ section.settings.subhead }}</div>
      {%- endif -%}
      <div class="ss-hero__ctas">
        {%- if section.settings.primary_cta_label != blank -%}
          <a class="ss-hero__btn ss-hero__btn--primary" href="{{ section.settings.primary_cta_url | default: '#' }}">{{ section.settings.primary_cta_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a class="ss-hero__btn ss-hero__btn--secondary" href="{{ section.settings.secondary_cta_url | default: '#' }}">{{ section.settings.secondary_cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="ss-hero__gallery">
      <div class="ss-hero__stage">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 1024px) 600px, 100vw',
            widths: '480, 768, 1024, 1280, 1600',
            alt: section.settings.image_alt }}
        {%- else -%}
          <div class="ss-hero__placeholder">{{ 'image' | placeholder_svg_tag: 'ss-hero__placeholder-svg' }}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.caption != blank -%}
        <p class="ss-hero__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Hero",
  "tag": "section",
  "class": "senseless-section senseless-hero-brand-led",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made for the appointment" },
    { "type": "text", "id": "headline", "label": "Headline", "info": "Use <em>word</em> for a single italic emphasis word.", "default": "Confidence Starts With Comfort." },
    { "type": "richtext", "id": "subhead", "label": "Lead", "info": "One lead paragraph (~52ch).", "default": "<p>A topical preparation made for aesthetic appointments. Three strengths and three formats, formulated in the UK for the way modern sessions actually run.</p>" },
    { "type": "text", "id": "primary_cta_label", "label": "Primary CTA label", "default": "Shop the range" },
    { "type": "url", "id": "primary_cta_url", "label": "Primary CTA link", "info": "Set to /collections/numbing-cream" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secondary CTA label", "default": "Find your strength" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary CTA link", "info": "Set to /pages/the-senseless-system" },
    { "type": "image_picker", "id": "image", "label": "Hero product image", "info": "Editorial product still life on a warm background, no faces, no clinical setting. Sits beside the text on a soft radial backdrop. 4:5." },
    { "type": "text", "id": "image_alt", "label": "Hero image alt text", "default": "Senseless topical preparation range arranged on a warm off-white background with a purple brand accent" },
    { "type": "text", "id": "caption", "label": "Image caption", "default": "The Senseless range — formulated in the UK." }
  ],
  "presets": [ { "name": "Senseless — Hero" } ]
}
{% endschema %}
{%- comment -%} theme-check note: layout rebuilt to two-column text-left/image-right per Homepage spec; secondary CTA now brand-purple outline (no neutral/black CTA borders, per Master Rebuild Brief button rule). {%- endcomment -%}
