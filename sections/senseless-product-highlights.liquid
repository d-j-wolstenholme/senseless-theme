{%- comment -%}
  Senseless — Product highlights ("new way to shop", Peter override 2026-06-24)
  ONE cohesive section: the shared site header (eyebrow + headline with one italic accent word,
  identical treatment to senseless-format-row / senseless-strength-ladder — same classes, same
  `senseless-accent` snippet) above a 3-across product-card row (stacks on mobile, like
  senseless-procedure-grid). Each "card" block = a per-card label (eyebrow/tag) + one product.
  Reuses snippets/senseless-card-image (lazy media) + snippets/senseless-quick-add (variant/qty/
  add-to-cart → existing cart drawer, its own global stylesheet). Cards with no product render
  nothing; if no card has a product the whole section (header included) outputs nothing.
  NO Product/Offer structured data here (PDP only).
{%- endcomment -%}

{%- liquid
  assign ss_has_content = false
  for block in section.blocks
    if block.settings.product != blank
      assign ss_has_content = true
      break
    endif
  endfor
  assign band = section.settings.band | default: 'canvas'
-%}

{%- if ss_has_content -%}
{%- style -%}
  .ss-ph {
    --ss-purple: #6B3FA0;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-ink: #1A1816;
    --ss-body: #2B2730;
    --ss-muted: #8E8A82;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--ss-ink);
  }
  .ss-ph--canvas { background: var(--ss-bg); }
  .ss-ph--surface { background: var(--ss-surface); }

  /* Header — identical pattern to senseless-format-row */
  .ss-ph__inner { max-width: 1100px; margin: 0 auto; padding-block: 96px; padding-inline: 20px; }
  .ss-ph__header { text-align: center; max-width: 60ch; margin: 0 auto 32px; display: flex; flex-direction: column; gap: 12px; }
  .ss-ph__eyebrow { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-ph__headline { font-family: var(--ss-head); font-weight: 400; letter-spacing: -0.02em; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; margin: 0; }
  .ss-ph__body { font-family: var(--ss-sans); font-size: 17px; line-height: 1.55; color: var(--ss-body); margin: 0; }
  .ss-ph__body p { margin: 0; }

  /* Card grid — 3-across desktop, stack mobile (like senseless-procedure-grid) */
  .ss-ph__grid { display: grid; grid-template-columns: 1fr; gap: 16px; align-items: stretch; }

  .ss-ph__card { display: flex; flex-direction: column; height: 100%; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  /* Click-through affordance: the card lifts, the image zooms, and a "View product" cue + title underline make the link target to the real PDP unmistakable. */
  .ss-ph__card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(107,63,160,.14); border-color: var(--ss-purple); }
  .ss-ph__card:hover .ss-ph__title a { color: var(--ss-purple); text-decoration: underline; }
  .ss-ph__media { aspect-ratio: 1 / 1; background: var(--ss-bg); position: relative; display: block; }
  .ss-ph__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .ss-ph__card:hover .ss-ph__media img { transform: scale(1.05); }
  .ss-ph__view { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 14px 10px; background: linear-gradient(to top, rgba(26,24,22,.72), rgba(26,24,22,0)); color: #fff; font-family: var(--ss-sans); font-weight: 600; font-size: 13px; letter-spacing: .02em; opacity: 0; transform: translateY(6px); transition: opacity .2s ease, transform .2s ease; pointer-events: none; }
  .ss-ph__card:hover .ss-ph__view { opacity: 1; transform: translateY(0); }
  .ss-ph__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-ph__placeholder svg { width: 38%; opacity: 0.22; fill: var(--ss-purple); }
  .ss-ph__cbody { padding: 18px 20px 0; display: flex; flex-direction: column; gap: 6px; }
  .ss-ph__label { font-family: var(--ss-sans); font-weight: 600; font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-ph__comfort { margin: 4px 0 6px; }
  .ss-ph__title { font-family: var(--ss-head); font-weight: 600; font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem); line-height: 1.25; letter-spacing: -0.01em; color: var(--ss-ink); margin: 0; }
  .ss-ph__title a { color: inherit; text-decoration: none; }
  .ss-ph__price { font-family: var(--ss-sans); font-weight: 500; font-size: 16px; color: var(--ss-body); margin: 0; }
  .ss-ph__stars { margin: 2px 0 8px; min-height: 16px; }
  .ss-ph__stars:empty { display: none; }
  .ss-ph__qa { padding: 0 20px 20px; margin-top: 10px; }

  @media (prefers-reduced-motion: reduce) { .ss-ph__card, .ss-ph__media img, .ss-ph__view { transition: none; } .ss-ph__card:hover { transform: none; } .ss-ph__card:hover .ss-ph__media img { transform: none; } }
  @media (min-width: 750px) { .ss-ph__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  @media (max-width: 989px) { .ss-ph__inner { padding-block: 56px; } }
  @media (max-width: 749px) { .ss-ph__inner { padding-block: 44px; } }
{%- endstyle -%}

<section class="ss-ph ss-ph--{{ band }}" aria-label="{{ section.settings.headline | default: 'Popular picks' | escape }}">
  <div class="ss-ph__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.body != blank -%}
      <div class="ss-ph__header">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-ph__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-ph__headline">{% render 'senseless-accent', text: section.settings.headline, word: section.settings.accent_word %}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-ph__body">{{ section.settings.body }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="ss-ph__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          {%- assign card_tier = '' -%}
          {%- for t in p.tags -%}
            {%- assign tl = t | downcase -%}
            {%- if tl == 'clinical' or tl == 'advanced' or tl == 'professional' -%}{%- assign card_tier = tl -%}{%- endif -%}
          {%- endfor -%}
          <div class="ss-ph__card" role="listitem" {{ block.shopify_attributes }}>
            <a class="ss-ph__media" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
              {%- render 'senseless-card-image', product: p, alt: p.title, sizes: '(min-width: 750px) 33vw, 100vw', ph_class: 'ss-ph__placeholder' -%}
              <span class="ss-ph__view" aria-hidden="true">View product &rarr;</span>
            </a>
            <div class="ss-ph__cbody">
              {%- if block.settings.label != blank -%}<p class="ss-ph__label">{{ block.settings.label | escape }}</p>{%- endif -%}
              {%- if card_tier != blank -%}<div class="ss-ph__comfort">{% render 'senseless-comfort-mark', tier: card_tier, name: false, size: 15, link: false %}</div>{%- endif -%}
              <h3 class="ss-ph__title"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
              {%- if p.price > 0 -%}<p class="ss-ph__price">{{ p.price | money }}</p>{%- endif -%}
              <div class="ss-ph__stars jdgm-widget jdgm-preview-badge" data-id="{{ p.id }}" data-template="senseless-card">{{ p.metafields.judgeme.badge }}</div>
            </div>
            <div class="ss-ph__qa">
              {%- render 'senseless-quick-add', product: p, section_id: section.id, uid: block.id -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Senseless — Highlights",
  "tag": "section",
  "class": "senseless-section senseless-product-highlights",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "text", "id": "accent_word", "label": "Italic accent word", "info": "One word in the headline rendered in the italic accent (must appear in the headline)." },
    { "type": "richtext", "id": "body", "label": "Body (optional)" },
    { "type": "select", "id": "band", "label": "Band background", "default": "canvas", "options": [ { "value": "canvas", "label": "Canvas (off-white)" }, { "value": "surface", "label": "Surface (white)" } ] }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product card",
      "settings": [
        { "type": "text", "id": "label", "label": "Card label (eyebrow/tag)" },
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Senseless — Highlights",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
