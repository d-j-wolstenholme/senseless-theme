{%- comment -%}
  Senseless — Strength matrix (procedure suitability)
  Procedure × recommendation rows. Each row has a level (recommended / possible / not-recommended) that styles the pill.
  Honest suitability matrix — tells buyers when a product isn't the right choice. Reusable across all product pages.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  .ss-sm {
    --ss-purple: #6B3FA0;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1a1a1a;
    --ss-body: #4a4a50;
    --ss-muted: #8E8A82;
    --ss-border: #E5E2DC;
    --ss-head: 'Manrope', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ss-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-sm__inner { max-width: 860px; margin: 0 auto; padding: 44px 20px; }
  .ss-sm__header { text-align: center; max-width: 60ch; margin: 0 auto 28px; display: flex; flex-direction: column; gap: 12px; }
  .ss-sm__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-sm__headline { font-family: var(--ss-head); font-weight: 600; font-size: 28px; line-height: 1.2; margin: 0; }
  .ss-sm__intro { font-family: var(--ss-sans); font-size: 16px; line-height: 1.6; color: var(--ss-body); }
  .ss-sm__intro p { margin: 0; }

  .ss-sm__rows { display: flex; flex-direction: column; border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; background: var(--ss-surface); }
  .ss-sm__row { display: flex; flex-direction: column; gap: 6px; padding: 16px 20px; border-bottom: 1px solid var(--ss-border); }
  .ss-sm__row:last-child { border-bottom: 0; }
  .ss-sm__proc { font-family: var(--ss-head); font-weight: 600; font-size: 16px; margin: 0; }
  .ss-sm__rec { font-family: var(--ss-sans); font-size: 14px; margin: 0; display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 4px 12px; border-radius: 999px; }
  .ss-sm__rec--recommended { color: var(--ss-purple); background: rgba(107,63,160,0.08); }
  .ss-sm__rec--possible { color: var(--ss-body); background: rgba(26,26,26,0.05); }
  .ss-sm__rec--not { color: var(--ss-muted); background: rgba(26,26,26,0.04); }
  .ss-sm__right { display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .ss-sm__notes { font-family: var(--ss-sans); font-size: 13px; line-height: 1.45; color: var(--ss-body); margin: 0; }

  .ss-sm__footer { text-align: center; margin-top: 24px; }
  .ss-sm__cta { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 24px; border-radius: 14px; border: 1px solid var(--ss-text); color: var(--ss-text); background: transparent; font-family: var(--ss-sans); font-weight: 500; font-size: 15px; text-decoration: none; transition: background-color 200ms ease-out, color 200ms ease-out; }
  .ss-sm__cta:hover { background: var(--ss-text); color: var(--ss-bg); }

  @media (min-width: 700px) {
    .ss-sm__row { flex-direction: row; align-items: center; justify-content: space-between; }
    .ss-sm__inner { padding-top: 96px; padding-bottom: 96px; }
  }
  @media (prefers-reduced-motion: reduce) { .ss-sm__cta { transition: none; } }
{%- endstyle -%}

<section class="ss-sm" aria-label="{{ section.settings.headline | default: 'Suitability' | escape }}">
  <div class="ss-sm__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank -%}
      <header class="ss-sm__header">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-sm__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-sm__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-sm__intro">{{ section.settings.body }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="ss-sm__rows">
      {%- for block in section.blocks -%}
        <div class="ss-sm__row" {{ block.shopify_attributes }}>
          <p class="ss-sm__proc">{{ block.settings.procedure | escape }}</p>
          <div class="ss-sm__right">
            <span class="ss-sm__rec ss-sm__rec--{{ block.settings.level }}">{{ block.settings.recommendation | escape }}</span>
            {%- if block.settings.notes != blank -%}<p class="ss-sm__notes">{{ block.settings.notes | escape }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="ss-sm__footer">
        <a class="ss-sm__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Suitability",
  "tag": "section",
  "class": "senseless-section senseless-strength-matrix",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Suited for" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "The everyday appointment." },
    { "type": "richtext", "id": "body", "label": "Intro body" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find your strength" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "suitability_row",
      "name": "Procedure row",
      "settings": [
        { "type": "text", "id": "procedure", "label": "Procedure", "default": "Lip Fillers" },
        { "type": "text", "id": "recommendation", "label": "Recommendation", "default": "Recommended" },
        { "type": "text", "id": "notes", "label": "Notes", "info": "Optional small line under the recommendation." },
        { "type": "select", "id": "level", "label": "Level", "default": "recommended", "options": [ { "value": "recommended", "label": "Recommended" }, { "value": "possible", "label": "Possible" }, { "value": "not", "label": "Not recommended" } ] }
      ]
    }
  ],
  "presets": [
    { "name": "Senseless — Strength matrix", "blocks": [ { "type": "suitability_row" }, { "type": "suitability_row" }, { "type": "suitability_row" } ] }
  ]
}
{% endschema %}
