{%- comment -%}
  Senseless — Strength matrix (procedure suitability)
  Procedure × recommendation rows. `level` (recommended / possible / not) styles the primary pill.
  Recommendation text is split on " · " into separate pills so two-tier recs never break mid-phrase
  (first pill emphasised, later pills lighter). `notes` renders as a muted reason line beneath.
  Two-column table on desktop, one card per procedure on mobile. Reusable across guides + product pages.
{%- endcomment -%}

{%- style -%}

  .ss-sm {
    --ss-purple: #6B3FA0;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-secondary: #5C5853;
    --ss-muted: #8E8A82;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-sm__inner { max-width: 860px; margin: 0 auto; padding: 44px 20px; }
  .ss-sm__header { text-align: center; max-width: 60ch; margin: 0 auto 28px; display: flex; flex-direction: column; gap: 12px; }
  .ss-sm__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-sm__headline { font-family: var(--ss-head); font-weight: 400; letter-spacing: -0.02em; font-size: 28px; line-height: 1.2; margin: 0; }
  .ss-sm__intro { font-family: var(--ss-sans); font-size: 16px; line-height: 1.6; color: var(--ss-secondary); }
  .ss-sm__intro p { margin: 0; }

  /* Contained matrix: white surface, light dividers between rows */
  .ss-sm__table { background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 6px; overflow: hidden; }
  .ss-sm__col-head { display: none; }
  .ss-sm__row { display: grid; grid-template-columns: 1fr; gap: 10px; padding: 18px 20px; border-top: 1px solid var(--ss-border); }
  .ss-sm__row:first-child { border-top: 0; }
  .ss-sm__proc { font-family: var(--ss-head); font-weight: 600; font-size: 16px; line-height: 1.3; margin: 0; color: var(--ss-text); align-self: start; }
  .ss-sm__rec { display: flex; flex-direction: column; gap: 8px; }
  .ss-sm__pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .ss-sm__pill { display: inline-flex; align-items: center; font-family: var(--ss-sans); font-weight: 500; font-size: 13px; line-height: 1.3; padding: 5px 12px; border-radius: 999px; border: 1px solid transparent; white-space: nowrap; }
  .ss-sm__pill--recommended { color: var(--ss-purple); background: rgba(107,63,160,0.10); border-color: rgba(107,63,160,0.30); }
  .ss-sm__pill--possible { color: var(--ss-secondary); background: rgba(26,26,26,0.05); border-color: var(--ss-border); }
  .ss-sm__pill--not { color: var(--ss-muted); background: transparent; border-color: var(--ss-border); }
  .ss-sm__pill--secondary { color: var(--ss-secondary); background: transparent; border-color: rgba(107,63,160,0.30); font-weight: 400; }
  .ss-sm__reason { font-family: var(--ss-sans); font-size: 13px; line-height: 1.45; color: var(--ss-secondary); margin: 0; }

  .ss-sm__closer { max-width: 60ch; margin: 22px auto 0; font-family: var(--ss-sans); font-size: 14.5px; line-height: 1.6; color: var(--ss-secondary); text-align: center; }
  .ss-sm__closer p { margin: 0; }
  .ss-sm__footer { text-align: center; margin-top: 28px; }
  .ss-sm__cta { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 24px; border-radius: 14px; border: 1px solid var(--ss-purple); color: var(--ss-purple); background: transparent; font-family: var(--ss-sans); font-weight: 600; font-size: 15px; text-decoration: none; transition: background-color 200ms ease-out, color 200ms ease-out; }
  .ss-sm__cta:hover { background: var(--ss-purple); color: #ffffff; }

  @media (min-width: 700px) {
    .ss-sm__inner { padding-top: 96px; padding-bottom: 96px; }
    .ss-sm__col-head { display: grid; grid-template-columns: 220px 1fr; gap: 28px; padding: 14px 20px; border-bottom: 1px solid var(--ss-border); background: var(--ss-bg); }
    .ss-sm__col-head span { font-family: var(--ss-sans); font-weight: 500; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-muted); }
    .ss-sm__row { grid-template-columns: 220px 1fr; gap: 28px; align-items: center; padding: 18px 20px; }
    .ss-sm__pill { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) { .ss-sm__cta { transition: none; } }
{%- endstyle -%}

<section class="ss-sm"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | escape }}"{% endif %} aria-label="{{ section.settings.headline | default: 'Suitability' | escape }}">
  <div class="ss-sm__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.body != blank -%}
      <header class="ss-sm__header">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-sm__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-sm__headline">{% render 'senseless-accent', text: section.settings.headline, word: section.settings.accent_word %}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-sm__intro">{{ section.settings.body }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="ss-sm__table">
      <div class="ss-sm__col-head" aria-hidden="true"><span>Procedure</span><span>Recommendation</span></div>
      {%- for block in section.blocks -%}
        <div class="ss-sm__row" {{ block.shopify_attributes }}>
          <p class="ss-sm__proc">{{ block.settings.procedure | escape }}</p>
          <div class="ss-sm__rec">
            <div class="ss-sm__pills">
              {%- assign rec_parts = block.settings.recommendation | split: ' · ' -%}
              {%- for part in rec_parts -%}
                {%- if forloop.first -%}
                  <span class="ss-sm__pill ss-sm__pill--{{ block.settings.level }}">{{ part | escape }}</span>
                {%- else -%}
                  <span class="ss-sm__pill ss-sm__pill--secondary">{{ part | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.notes != blank -%}<p class="ss-sm__reason">{{ block.settings.notes | escape }}</p>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.closer != blank -%}<div class="ss-sm__closer">{{ section.settings.closer }}</div>{%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="ss-sm__footer">
        <a class="ss-sm__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Suitability",
  "tag": "section",
  "class": "senseless-section senseless-strength-matrix",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Anchor ID (optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Suited for" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "The everyday appointment." },
    { "type": "text", "id": "accent_word", "label": "Italic accent word (one word, optional)" },
    { "type": "richtext", "id": "body", "label": "Intro body" },
    { "type": "richtext", "id": "closer", "label": "Closing line (under the table, optional)" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Find your strength" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "suitability_row",
      "name": "Procedure row",
      "settings": [
        { "type": "text", "id": "procedure", "label": "Procedure", "default": "Lip Fillers" },
        { "type": "text", "id": "recommendation", "label": "Recommendation", "info": "Separate two-tier recommendations with ' · ' to render them as separate pills.", "default": "Recommended" },
        { "type": "text", "id": "notes", "label": "Notes", "info": "Optional small reason line under the recommendation." },
        { "type": "select", "id": "level", "label": "Level", "default": "recommended", "options": [ { "value": "recommended", "label": "Recommended" }, { "value": "possible", "label": "Possible" }, { "value": "not", "label": "Not recommended" } ] }
      ]
    }
  ],
  "presets": [
    { "name": "Senseless — Strength matrix", "blocks": [ { "type": "suitability_row" }, { "type": "suitability_row" }, { "type": "suitability_row" } ] }
  ]
}
{% endschema %}
