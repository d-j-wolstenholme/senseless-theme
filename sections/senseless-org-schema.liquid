{%- comment -%}
  Senseless — Organization / ContactPoint JSON-LD (no visible output).
  Entity-authority schema for GEO. Carries the public phone (0333 049 5549), CS email,
  legal entity (Matrix Health Group Ltd) + registered address. Placed on the Contact page.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ section.settings.org_name | default: 'Senseless' | json }},
  "legalName": {{ section.settings.legal_name | default: 'Matrix Health Group Ltd' | json }},
  "url": {{ request.origin | json }},
  "email": {{ section.settings.email | default: 'cs@senseless.uk' | json }},
  "telephone": {{ section.settings.telephone | default: '+443330495549' | json }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ section.settings.street | default: 'Paddock Business Centre, Paddock Road' | json }},
    "addressLocality": {{ section.settings.locality | default: 'Skelmersdale' | json }},
    "postalCode": {{ section.settings.postcode | default: 'WN8 9PL' | json }},
    "addressCountry": "GB"
  },
  "contactPoint": [{
    "@type": "ContactPoint",
    "telephone": {{ section.settings.telephone | default: '+443330495549' | json }},
    "email": {{ section.settings.email | default: 'cs@senseless.uk' | json }},
    "contactType": "customer service",
    "areaServed": "GB",
    "availableLanguage": "English"
  }]
}
</script>
{% schema %}
{
  "name": "Senseless — Org schema",
  "tag": "section",
  "class": "senseless-section senseless-org-schema",
  "settings": [
    { "type": "paragraph", "content": "Emits Organization + ContactPoint JSON-LD (no visible output)." },
    { "type": "text", "id": "org_name", "label": "Organization name", "default": "Senseless" },
    { "type": "text", "id": "legal_name", "label": "Legal name", "default": "Matrix Health Group Ltd" },
    { "type": "text", "id": "telephone", "label": "Telephone", "default": "+443330495549" },
    { "type": "text", "id": "email", "label": "Email", "default": "cs@senseless.uk" },
    { "type": "text", "id": "street", "label": "Street", "default": "Paddock Business Centre, Paddock Road" },
    { "type": "text", "id": "locality", "label": "Locality", "default": "Skelmersdale" },
    { "type": "text", "id": "postcode", "label": "Postcode", "default": "WN8 9PL" }
  ],
  "presets": [ { "name": "Senseless — Org schema" } ]
}
{% endschema %}
