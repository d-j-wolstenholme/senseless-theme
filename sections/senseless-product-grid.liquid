{%- comment -%}
  Senseless — Product grid (filterable)
  Headline + body + optional strength filter tabs (All / Clinical / Advanced / Professional) + product_item blocks.
  Client-side filter by data-strength; updates ?strength= URL param. Reusable on every Format/Procedure collection.
  Anchor target #product-grid for hero CTAs. Flagship variant = white card + 2px purple border + filled button.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  .ss-pg {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1a1a1a;
    --ss-body: #4a4a50;
    --ss-border: #E5E2DC;
    --ss-head: 'Manrope', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ss-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-pg__inner { max-width: 1200px; margin: 0 auto; padding: 44px 20px; }
  .ss-pg__header { text-align: center; max-width: 60ch; margin: 0 auto 24px; display: flex; flex-direction: column; gap: 12px; }
  .ss-pg__headline { font-family: var(--ss-head); font-weight: 600; font-size: 28px; line-height: 1.2; margin: 0; }
  .ss-pg__body { font-family: var(--ss-sans); font-size: 17px; line-height: 1.55; color: var(--ss-body); margin: 0; }
  .ss-pg__body p { margin: 0; }
  .ss-pg__tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0 auto 28px; }
  .ss-pg__tab { font-family: var(--ss-sans); font-weight: 500; font-size: 14px; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--ss-border); background: var(--ss-surface); color: var(--ss-text); cursor: pointer; transition: background-color 200ms ease-out, color 200ms ease-out, border-color 200ms ease-out; }
  .ss-pg__tab[aria-pressed="true"] { background: var(--ss-purple); border-color: var(--ss-purple); color: #fff; }
  .ss-pg__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

  .ss-pg__card { position: relative; box-sizing: border-box; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; color: var(--ss-text); transition: transform 200ms ease-out, border-color 200ms ease-out; }
  .ss-pg__card:hover { transform: translateY(-2px); border-color: rgba(26,26,26,0.28); }
  .ss-pg__card[hidden] { display: none; }
  .ss-pg__media { aspect-ratio: 4 / 5; background: var(--ss-bg); position: relative; }
  .ss-pg__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-pg__ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-pg__ph svg { width: 38%; opacity: 0.22; fill: var(--ss-purple); }
  .ss-pg__cbody { padding: 20px; display: flex; flex-direction: column; gap: 6px; flex: 1 1 auto; }
  .ss-pg__label { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-pg__title { font-family: var(--ss-head); font-weight: 600; font-size: 18px; line-height: 1.3; margin: 0; }
  .ss-pg__price { font-family: var(--ss-sans); font-weight: 500; font-size: 16px; margin: 2px 0 0; }
  .ss-pg__cta { margin-top: auto; padding-top: 10px; font-family: var(--ss-sans); font-weight: 500; font-size: 14px; color: var(--ss-purple); display: inline-flex; align-items: center; gap: 6px; }
  .ss-pg__cta::after { content: '\2192'; }

  .ss-pg__card--flagship { border: 2px solid var(--ss-purple); }
  .ss-pg__card--flagship:hover { border-color: var(--ss-purple); }
  .ss-pg__badge { position: absolute; top: 12px; right: 12px; z-index: 1; background: var(--ss-purple); color: #fff; font-family: var(--ss-sans); font-weight: 500; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 10px; border-radius: 999px; }

  @media (min-width: 768px) { .ss-pg__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }
  @media (min-width: 1024px) { .ss-pg__inner { padding: 96px 40px; } }
  @media (prefers-reduced-motion: reduce) { .ss-pg__card, .ss-pg__tab { transition: none; } .ss-pg__card:hover { transform: none; } }
{%- endstyle -%}

<section class="ss-pg" id="product-grid" aria-label="{{ section.settings.headline | default: 'Products' | escape }}" data-ss-pg>
  <div class="ss-pg__inner">
    {%- if section.settings.headline != blank or section.settings.body != blank -%}
      <div class="ss-pg__header">
        {%- if section.settings.headline != blank -%}<h2 class="ss-pg__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-pg__body">{{ section.settings.body }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_filters -%}
      <div class="ss-pg__tabs" role="group" aria-label="Filter by strength">
        <button type="button" class="ss-pg__tab" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="ss-pg__tab" data-filter="clinical" aria-pressed="false">Clinical</button>
        <button type="button" class="ss-pg__tab" data-filter="advanced" aria-pressed="false">Advanced</button>
        <button type="button" class="ss-pg__tab" data-filter="professional" aria-pressed="false">Professional</button>
      </div>
    {%- endif -%}

    <div class="ss-pg__grid">
      {%- for block in section.blocks -%}
        <a class="ss-pg__card{% if block.settings.flagship %} ss-pg__card--flagship{% endif %}" href="{{ block.settings.cta_url | default: '#' }}" data-strength="{{ block.settings.strength }}" {{ block.shopify_attributes }}>
          <div class="ss-pg__media">
            {%- if block.settings.flagship and block.settings.badge_text != blank -%}<span class="ss-pg__badge">{{ block.settings.badge_text | escape }}</span>{%- endif -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 33vw, 50vw', widths: '300, 500, 800', alt: block.settings.image_alt }}
            {%- else -%}
              <div class="ss-pg__ph">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
          </div>
          <div class="ss-pg__cbody">
            {%- if block.settings.label != blank -%}<p class="ss-pg__label">{{ block.settings.label | escape }}</p>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="ss-pg__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.price != blank -%}<p class="ss-pg__price">{{ block.settings.price | escape }}</p>{%- endif -%}
            {%- if block.settings.cta_label != blank -%}<span class="ss-pg__cta">{{ block.settings.cta_label | escape }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.matches('[data-ss-pg]')) { root = document.querySelector('[data-ss-pg]'); }
    if (!root) return;
    var tabs = root.querySelectorAll('.ss-pg__tab');
    var cards = root.querySelectorAll('.ss-pg__card');
    function apply(filter) {
      cards.forEach(function (c) {
        var s = c.getAttribute('data-strength') || '';
        c.hidden = !(filter === 'all' || s === filter);
      });
      tabs.forEach(function (t) { t.setAttribute('aria-pressed', t.getAttribute('data-filter') === filter ? 'true' : 'false'); });
    }
    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var f = t.getAttribute('data-filter');
        apply(f);
        try {
          var url = new URL(window.location);
          if (f === 'all') { url.searchParams.delete('strength'); } else { url.searchParams.set('strength', f); }
          window.history.replaceState({}, '', url);
        } catch (e) {}
      });
    });
    tabs.forEach(function (t) {
      var f = t.getAttribute('data-filter');
      if (f === 'all') return;
      var has = Array.prototype.some.call(cards, function (c) { return (c.getAttribute('data-strength') || '') === f; });
      if (!has) t.style.display = 'none';
    });
    try {
      var init = new URL(window.location).searchParams.get('strength');
      if (init && ['clinical', 'advanced', 'professional'].indexOf(init) !== -1) apply(init);
    } catch (e) {}
  })();
</script>

{% schema %}
{
  "name": "Senseless — Product grid",
  "tag": "section",
  "class": "senseless-section senseless-product-grid",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "show_filters", "label": "Show strength filter tabs", "default": true }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless product on a warm off-white background" },
        { "type": "select", "id": "strength", "label": "Strength (for filtering)", "default": "clinical", "options": [ { "value": "clinical", "label": "Clinical" }, { "value": "advanced", "label": "Advanced" }, { "value": "professional", "label": "Professional" }, { "value": "none", "label": "None" } ] },
        { "type": "text", "id": "label", "label": "Label (eyebrow)", "default": "Clinical Strength" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cream 30g" },
        { "type": "text", "id": "price", "label": "Price", "default": "£TBC" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View product" },
        { "type": "url", "id": "cta_url", "label": "CTA link" },
        { "type": "checkbox", "id": "flagship", "label": "Flagship variant", "default": false },
        { "type": "text", "id": "badge_text", "label": "Flagship badge text", "default": "Flagship" }
      ]
    }
  ],
  "presets": [
    { "name": "Senseless — Product grid", "blocks": [ { "type": "product_item" }, { "type": "product_item" }, { "type": "product_item" } ] }
  ]
}
{% endschema %}
