{%- comment -%}
  Senseless — Image band
  Two-column image/text. `direction` = text-left (image right) or text-right (image left) on desktop.
  Used twice on the homepage (Section 4 and Section 7). All copy editable; URL/image wired per-instance.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Inter:wght@400;500&display=swap');

  .ss-itb {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1a1a1a;
    --ss-body: #4a4a50;
    --ss-border: rgba(26,26,26,0.10);
    --ss-head: 'Manrope', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --ss-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-itb__inner { max-width: 1200px; margin: 0 auto; padding: 44px 20px; display: grid; gap: 28px; }
  .ss-itb__text { display: flex; flex-direction: column; gap: 16px; }
  .ss-itb__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; line-height: 1.2; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-itb__headline { font-family: var(--ss-head); font-weight: 600; font-size: 28px; line-height: 1.2; margin: 0; color: var(--ss-text); max-width: 18ch; }
  .ss-itb__body { font-family: var(--ss-sans); font-size: 17px; line-height: 1.55; color: var(--ss-body); margin: 0; max-width: 52ch; }
  .ss-itb__body p { margin: 0 0 0.75em; }
  .ss-itb__body p:last-child { margin-bottom: 0; }
  .ss-itb__cta { align-self: flex-start; margin-top: 4px; font-family: var(--ss-sans); font-weight: 500; font-size: 15px; color: var(--ss-purple); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; border-bottom: 1px solid transparent; transition: border-color 200ms ease-out; }
  .ss-itb__cta::after { content: '→'; }
  .ss-itb__cta:hover { border-bottom-color: var(--ss-purple); }
  .ss-itb__media { border-radius: 4px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--ss-surface); border: 1px solid var(--ss-border); }
  .ss-itb__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-itb__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-itb__placeholder svg { width: 38%; opacity: 0.22; fill: var(--ss-purple); }

  @media (min-width: 1024px) {
    .ss-itb__inner { grid-template-columns: 1fr 1fr; align-items: center; gap: 64px; padding: 96px 40px; }
    .ss-itb__headline { font-size: 32px; }
    .ss-itb__body { font-size: 18px; }
    .ss-itb__media { aspect-ratio: 3 / 2; }
    .ss-itb--text-right .ss-itb__text { order: 2; }
    .ss-itb--text-right .ss-itb__media { order: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ss-itb__cta { transition: none; }
  }
{%- endstyle -%}

<section class="ss-itb ss-itb--{{ section.settings.direction }}" aria-label="{{ section.settings.headline | default: 'Image and text' | escape }}">
  <div class="ss-itb__inner">
    <div class="ss-itb__text">
      {%- if section.settings.eyebrow != blank -%}<p class="ss-itb__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.headline != blank -%}<h2 class="ss-itb__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<div class="ss-itb__body">{{ section.settings.body }}</div>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}<a class="ss-itb__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
    </div>
    <div class="ss-itb__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 50vw, 100vw', widths: '480, 768, 1024, 1200', alt: section.settings.image_alt }}
      {%- else -%}
        <div class="ss-itb__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Image band",
  "tag": "section",
  "class": "senseless-section senseless-image-text-band",
  "settings": [
    { "type": "select", "id": "direction", "label": "Layout direction (desktop)", "default": "text-left", "options": [ { "value": "text-left", "label": "Text left / image right" }, { "value": "text-right", "label": "Text right / image left" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Editorial. 3:2 landscape desktop / 4:5 portrait mobile." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Editorial close-up of a Senseless topical preparation in soft warm light" }
  ],
  "presets": [ { "name": "Senseless — Image band" } ]
}
{% endschema %}
