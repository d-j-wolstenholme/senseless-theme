{%- comment -%}
  Senseless — Strength links (product pages). A LEAN stacked list of the three strengths in the
  CURRENT product's format, each linking to that product (full product name as the anchor). Resolves
  the siblings dynamically from the format collection by the product's type, so the one shared
  product template works for cream / gel / spray. Renders nothing for other types (cleanser/bundle).
{%- endcomment -%}
{%- liquid
  assign t = product.type | downcase
  assign handle = ''
  assign flabel = ''
  case t
    when 'cream'
      assign handle = 'numbing-cream'
      assign flabel = 'cream'
    when 'gel'
      assign handle = 'numbing-gel'
      assign flabel = 'gel'
    when 'spray'
      assign handle = 'numbing-spray'
      assign flabel = 'spray'
  endcase
-%}
{%- if handle != blank and collections[handle] != blank -%}
{%- assign coll = collections[handle] -%}
{%- assign ranks = 'Clinical,Advanced,Professional' | split: ',' -%}
{%- style -%}
  .ss-stl { --p:#6B3FA0; --bg:#f7f7f5; --surf:#ffffff; --ink:#1A1816; --body:#2B2730; --sec:#5C5853; --bd:#E5E2DC;
    --sans:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink); font-family:var(--sans); }
  .ss-stl--surface { background:var(--surf); }
  .ss-stl__inner { max-width:760px; margin:0 auto; padding-block:48px; padding-inline:20px; }
  .ss-stl__eyebrow { font-weight:600; font-size:0.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--p); margin:0 0 10px; }
  .ss-stl__headline { font-weight:400; letter-spacing:-0.02em; font-size:clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height:1.1; margin:0 0 18px; }
  .ss-stl__list { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; }
  .ss-stl__item { border-top:1px solid var(--bd); padding:14px 0; display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
  .ss-stl__item:last-child { border-bottom:1px solid var(--bd); }
  .ss-stl__link { font-weight:600; font-size:17px; color:var(--p); text-decoration:none; }
  .ss-stl__link:hover { text-decoration:underline; }
  @media (max-width:989px) { .ss-stl__inner { padding-block:32px; } }
  @media (max-width:749px) { .ss-stl__inner { padding-block:28px; } }
  .ss-stl__current { font-size:12px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:var(--sec); background:rgba(107,63,160,.10); border:1px solid rgba(107,63,160,.25); border-radius:999px; padding:2px 8px; }
{%- endstyle -%}
<section class="ss-stl ss-stl--{{ section.settings.band | default: 'canvas' }}" aria-label="The three strengths">
  <div class="ss-stl__inner">
    <p class="ss-stl__eyebrow">{{ section.settings.eyebrow | default: 'The range' | escape }}</p>
    <h2 class="ss-stl__headline">Three strengths in the {{ flabel }} format</h2>
    <ul class="ss-stl__list">
      {%- for r in ranks -%}
        {%- for prod in coll.products -%}
          {%- if prod.tags contains r -%}
            <li class="ss-stl__item">
              <a class="ss-stl__link" href="{{ prod.url }}">{{ prod.title | escape }}</a>
              {%- if prod.id == product.id -%}<span class="ss-stl__current">You're viewing this</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Strength links",
  "tag": "section",
  "class": "senseless-section senseless-strength-links",
  "settings": [
    { "type": "paragraph", "content": "Lean stacked list of the three strengths in this product's format, each linking to its product. Resolves siblings dynamically by product type (cream/gel/spray). No output for other types." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The range" },
    { "type": "select", "id": "band", "label": "Band background", "default": "canvas", "options": [ { "value": "canvas", "label": "Canvas (off-white)" }, { "value": "surface", "label": "Surface (white)" } ] }
  ],
  "presets": [ { "name": "Senseless — Strength links" } ]
}
{% endschema %}
