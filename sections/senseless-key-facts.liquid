{%- comment -%}
 Senseless — Key facts (GEO block)
 A clearly-labelled, machine-extractable "Key facts" block: heading + definition-style list
 (semantic <dl> with <dt>/<dd> pairs), built for generative-engine + answer-engine extraction.
 Per-page facts are set as block instances (pulled from each page's v2 "Key Facts" content in Notion).
 The closing classification line is FIXED and non-editable so the compliance statement always renders:
  "By Matrix Health Group Ltd — formulated in the UK, CPSR assessed." (de-classified 1 Sep 2026, completing the 14 Aug decision)
 No medicinal claims. No price (products are £TBC). Reuses the locked Senseless tokens.
{%- endcomment -%}

{%- style -%}
 .ss-kf {
  --ss-purple: #6B3FA0;
  --ss-bg: #f7f7f5;
  --ss-surface: #ffffff;
  --ss-text: #1A1816;
  --ss-body: #2B2730;
  --ss-secondary: #5C5853;
  --ss-border: rgba(26,26,26,0.10);
  --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: var(--ss-text);
 }
 .ss-kf--canvas { background: var(--ss-bg); }
 .ss-kf--surface { background: var(--ss-surface); border-top: 1px solid var(--ss-border); border-bottom: 1px solid var(--ss-border); }
 .ss-kf__inner { max-width: 720px; margin: 0 auto; padding-block: 96px; padding-inline: 24px; }
 .ss-kf__heading { font-family: var(--ss-sans); font-weight: 400; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em; color: var(--ss-text); margin: 0 0 20px; }
 .ss-kf__list { margin: 0; display: grid; gap: 0; }
 .ss-kf__row { display: grid; grid-template-columns: 220px 1fr; gap: 28px; align-items: baseline; padding: 14px 0; border-bottom: 1px solid var(--ss-border); }
 .ss-kf__row:first-child { border-top: 1px solid var(--ss-border); }
 .ss-kf__term { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; line-height: 1.3; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
 .ss-kf__desc { font-family: var(--ss-sans); font-weight: 400; font-size: 16px; line-height: 1.55; color: var(--ss-body); margin: 0; }
 .ss-kf__statement { font-family: var(--ss-sans); font-weight: 600; font-size: 14px; line-height: 1.5; color: var(--ss-text); margin: 22px 0 0; }
 @media (max-width: 749px) {
  .ss-kf__heading { line-height: 1.12; }
  .ss-kf__row { grid-template-columns: 1fr; gap: 2px; }
 }
 @media (max-width: 989px) { .ss-kf__inner { padding-block: 56px; } }
 @media (max-width: 749px) { .ss-kf__inner { padding-block: 44px; } }
{%- endstyle -%}

<section class="ss-kf ss-kf--{{ section.settings.band }}" aria-labelledby="ss-kf-h-{{ section.id }}">
 <div class="ss-kf__inner" data-ss-reveal>
  <h2 class="ss-kf__heading" id="ss-kf-h-{{ section.id }}">{% render 'senseless-accent', text: section.settings.heading, word: section.settings.accent_word %}</h2>
  {%- if section.blocks.size > 0 -%}
   <dl class="ss-kf__list">
    {%- for block in section.blocks -%}
     {%- if block.type == 'fact' and block.settings.label != blank -%}
      <div class="ss-kf__row" {{ block.shopify_attributes }}>
       <dt class="ss-kf__term">{{ block.settings.label | escape }}</dt>
       <dd class="ss-kf__desc">{{ block.settings.value | escape }}</dd>
      </div>
     {%- endif -%}
    {%- endfor -%}
   </dl>
  {%- endif -%}
  {%- comment -%} Fixed compliance classification — intentionally not editable. {%- endcomment -%}
 </div>
</section>

{% schema %}
{
 "name": "Senseless — Key facts",
 "tag": "section",
 "class": "senseless-section senseless-key-facts",
 "settings": [
  { "type": "select", "id": "band", "label": "Band background", "default": "surface", "options": [ { "value": "canvas", "label": "Canvas (off-white)" }, { "value": "surface", "label": "Surface (white, hairline border)" } ] },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Key facts" },
  { "type": "text", "id": "accent_word", "label": "Italic accent word (one word, optional)" },
  { "type": "paragraph", "content": "The closing line — the MHG credentials + CPSR sentence — is fixed and always shown. Add the page's facts as blocks below (label + value). No price, no medicinal claims." }
 ],
 "blocks": [
  {
   "type": "fact",
   "name": "Fact",
   "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Label" },
    { "type": "text", "id": "value", "label": "Value", "default": "Value" }
   ]
  }
 ],
 "max_blocks": 12,
 "presets": [
  {
   "name": "Senseless — Key facts",
   "blocks": [
    { "type": "fact", "settings": { "label": "Category", "value": "Topical cosmetic preparation" } },
    { "type": "fact", "settings": { "label": "Formats", "value": "Cream, gel and spray" } },
    { "type": "fact", "settings": { "label": "Strengths", "value": "Clinical, Advanced, Professional" } },
    { "type": "fact", "settings": { "label": "Formulated in", "value": "United Kingdom" } }
   ]
  }
 ]
}
{% endschema %}
