{%- comment -%}
  Senseless — Articles hub (/pages/articles). The umbrella index for editorial content:
    1. ARTICLES — every article across ALL blogs (dynamic; auto-includes future articles + future blogs).
    2. GUIDES — curated guide PAGES that aren't surfaced in The System dropdown (block list).
  Card styling matches the site. Emits CollectionPage + BreadcrumbList JSON-LD.
{%- endcomment -%}
{%- liquid
  assign base = shop.url
  assign handles = section.settings.blog_handles | default: 'guides,news' | split: ','
  assign total = 0
  for h in handles
    assign hh = h | strip
    assign bl = blogs[hh]
    if bl != blank
      assign total = total | plus: bl.articles_count
    endif
  endfor
-%}
{%- style -%}
  .ss-ah { --p:#6B3FA0; --bg:#f7f7f5; --surf:#ffffff; --ink:#1A1816; --body:#2B2730; --sec:#5C5853; --bd:#E5E2DC;
    --sans:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink); font-family:var(--sans); }
  .ss-ah__head { max-width:760px; margin:0 auto; padding:56px 20px 8px; }
  .ss-ah__eyebrow { font-weight:600; font-size:0.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--p); margin:0 0 12px; }
  .ss-ah__title { font-weight:400; letter-spacing:-0.02em; font-size:clamp(2.5rem, 1.5rem + 4vw, 4rem); line-height:1.06; margin:0 0 14px; }
  .ss-ah__intro { font-size:17px; line-height:1.6; color:var(--body); } .ss-ah__intro p { margin:0 0 10px; }
  .ss-ah__group { max-width:1100px; margin:0 auto; padding:24px 20px 8px; }
  .ss-ah__grouphead { font-weight:600; font-size:0.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--p); margin:16px 0 16px; }
  .ss-ah__grid { display:grid; grid-template-columns:1fr; gap:20px; }
  .ss-ah__card { background:var(--surf); border:1px solid var(--bd); border-radius:4px; overflow:hidden; display:flex; flex-direction:column; transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .ss-ah__card:hover { transform:translateY(-4px); box-shadow:0 14px 34px rgba(107,63,160,.14); border-color:var(--p); }
  .ss-ah__media { aspect-ratio:16/9; background:var(--bg); display:block; position:relative; }
  .ss-ah__media img { width:100%; height:100%; object-fit:cover; display:block; transition:transform .35s ease; }
  .ss-ah__card:hover .ss-ah__media img { transform:scale(1.05); }
  .ss-ah__ph { width:100%; height:100%; display:flex; align-items:center; justify-content:center; }
  .ss-ah__ph svg { width:34%; opacity:.18; fill:var(--p); }
  .ss-ah__view { position:absolute; left:0; right:0; bottom:0; padding:18px 14px 10px; background:linear-gradient(to top, rgba(26,24,22,.72), rgba(26,24,22,0)); color:#fff; font-family:var(--sans); font-weight:600; font-size:13px; letter-spacing:.02em; opacity:0; transform:translateY(6px); transition:opacity .2s ease, transform .2s ease; pointer-events:none; }
  .ss-ah__card:hover .ss-ah__view { opacity:1; transform:translateY(0); }
  .ss-ah__cbody { padding:18px; display:flex; flex-direction:column; gap:8px; flex:1 1 auto; }
  .ss-ah__ctitle { font-weight:600; font-size:18px; line-height:1.25; letter-spacing:-0.01em; margin:0; }
  .ss-ah__ctitle a { color:inherit; text-decoration:none; }
  .ss-ah__card:hover .ss-ah__ctitle a { color:var(--p); text-decoration:underline; }
  .ss-ah__excerpt { font-size:14.5px; line-height:1.55; color:var(--sec); margin:0; }
  @media (min-width:700px){ .ss-ah__grid { grid-template-columns:repeat(3,1fr); gap:24px; } }
  @media (max-width:749px){ .ss-ah__title { line-height:1.08; } }
  @media (prefers-reduced-motion: reduce){ .ss-ah__card, .ss-ah__media img, .ss-ah__view { transition:none; } .ss-ah__card:hover { transform:none; } .ss-ah__card:hover .ss-ah__media img { transform:none; } }
{%- endstyle -%}
<section class="ss-ah" aria-label="{{ section.settings.headline | default: 'Articles' | escape }}">
  <header class="ss-ah__head">
    <p class="ss-ah__eyebrow">{{ section.settings.eyebrow | default: 'Read' | escape }}</p>
    <h1 class="ss-ah__title">{{ section.settings.headline | default: 'Articles' | escape }}</h1>
    {%- if section.settings.intro != blank -%}<div class="ss-ah__intro">{{ section.settings.intro }}</div>{%- endif -%}
  </header>

  {%- comment -%} ARTICLES — every blog, every article (future-proof) {%- endcomment -%}
  {%- if total > 0 -%}
    <div class="ss-ah__group">
      <p class="ss-ah__grouphead">{{ section.settings.articles_heading | default: 'Articles' | escape }}</p>
      <div class="ss-ah__grid">
        {%- for h in handles -%}
          {%- assign hh = h | strip -%}{%- assign blg = blogs[hh] -%}
          {%- if blg == blank -%}{%- continue -%}{%- endif -%}
          {%- for art in blg.articles -%}
            <article class="ss-ah__card">
              <a class="ss-ah__media" href="{{ art.url }}" aria-label="{{ art.title | escape }}">
                {%- if art.image -%}{{ art.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width:700px) 33vw, 100vw', widths: '300,600', alt: art.title | escape }}<span class="ss-ah__view" aria-hidden="true">Read article &rarr;</span>
                {%- else -%}<span class="ss-ah__ph">{{ 'image' | placeholder_svg_tag }}</span>{%- endif -%}
              </a>
              <div class="ss-ah__cbody">
                <h2 class="ss-ah__ctitle"><a href="{{ art.url }}">{{ art.title | escape }}</a></h2>
                {%- assign one = art.excerpt | strip_html | default: art.content | strip_html | truncate: 120 -%}
                {%- if one != blank -%}<p class="ss-ah__excerpt">{{ one }}</p>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} GUIDES — curated guide pages (blocks) not in The System dropdown {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ss-ah__group">
      <p class="ss-ah__grouphead">{{ section.settings.guides_heading | default: 'Guides' | escape }}</p>
      <div class="ss-ah__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.url != blank -%}
            <article class="ss-ah__card" {{ block.shopify_attributes }}>
              <a class="ss-ah__media" href="{{ block.settings.url }}" aria-label="{{ block.settings.title | escape }}">
                {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width:700px) 33vw, 100vw', widths: '300,600', alt: block.settings.title | escape }}<span class="ss-ah__view" aria-hidden="true">Read article &rarr;</span>
                {%- else -%}<span class="ss-ah__ph">{{ 'image' | placeholder_svg_tag }}</span>{%- endif -%}
              </a>
              <div class="ss-ah__cbody">
                <h2 class="ss-ah__ctitle"><a href="{{ block.settings.url }}">{{ block.settings.title | escape }}</a></h2>
                {%- if block.settings.body != blank -%}<p class="ss-ah__excerpt">{{ block.settings.body | escape }}</p>{%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ section.settings.headline | default: 'Articles' | json }},
  "url": {{ base | append: page.url | json }},
  "hasPart": [
    {%- assign first = true -%}
    {%- for h in handles -%}{%- assign hh = h | strip -%}{%- assign blg = blogs[hh] -%}{%- if blg == blank -%}{%- continue -%}{%- endif -%}{%- for art in blg.articles -%}{%- unless first -%},{%- endunless -%}{ "@type": "BlogPosting", "headline": {{ art.title | json }}, "url": {{ base | append: art.url | json }} }{%- assign first = false -%}{%- endfor -%}{%- endfor -%}
  ]
}
</script>
{%- comment -%} BreadcrumbList intentionally NOT emitted here — senseless-structured-data.liquid emits Home → page for page_type 'page'. Prevents duplicate BreadcrumbList on /pages/articles. {%- endcomment -%}

{% schema %}
{
  "name": "Articles hub",
  "tag": "section",
  "class": "senseless-section senseless-articles-hub",
  "settings": [
    { "type": "paragraph", "content": "ARTICLES = every article across all blogs (auto-updates). GUIDES = the curated guide-page cards below." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Read" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Articles" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "articles_heading", "label": "Articles group heading", "default": "Articles" },
    { "type": "text", "id": "guides_heading", "label": "Guides group heading", "default": "Guides" },
    { "type": "text", "id": "blog_handles", "label": "Blog handles to include (comma-separated)", "info": "Lists every article from these blogs. Add a new blog's handle here when you create one.", "default": "guides,news" }
  ],
  "blocks": [
    {
      "type": "guide_link",
      "name": "Guide page",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Guide" },
        { "type": "url", "id": "url", "label": "Page link" },
        { "type": "text", "id": "body", "label": "One-line description" },
        { "type": "image_picker", "id": "image", "label": "Thumbnail (optional)" }
      ]
    }
  ],
  "presets": [ { "name": "Articles hub" } ]
}
{% endschema %}
