{%- comment -%}
  Senseless — Card row (trio / quad)
  Reusable workhorse. `columns` = 3 or 4. Three block types: tier_card, procedure_card, product_card.
  All tiers render identically (Scale Phase 4) — the flagship variant is retired. Professional is the practitioner tier, signalled by the Senseless Scale comfort mark, never by visual weight.
  All copy editable in the theme editor; URLs/images wired per-instance (templates/index.json).
{%- endcomment -%}

{%- style -%}

  .ss-trio {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-dark: #241836;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-trio__inner { max-width: 1200px; margin: 0 auto; padding-block: 96px; padding-inline: 20px; }
  .ss-trio__header { max-width: 62ch; margin: 0 auto 28px; text-align: center; display: flex; flex-direction: column; gap: 12px; }
  .ss-trio__eyebrow { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; line-height: 1.2; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-trio__headline { font-family: var(--ss-head); font-weight: 400; letter-spacing: -0.02em; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; margin: 0; color: var(--ss-text); }
  .ss-trio__body { font-family: var(--ss-sans); font-size: 17px; line-height: 1.55; color: var(--ss-body); margin: 0; }
  .ss-trio__body p { margin: 0; }

  .ss-trio__grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .ss-trio--cols-4 .ss-trio__grid { grid-template-columns: repeat(2, 1fr); }

  .ss-card { position: relative; box-sizing: border-box; height: 100%; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; color: var(--ss-text); transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .ss-card:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(107,63,160,.14); border-color: var(--ss-purple); }
  /* Static (non-linking) editorial cards get no lift/zoom — they're not clickable. */
  .ss-card--static, .ss-card--static:hover { transform: none; box-shadow: none; border-color: var(--ss-border); cursor: default; }
  .ss-card--static:hover .ss-card__media img { transform: none; }
  .ss-card:hover .ss-card__heading { color: var(--ss-purple); text-decoration: underline; }
  .ss-card__cardlink { display: flex; flex-direction: column; text-decoration: none; color: inherit; flex: 1 1 auto; }
  .ss-card--product .ss-qa { padding: 0 20px 20px; margin-top: 0; }
  .ss-card__media { aspect-ratio: var(--ss-card-ratio, 1 / 1); background: var(--ss-bg); position: relative; display: block; }
  .ss-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .ss-card:hover .ss-card__media img { transform: scale(1.05); }
  .ss-card__view { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 14px 10px; background: linear-gradient(to top, rgba(26,24,22,.72), rgba(26,24,22,0)); color: #fff; font-family: var(--ss-sans, 'Montserrat'); font-weight: 600; font-size: 13px; letter-spacing: .02em; opacity: 0; transform: translateY(6px); transition: opacity .2s ease, transform .2s ease; pointer-events: none; }
  .ss-card:hover .ss-card__view { opacity: 1; transform: translateY(0); }
  .ss-card__comfort { margin: 4px 0 6px; }
  .ss-card__stars { padding: 0 20px; margin: -8px 0 8px; min-height: 16px; }
  .ss-card__stars:empty { display: none; }
  .ss-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-card__placeholder svg { width: 38%; opacity: 0.22; fill: var(--ss-purple); }
  .ss-card__body { padding: 20px; display: flex; flex-direction: column; gap: 8px; flex: 1 1 auto; }
  .ss-card__label { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; line-height: 1.2; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-card__heading { font-family: var(--ss-head); font-weight: 600; font-size: clamp(1.25rem, 1.18rem + 0.3vw, 1.375rem); line-height: 1.25; letter-spacing: -0.01em; margin: 0; color: var(--ss-text); }
  .ss-card__text { font-family: var(--ss-sans); font-size: 15px; line-height: 1.55; color: var(--ss-body); margin: 0; }
  .ss-card__text p { margin: 0; }
  .ss-card__price { font-family: var(--ss-sans); font-weight: 500; font-size: 16px; margin: 2px 0 0; color: var(--ss-text); }
  .ss-card__cta { margin-top: auto; padding-top: 10px; font-family: var(--ss-sans); font-weight: 500; font-size: 14px; color: var(--ss-purple); display: inline-flex; align-items: center; gap: 6px; }
  .ss-card__cta::after { content: '→'; }
  .ss-card__ctabtn { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 18px; border-radius: 14px; border: 1px solid var(--ss-purple); color: var(--ss-purple); font-family: var(--ss-sans); font-weight: 500; font-size: 14px; text-decoration: none; transition: background-color 200ms ease-out, color 200ms ease-out; }
  .ss-card__ctabtn:hover { background: var(--ss-purple); border-color: var(--ss-purple); color: #ffffff; }
  {%- comment -%} Flagship tier treatment retired (Scale Phase 4): tiers are equal; Professional is the practitioner tier, not visually heavier. {%- endcomment -%}

  .ss-trio__footer { text-align: center; margin-top: 28px; display: flex; flex-direction: column; gap: 14px; align-items: center; }
  .ss-trio__closer { font-family: var(--ss-head); font-weight: 600; font-size: clamp(1.25rem, 1.18rem + 0.3vw, 1.375rem); line-height: 1.25; letter-spacing: -0.01em; color: var(--ss-text); margin: 0; }
  .ss-trio__closerlink { color: var(--ss-purple); text-decoration: none; }
  .ss-trio__closerlink:hover { text-decoration: underline; }
  .ss-trio__sectioncta { display: inline-flex; align-items: center; justify-content: center; height: 44px; padding: 0 24px; border-radius: 14px; border: 1px solid var(--ss-purple); color: var(--ss-purple); background: transparent; font-family: var(--ss-sans); font-weight: 500; font-size: 15px; text-decoration: none; transition: background-color 200ms ease-out, color 200ms ease-out; }
  .ss-trio__sectioncta:hover { background: var(--ss-purple); border-color: var(--ss-purple); color: #ffffff; }

  @media (min-width: 768px) {
    .ss-trio--cols-2 .ss-trio__grid { grid-template-columns: repeat(2, 1fr); }
    .ss-trio--cols-3 .ss-trio__grid { grid-template-columns: repeat(3, 1fr); }
    .ss-trio--cols-4 .ss-trio__grid { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 1024px) {
    .ss-trio__inner { padding-inline: 40px; }
    .ss-trio__grid { gap: 24px; }
  }
  @media (max-width: 989px) { .ss-trio__inner { padding-block: 56px; } }
  @media (max-width: 749px) { .ss-trio__inner { padding-block: 44px; } }
  @media (prefers-reduced-motion: reduce) {
    .ss-card, .ss-card__media img, .ss-card__view, .ss-card__ctabtn, .ss-trio__sectioncta { transition: none; }
    .ss-card:hover { transform: none; }
    .ss-card:hover .ss-card__media img { transform: none; }
  }
{%- endstyle -%}

<section class="ss-trio ss-trio--cols-{{ section.settings.columns }}" style="--ss-card-ratio: {{ section.settings.media_ratio | default: '1 / 1' }};" aria-label="{{ section.settings.headline | default: 'Card row' | escape }}">
  <div class="ss-trio__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.body != blank -%}
      <header class="ss-trio__header" data-ss-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="ss-trio__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-trio__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-trio__body">{{ section.settings.body }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="ss-trio__grid" data-ss-reveal-group>
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'tier_card' -%}
            {%- liquid
              assign tier_img = block.settings.image
              if tier_img == blank and block.settings.collection != blank and block.settings.collection.image != blank
                assign tier_img = block.settings.collection.image
              endif
            -%}
            <div class="ss-card{% if tier_img == blank %} ss-card--noimg{% endif %}" {{ block.shopify_attributes }} data-ss-reveal>
              {%- comment -%} Empty-safe (§11): render the media only when collection.image (or an override) exists — no placeholder/grey box on a clean text card. {%- endcomment -%}
              {%- if tier_img != blank -%}
                {%- if block.settings.cta_url != blank -%}
                  <a class="ss-card__media" href="{{ block.settings.cta_url }}">
                    {{ tier_img | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 33vw, 100vw', widths: '400, 600, 800', alt: block.settings.image_alt }}
                    {%- if block.settings.cta_url != blank -%}<span class="ss-card__view" aria-hidden="true">{{ block.settings.cta_label | default: 'View' | escape }} &rarr;</span>{%- endif -%}
                  </a>
                {%- else -%}
                  <div class="ss-card__media">
                    {{ tier_img | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 33vw, 100vw', widths: '400, 600, 800', alt: block.settings.image_alt }}
                  </div>
                {%- endif -%}
              {%- endif -%}
              <div class="ss-card__body">
                {%- if block.settings.label != blank -%}<p class="ss-card__label">{{ block.settings.label | escape }}</p>{%- endif -%}
                {%- if block.settings.heading != blank -%}<h3 class="ss-card__heading">{{ block.settings.heading | escape }}</h3>{%- endif -%}
                {%- if block.settings.body != blank -%}<div class="ss-card__text">{{ block.settings.body }}</div>{%- endif -%}
                {%- if block.settings.cta_label != blank -%}<a class="ss-card__ctabtn" href="{{ block.settings.cta_url | default: '#' }}">{{ block.settings.cta_label | escape }}</a>{%- endif -%}
              </div>
            </div>

          {%- when 'procedure_card' -%}
            <a class="ss-card ss-card--procedure" href="{{ block.settings.cta_url | default: '#' }}" {{ block.shopify_attributes }} data-ss-reveal>
              <div class="ss-card__media">
                {%- render 'senseless-card-image', image: block.settings.image, collection: block.settings.collection, alt: block.settings.image_alt, sizes: '(min-width: 768px) 25vw, 50vw' -%}
                {%- if block.settings.cta_url != blank -%}<span class="ss-card__view" aria-hidden="true">{{ block.settings.cta_label | default: 'View' | escape }} &rarr;</span>{%- endif -%}
              </div>
              <div class="ss-card__body">
                {%- if block.settings.label != blank -%}<h3 class="ss-card__heading">{{ block.settings.label | escape }}</h3>{%- endif -%}
                {%- if block.settings.cta_label != blank -%}<span class="ss-card__cta">{{ block.settings.cta_label | escape }}</span>{%- endif -%}
              </div>
            </a>

          {%- when 'product_card' -%}
            {%- assign card_product = block.settings.product -%}
            {%- if card_product != blank -%}{%- assign card_href = card_product.url -%}{%- else -%}{%- assign card_href = block.settings.cta_url | default: '#' -%}{%- endif -%}
            {%- assign card_tier = '' -%}
            {%- if card_product != blank -%}{%- for t in card_product.tags -%}{%- assign tl = t | downcase -%}{%- if tl == 'clinical' or tl == 'advanced' or tl == 'professional' -%}{%- assign card_tier = tl -%}{%- endif -%}{%- endfor -%}{%- endif -%}
            <div class="ss-card ss-card--product" {{ block.shopify_attributes }} data-ss-reveal>
              <a class="ss-card__cardlink" href="{{ card_href }}">
                <div class="ss-card__media">
                  {%- render 'senseless-card-image', image: block.settings.image, product: block.settings.product, alt: block.settings.image_alt, sizes: '(min-width: 768px) 33vw, 100vw' -%}
                  {%- if card_product != blank or block.settings.cta_url != blank -%}<span class="ss-card__view" aria-hidden="true">{% if card_product != blank %}View product &rarr;{% else %}{{ block.settings.cta_label | default: 'View' | escape }} &rarr;{% endif %}</span>{%- endif -%}
                </div>
                <div class="ss-card__body">
                  {%- if block.settings.label != blank -%}<p class="ss-card__label">{{ block.settings.label | escape }}</p>{%- endif -%}
                  {%- if card_tier != blank -%}<div class="ss-card__comfort">{% render 'senseless-comfort-mark', tier: card_tier, name: false, size: 15, link: false %}</div>{%- endif -%}
                  {%- if block.settings.title != blank -%}<h3 class="ss-card__heading">{{ block.settings.title | escape }}</h3>{%- elsif card_product != blank -%}<h3 class="ss-card__heading">{{ card_product.title | escape }}</h3>{%- endif -%}
                  {%- if card_product != blank and card_product.price > 0 -%}<p class="ss-card__price">{{ card_product.price | money }}</p>{%- elsif block.settings.price != blank -%}<p class="ss-card__price">{{ block.settings.price | escape }}</p>{%- endif -%}
                  {%- if card_product == blank and block.settings.cta_label != blank -%}<span class="ss-card__cta">{{ block.settings.cta_label | escape }}</span>{%- endif -%}
                </div>
              </a>
              {%- if card_product != blank -%}<div class="ss-card__stars jdgm-widget jdgm-preview-badge" data-id="{{ card_product.id }}" data-template="senseless-card">{{ card_product.metafields.judgeme.badge }}</div>{%- endif -%}
              {%- if card_product != blank -%}{% render 'senseless-quick-add', product: card_product, section_id: section.id, uid: block.id %}{%- endif -%}
            </div>

          {%- when 'format_card' -%}
            {%- capture fmt_inner -%}
              <div class="ss-card__media">
                {%- render 'senseless-card-image', image: block.settings.image, collection: block.settings.collection, alt: block.settings.image_alt, sizes: '(min-width: 768px) 50vw, 100vw' -%}
                {%- if block.settings.cta_url != blank -%}<span class="ss-card__view" aria-hidden="true">{{ block.settings.cta_label | default: 'View' | escape }} &rarr;</span>{%- endif -%}
              </div>
              <div class="ss-card__body">
                {%- if block.settings.label != blank -%}<h3 class="ss-card__heading">{{ block.settings.label | escape }}</h3>{%- endif -%}
                {%- if block.settings.body != blank -%}<div class="ss-card__text">{{ block.settings.body }}</div>{%- endif -%}
                {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}<span class="ss-card__cta">{{ block.settings.cta_label | escape }}</span>{%- endif -%}
              </div>
            {%- endcapture -%}
            {%- if block.settings.cta_url != blank -%}
              <a class="ss-card ss-card--format" href="{{ block.settings.cta_url }}" {{ block.shopify_attributes }} data-ss-reveal>{{ fmt_inner }}</a>
            {%- else -%}
              <div class="ss-card ss-card--format ss-card--static" {{ block.shopify_attributes }} data-ss-reveal>{{ fmt_inner }}</div>
            {%- endif -%}

        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.closer != blank or section.settings.section_cta_label != blank -%}
      <div class="ss-trio__footer">
        {%- if section.settings.closer != blank -%}<p class="ss-trio__closer">{%- if section.settings.closer_url != blank -%}<a class="ss-trio__closerlink" href="{{ section.settings.closer_url }}">{{ section.settings.closer | escape }}</a>{%- else -%}{{ section.settings.closer | escape }}{%- endif -%}</p>{%- endif -%}
        {%- if section.settings.section_cta_label != blank -%}<a class="ss-trio__sectioncta" href="{{ section.settings.section_cta_url | default: '#' }}">{{ section.settings.section_cta_label | escape }}</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Card row",
  "tag": "section",
  "class": "senseless-section senseless-trio-card-row",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "columns", "label": "Cards per row (desktop)", "default": "3", "options": [ { "value": "2", "label": "2 (dual)" }, { "value": "3", "label": "3 (trio)" }, { "value": "4", "label": "4 (quad)" } ] },
    { "type": "select", "id": "media_ratio", "label": "Card image ratio", "default": "1 / 1", "info": "Set to match the card images so they aren't centre-cropped.", "options": [ { "value": "1 / 1", "label": "Square (1:1)" }, { "value": "5 / 4", "label": "Landscape (5:4)" }, { "value": "4 / 3", "label": "Landscape (4:3)" }, { "value": "3 / 2", "label": "Landscape (3:2)" }, { "value": "16 / 9", "label": "Wide (16:9)" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Optional. Leave blank to hide." },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "richtext", "id": "body", "label": "Intro body" },
    { "type": "text", "id": "closer", "label": "Closer line", "info": "Optional short closing line under the cards." },
    { "type": "url", "id": "closer_url", "label": "Closer link (optional)" },
    { "type": "text", "id": "section_cta_label", "label": "Section CTA label" },
    { "type": "url", "id": "section_cta_url", "label": "Section CTA link" }
  ],
  "blocks": [
    {
      "type": "tier_card",
      "name": "Tier card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Linked collection", "info": "Empty-safe: the card image is pulled from this collection's image. If unset (and no override below), the card stays a clean text card — no placeholder." },
        { "type": "product", "id": "product", "label": "Linked product (unused for tier cards)" },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless product on a warm off-white background" },
        { "type": "text", "id": "label", "label": "Label (eyebrow)", "default": "Clinical Strength" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "For routine appointments" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Short description of this tier and the appointments it suits.</p>" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop" },
        { "type": "url", "id": "cta_url", "label": "CTA link" },
        { "type": "checkbox", "id": "flagship", "label": "Flagship treatment (retired — no visual effect)", "default": false }
      ]
    },
    {
      "type": "procedure_card",
      "name": "Procedure card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Linked collection", "info": "Card image is pulled from this collection's image (or its first product) unless an image is set below." },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Editorial product image for this procedure type" },
        { "type": "text", "id": "label", "label": "Procedure name", "default": "Lip Fillers" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View range" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    },
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product", "info": "Card image is pulled from this product's featured image unless an image is set below." },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless product on a warm off-white background" },
        { "type": "text", "id": "label", "label": "Label (eyebrow)", "default": "Clinical Strength" },
        { "type": "text", "id": "title", "label": "Title", "default": "Product name" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View product" },
        { "type": "url", "id": "cta_url", "label": "CTA link" },
        { "type": "checkbox", "id": "flagship", "label": "Flagship treatment (retired — no visual effect)", "default": false }
      ]
    },
    {
      "type": "format_card",
      "name": "Format card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Linked collection", "info": "Card image is pulled from this collection's image (or its first product) unless an image is set below." },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless format on a warm off-white background" },
        { "type": "text", "id": "label", "label": "Format name", "default": "Numbing Gel" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Short description of this format.</p>" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View range" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Senseless — Card row",
      "settings": { "columns": "3" },
      "blocks": [ { "type": "tier_card" }, { "type": "tier_card" }, { "type": "tier_card" } ]
    }
  ]
}
{% endschema %}
