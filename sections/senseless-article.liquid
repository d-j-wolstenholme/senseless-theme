{%- comment -%}
  Senseless — Guide article. Custom blog-article layout (Education cluster / Guides blog).
  Answer-first opener + Key Facts callout (the lead blockquote in the body) + body + FAQ accordion
  (from the article's custom.faq metafield) + funnel CTAs (in the body). Emits Article +
  BreadcrumbList + FAQPage JSON-LD (Horizon's main-blog-post isn't used by this template).
{%- endcomment -%}
{%- liquid
  assign base = shop.url
  assign desc = article.metafields.global.description_tag.value | default: article.excerpt | strip_html | default: article.title
  assign faq = article.metafields.custom.faq.value

  assign page_url = canonical_url | default: base
  assign webpage_id = page_url | append: '#webpage'
  assign org_id = base | append: '/#organization'

  comment
    The visible line said "Last updated" and printed the PUBLISH date — on every guide those are
    different dates (published 4 Jun, last edited 26 Jun). `updated_at` is not documented on the
    Liquid article object; where it resolves it is used, and where it does not `default` falls
    back to the publish date, so the date shown is always a real Shopify date either way.
  endcomment
  assign art_published = article.published_at | date: '%Y-%m-%d'
  assign art_modified_raw = article.updated_at | default: article.published_at
  assign art_modified = art_modified_raw | date: '%Y-%m-%d'

  comment
    Author. Shopify's article.author is "Senseless" on every guide — a company, not a person, so
    it is emitted as the Organization it actually is rather than dressed up as a Person. Set
    author_name in the section to attribute a guide to a named individual; author_role adds their
    standing. Do not fill these in with a name that has not agreed to carry the byline: on a
    regulated cosmetic site an author credit is a claim about who stands behind the copy.
  endcomment
  assign author_name = section.settings.author_name | strip
  assign author_is_person = false
  if author_name != blank
    assign author_is_person = true
  endif
-%}
{%- style -%}
  .ss-art { --p:#6B3FA0; --bg:#f7f7f5; --surf:#ffffff; --ink:#1A1816; --body:#2B2730; --sec:#5C5853; --bd:#E5E2DC;
    --sans:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink); font-family:var(--sans); }
  .ss-art__head { max-width:740px; margin:0 auto; padding:56px 20px 18px; }
  .ss-art__eyebrow { font-weight:600; font-size:0.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--p); margin:0 0 12px; }
  .ss-art__eyebrow a { color:inherit; text-decoration:none; }
  .ss-art__title { font-weight:400; letter-spacing:-0.02em; font-size:clamp(2.5rem, 1.5rem + 4vw, 4rem); line-height:1.06; margin:0; }
  .ss-art__meta { font-size:13px; color:var(--sec); margin:14px 0 0; }
  .ss-art__body { max-width:740px; margin:0 auto; padding:8px 20px 40px; font-size:17px; line-height:1.7; color:var(--body); }
  .ss-art__body h2 { font-family:var(--sans); font-weight:600; font-size:clamp(1.25rem, 1.18rem + 0.3vw, 1.375rem); line-height:1.25; letter-spacing:-0.01em; color:var(--ink); margin:36px 0 12px; }
  .ss-art__body h3 { font-weight:600; font-size:18px; line-height:1.25; letter-spacing:-0.01em; color:var(--ink); margin:26px 0 8px; }
  .ss-art__body p { margin:0 0 16px; }
  .ss-art__body ul, .ss-art__body ol { margin:0 0 16px; padding-left:22px; }
  .ss-art__body li { margin:0 0 8px; }
  .ss-art__body a { color:var(--p); }
  .ss-art__body strong { color:var(--ink); }
  /* Lead blockquote = Key Facts callout */
  .ss-art__body blockquote { margin:0 0 22px; padding:18px 20px; background:var(--surf); border:1px solid var(--bd); border-left:3px solid var(--p); border-radius:4px; font-size:17px; color:var(--ink); }
  .ss-art__body blockquote p { margin:0 0 8px; } .ss-art__body blockquote p:last-child { margin:0; }
  /* FAQ */
  .ss-art__faq { background:var(--surf); border-top:1px solid var(--bd); }
  .ss-art__faq-inner { max-width:740px; margin:0 auto; padding:40px 20px; }
  .ss-art__faq-head { font-weight:400; letter-spacing:-0.02em; font-size:clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height:1.1; margin:0 0 18px; }
  @media (max-width:749px){ .ss-art__faq-head { line-height:1.12; } }
  .ss-art__item { border-bottom:1px solid var(--bd); }
  .ss-art__item:first-of-type { border-top:1px solid var(--bd); }
  .ss-art__q { font-weight:500; font-size:clamp(1.0625rem, 1.01rem + 0.25vw, 1.125rem); line-height:1.35; letter-spacing:-0.005em; color:var(--ink); cursor:pointer; list-style:none; padding:18px 36px 18px 0; position:relative; }
  .ss-art__q::-webkit-details-marker { display:none; }
  /* Real <h3> inside the <summary> (valid HTML — summary permits heading content) so the question
     lands in the document outline; these rules neutralise its box and typography. */
  .ss-art__qh { display:inline; margin:0; font:inherit; letter-spacing:inherit; color:inherit; }
  .ss-art__q::after { content:'+'; position:absolute; right:4px; top:50%; transform:translateY(-50%); font-size:19px; font-weight:400; color:var(--p); line-height:1; transition:transform 200ms ease-out; }
  .ss-art__item[open] .ss-art__q::after { content:'\2212'; }
  .ss-art__a { font-size:16px; line-height:1.6; color:var(--body); padding:0 0 18px; }
  .ss-art__a p { margin:0 0 .6em; } .ss-art__a p:last-child { margin:0; } .ss-art__a a { color:var(--p); }
  .ss-art__foot { max-width:740px; margin:0 auto; padding:28px 20px 56px; }
  .ss-art__back { color:var(--p); text-decoration:none; font-weight:600; font-size:15px; }
  .ss-art__back:hover { text-decoration:underline; }
  .ss-art__related { max-width:760px; margin:40px auto 0; padding:0 20px; }
  .ss-art__related-head { font-weight:600; font-size:0.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--p); margin:0 0 14px; }
  .ss-art__related-list { list-style:none; margin:0; padding:0; display:grid; gap:10px; }
  .ss-art__related-list a { color:var(--body); text-decoration:none; font-weight:600; font-size:17px; line-height:1.35; border-bottom:1px solid var(--bd); display:block; padding:0 0 10px; }
  .ss-art__related-list a:hover { color:var(--p); }
  @media (max-width:749px){ .ss-art__title { line-height:1.08; } }
  @media (prefers-reduced-motion: reduce){ .ss-art__q::after { transition:none; } }
{%- endstyle -%}
<article class="ss-art">
  <header class="ss-art__head">
    <p class="ss-art__eyebrow"><a href="{{ blog.url }}">&larr; All {{ section.settings.eyebrow | default: 'guides' | escape | downcase }}</a></p>
    <h1 class="ss-art__title">{{ article.title | escape }}</h1>
    {%- if article.published_at -%}
      <p class="ss-art__meta">
        {%- if author_is_person -%}
          By {{ author_name | escape }}{% if section.settings.author_role != blank %}, {{ section.settings.author_role | escape }}{% endif %} &middot;
        {%- endif -%}
        Published <time datetime="{{ art_published }}">{{ article.published_at | date: '%-d %B %Y' }}</time>
        {%- unless art_modified == art_published %} &middot; last updated <time datetime="{{ art_modified }}">{{ art_modified_raw | date: '%-d %B %Y' }}</time>{%- endunless -%}
      </p>
    {%- endif -%}
  </header>

  <div class="ss-art__body rte">{{ article.content }}</div>

  {%- if faq != blank and faq.size > 0 -%}
    <section class="ss-art__faq" id="faq" aria-label="Common questions">
      <div class="ss-art__faq-inner">
        <h2 class="ss-art__faq-head">Common questions</h2>
        {%- for item in faq -%}
          <details class="ss-art__item"{% if forloop.first %} open{% endif %}>
            <summary class="ss-art__q"><h3 class="ss-art__qh">{{ item.question | escape }}</h3></summary>
            <div class="ss-art__a">{{ item.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}
    Reciprocal internal links. Guides were previously reachable only from /pages/articles, leaving two of
    them on a single indexable inbound link. The window is offset from this article's own position and
    wraps, so every article both gives and receives the same number of links instead of all of them
    pointing at the same first three. Anchor text is the article title verbatim — no new claim surface.
  {%- endcomment -%}
  {%- liquid
    assign total = blog.articles.size
    assign here = 0
    for art in blog.articles
      if art.id == article.id
        assign here = forloop.index0
        break
      endif
    endfor
    assign want = 3
    assign max_want = total | minus: 1
    if max_want < want
      assign want = max_want
    endif
  -%}
  {%- if want > 0 -%}
    <nav class="ss-art__related" aria-label="More guides">
      <h2 class="ss-art__related-head">More guides</h2>
      <ul class="ss-art__related-list">
        {%- for i in (1..want) -%}
          {%- assign j = here | plus: i | modulo: total -%}
          {%- assign rel = blog.articles[j] -%}
          <li><a href="{{ rel.url }}">{{ rel.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  <div class="ss-art__foot"><a class="ss-art__back" href="{{ blog.url }}">← All guides</a></div>
</article>

{%- comment -%}
  Both nodes below join the sitewide @graph by @id rather than restating it: the Article is the
  mainEntity of the #webpage node that snippets/senseless-structured-data.liquid already emits,
  the breadcrumb takes the #breadcrumb address that node points at, and the publisher is a
  reference to #organization instead of a fourth copy of the company details.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": {{ page_url | append: '#article' | json }},
  "headline": {{ article.title | json }},
  "description": {{ desc | json }},
  "url": {{ base | append: article.url | json }},
  "mainEntityOfPage": { "@id": {{ webpage_id | json }} },
  "isPartOf": { "@id": {{ webpage_id | json }} },
  {%- if article.image -%}"image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],{%- endif -%}
  "datePublished": {{ art_published | json }},
  "dateModified": {{ art_modified | json }},
  "inLanguage": "en-GB",
  {%- if author_is_person -%}
  "author": {
    "@type": "Person",
    "name": {{ author_name | json }}{% if section.settings.author_role != blank %},
    "jobTitle": {{ section.settings.author_role | json }}{% endif %},
    "worksFor": { "@id": {{ org_id | json }} }
  },
  {%- else -%}
  "author": { "@id": {{ org_id | json }} },
  {%- endif -%}
  "publisher": { "@id": {{ org_id | json }} }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "@id": {{ page_url | append: '#breadcrumb' | json }},
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ base | json }} },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": {{ base | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ base | append: article.url | json }} }
  ]
}
</script>
{%- if faq != blank and faq.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq -%}
    {
      "@type": "Question",
      "name": {{ item.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | strip_html | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Guide article",
  "tag": "section",
  "class": "senseless-section senseless-article",
  "settings": [
    { "type": "paragraph", "content": "Renders the article body (article.content) + a FAQ accordion from the article's custom.faq metafield, and emits Article + BreadcrumbList + FAQPage schema, @id-linked into the sitewide entity graph." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Guides" },
    { "type": "header", "content": "Byline" },
    { "type": "paragraph", "content": "Leave empty to credit Senseless as the publishing organisation (the current, accurate default). Only enter a name where that person has agreed to carry the byline — on a regulated cosmetic site an author credit is a claim about who stands behind the copy." },
    { "type": "text", "id": "author_name", "label": "Author name (optional)" },
    { "type": "text", "id": "author_role", "label": "Author role (optional)", "info": "e.g. Cosmetic safety assessor. Shown after the name and emitted as jobTitle." }
  ],
  "presets": [ { "name": "Guide article" } ]
}
{% endschema %}
