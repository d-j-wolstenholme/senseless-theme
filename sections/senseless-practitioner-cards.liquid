{%- comment -%}
  Senseless — Practitioner cards (DEMO PLACEHOLDER, removable in one step)
  3-up responsive grid of practitioner trust cards. Monogram circles (no photos). Placeholder
  names / clinics / bracketed quotes only — NO real or adapted practitioner content, NO efficacy
  or anaesthetic language. The muted caption keeps the demo honest: real verified practitioner
  content is pending collection. Remove by deleting this file + its key in templates/index.json.
{%- endcomment -%}

{%- style -%}
  .ss-pc {
    --ss-purple: #6B3FA0;
    --ss-canvas: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-ink: #1A1816;
    --ss-body: #2B2730;
    --ss-muted: #8E8A82;
    --ss-border: #E5E2DC;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-canvas);
    font-family: var(--ss-sans);
  }
  .ss-pc__inner { max-width: 1100px; margin: 0 auto; padding: 64px 20px; }
  .ss-pc__head { text-align: center; margin-bottom: 36px; }
  .ss-pc__title { font-family: var(--ss-sans); font-weight: 600; font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2rem); line-height: 1.12; letter-spacing: -0.01em; color: var(--ss-ink); margin: 0; }
  .ss-pc__caption { font-family: var(--ss-sans); font-weight: 400; font-size: 13px; line-height: 1.4; color: var(--ss-muted); margin: 8px 0 0; }

  .ss-pc__grid { display: grid; grid-template-columns: 1fr; gap: 20px; align-items: stretch; }
  .ss-pc__card {
    display: flex; flex-direction: column; gap: 12px; height: 100%;
    background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px;
    padding: 24px;
  }
  .ss-pc__mono {
    flex: 0 0 auto; width: 48px; height: 48px; border-radius: 50%;
    background: rgba(107, 63, 160, 0.12); color: var(--ss-purple);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--ss-sans); font-weight: 600; font-size: 16px; letter-spacing: 0.02em;
  }
  .ss-pc__name { font-family: var(--ss-sans); font-weight: 600; font-size: 15px; line-height: 1.3; color: var(--ss-ink); margin: 0; }
  .ss-pc__clinic { font-family: var(--ss-sans); font-weight: 400; font-size: 13px; line-height: 1.4; color: var(--ss-muted); margin: 2px 0 0; }
  .ss-pc__quote { font-family: var(--ss-sans); font-style: italic; font-weight: 400; font-size: 14px; line-height: 1.55; color: var(--ss-body); margin: 4px 0 0; }

  @media (min-width: 750px) {
    .ss-pc__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
  }
{%- endstyle -%}

<section class="ss-pc" aria-label="{{ section.settings.heading | escape }}">
  <div class="ss-pc__inner">
    <div class="ss-pc__head">
      <h2 class="ss-pc__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.caption != blank -%}
        <p class="ss-pc__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
    <div class="ss-pc__grid" role="list">
      {%- for block in section.blocks -%}
        <article class="ss-pc__card" role="listitem" {{ block.shopify_attributes }}>
          <span class="ss-pc__mono" aria-hidden="true">{{ block.settings.monogram | escape }}</span>
          <div>
            <p class="ss-pc__name">{{ block.settings.name | escape }}</p>
            <p class="ss-pc__clinic">{{ block.settings.clinic | escape }}</p>
          </div>
          <p class="ss-pc__quote">{{ block.settings.quote | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Practitioner",
  "tag": "section",
  "class": "senseless-section senseless-practitioner-cards",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by UK practitioners" },
    { "type": "text", "id": "caption", "label": "Caption (muted)" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Practitioner card",
      "settings": [
        { "type": "text", "id": "monogram", "label": "Monogram", "default": "PN" },
        { "type": "text", "id": "name", "label": "Name (placeholder)", "default": "Practitioner name" },
        { "type": "text", "id": "clinic", "label": "Clinic · City (placeholder)", "default": "Aesthetic clinic · City" },
        { "type": "textarea", "id": "quote", "label": "Quote (placeholder — no claims)", "default": "[Practitioner testimonial — pending collection. One short line.]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Senseless — Practitioner",
      "blocks": [
        { "type": "card", "settings": { "monogram": "PN", "name": "Practitioner name", "clinic": "Aesthetic clinic · City", "quote": "[Practitioner testimonial — pending collection. One short line.]" } },
        { "type": "card", "settings": { "monogram": "PN", "name": "Practitioner name", "clinic": "Aesthetic clinic · City", "quote": "[Practitioner testimonial — pending collection. Two lines so spacing and rhythm can be judged.]" } },
        { "type": "card", "settings": { "monogram": "PN", "name": "Practitioner name", "clinic": "Aesthetic clinic · City", "quote": "[Practitioner testimonial — pending collection. Three lines to show how the tallest card sets row height and the grid equalises.]" } }
      ]
    }
  ]
}
{% endschema %}
