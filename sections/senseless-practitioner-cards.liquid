{%- comment -%}
  Senseless — Practitioner cards (removable in one step)
  Quote-led testimonial cards with brand character: purple→violet top accent (echoes the asterisk
  mark), eyebrow, decorative quote glyph, solid brand monogram, attribution pinned to the card
  foot so the equal-height 3-up grid reads cleanly. No photos. Quotes render verbatim (escaped).
  Remove by deleting this file + its key in templates/index.json.
{%- endcomment -%}

{%- style -%}
  .ss-pc {
    --ss-purple: #6B3FA0;
    --ss-violet: #984AE8;
    --ss-canvas: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-ink: #1A1816;
    --ss-body: #2B2730;
    --ss-muted: #8E8A82;
    --ss-border: #E5E2DC;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-canvas);
    font-family: var(--ss-sans);
  }
  .ss-pc__inner { max-width: 1140px; margin: 0 auto; padding: 72px 20px; }
  .ss-pc__head { text-align: center; margin-bottom: 44px; }
  .ss-pc__eyebrow { font-family: var(--ss-sans); font-weight: 600; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ss-purple); margin: 0 0 10px; }
  .ss-pc__title { font-family: var(--ss-sans); font-weight: 600; font-size: clamp(1.6rem, 1.15rem + 1.6vw, 2.15rem); line-height: 1.1; letter-spacing: -0.015em; color: var(--ss-ink); margin: 0; }
  .ss-pc__caption { font-family: var(--ss-sans); font-weight: 400; font-size: 13px; line-height: 1.4; color: var(--ss-muted); margin: 10px 0 0; }

  .ss-pc__grid { display: grid; grid-template-columns: 1fr; gap: 22px; align-items: stretch; }

  .ss-pc__card {
    position: relative; display: flex; flex-direction: column; height: 100%; overflow: hidden;
    background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px;
    padding: 32px 28px 26px;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .ss-pc__card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--ss-purple), var(--ss-violet));
  }
  .ss-pc__card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(107, 63, 160, 0.10); border-color: rgba(107, 63, 160, 0.28); }

  .ss-pc__qmark { font-family: var(--ss-sans); font-weight: 700; font-size: 54px; line-height: 0.6; color: var(--ss-purple); opacity: 0.16; height: 24px; margin-bottom: 6px; }
  .ss-pc__quote { font-family: var(--ss-sans); font-style: italic; font-weight: 400; font-size: 15px; line-height: 1.62; color: var(--ss-body); margin: 0 0 24px; }

  .ss-pc__attr { display: flex; align-items: center; gap: 13px; margin-top: auto; padding-top: 18px; border-top: 1px solid #EFECE7; }
  .ss-pc__mono {
    flex: 0 0 auto; width: 46px; height: 46px; border-radius: 50%;
    background: var(--ss-purple); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--ss-sans); font-weight: 600; font-size: 15px; letter-spacing: 0.02em;
    box-shadow: 0 3px 10px rgba(107, 63, 160, 0.28);
  }
  .ss-pc__name { font-family: var(--ss-sans); font-weight: 600; font-size: 14.5px; line-height: 1.25; color: var(--ss-ink); margin: 0; }
  .ss-pc__loc { font-family: var(--ss-sans); font-weight: 400; font-size: 12.5px; line-height: 1.3; color: var(--ss-muted); margin: 2px 0 0; }

  @media (prefers-reduced-motion: reduce) { .ss-pc__card { transition: none; } .ss-pc__card:hover { transform: none; } }
  @media (min-width: 750px) {
    .ss-pc__grid { grid-template-columns: repeat(3, 1fr); gap: 26px; }
  }
{%- endstyle -%}

<section class="ss-pc" aria-label="{{ section.settings.heading | escape }}">
  <div class="ss-pc__inner">
    <div class="ss-pc__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ss-pc__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="ss-pc__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.caption != blank -%}
        <p class="ss-pc__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
    <div class="ss-pc__grid" role="list">
      {%- for block in section.blocks -%}
        <article class="ss-pc__card" role="listitem" {{ block.shopify_attributes }}>
          <span class="ss-pc__qmark" aria-hidden="true">&ldquo;</span>
          <p class="ss-pc__quote">{{ block.settings.quote | escape }}</p>
          <footer class="ss-pc__attr">
            <span class="ss-pc__mono" aria-hidden="true">{{ block.settings.monogram | escape }}</span>
            <span>
              <span class="ss-pc__name">{{ block.settings.name | escape }}</span>
              <span class="ss-pc__loc">{{ block.settings.clinic | escape }}</span>
            </span>
          </footer>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Practitioner",
  "tag": "section",
  "class": "senseless-section senseless-practitioner-cards",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Practitioner voices" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by UK practitioners" },
    { "type": "text", "id": "caption", "label": "Caption (muted)" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Practitioner card",
      "settings": [
        { "type": "text", "id": "monogram", "label": "Monogram", "default": "PN" },
        { "type": "text", "id": "name", "label": "Name", "default": "Practitioner name" },
        { "type": "text", "id": "clinic", "label": "Location", "default": "City" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "[Practitioner testimonial — pending collection.]" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Senseless — Practitioner",
      "blocks": [
        { "type": "card", "settings": { "monogram": "PN", "name": "Practitioner name", "clinic": "City", "quote": "[Practitioner testimonial — pending collection. One short line.]" } },
        { "type": "card", "settings": { "monogram": "PN", "name": "Practitioner name", "clinic": "City", "quote": "[Practitioner testimonial — pending collection. Two lines so spacing and rhythm can be judged.]" } },
        { "type": "card", "settings": { "monogram": "PN", "name": "Practitioner name", "clinic": "City", "quote": "[Practitioner testimonial — pending collection. Three lines to show how the tallest card sets row height and the grid equalises.]" } }
      ]
    }
  ]
}
{% endschema %}
