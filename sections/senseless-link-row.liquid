{%- comment -%}
  Senseless — Link row (compact "What [format] is for" suitability list).
  A LIGHT list/row module (not a card grid): procedure name + one-line why + optional link.
  Name links only when a URL is set; otherwise it's descriptive (no link). Strength is NOT
  repeated here — the Scale owns strength; this row owns procedure-fit. Injectable-clean by data.
{%- endcomment -%}

{%- liquid
  assign band = section.settings.band | default: 'surface'
-%}

{%- style -%}
  .ss-lr { --p:#6B3FA0; --ph:#5A3489; --bg:#f7f7f5; --surf:#ffffff; --ink:#1A1816; --body:#2B2730; --sec:#5C5853; --bd:#E5E2DC;
    --sans:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; color:var(--ink); }
  .ss-lr--canvas { background:var(--bg); }
  .ss-lr--surface { background:var(--surf); }
  .ss-lr__inner { max-width:860px; margin:0 auto; padding-block:48px; padding-inline:20px; }
  @media (max-width:989px){ .ss-lr__inner { padding-block:32px; } }
  @media (max-width:749px){ .ss-lr__inner { padding-block:28px; } }
  .ss-lr__head { max-width:62ch; margin:0 0 18px; display:flex; flex-direction:column; gap:10px; }
  .ss-lr__eyebrow { font-family:var(--sans); font-weight:600; font-size:0.75rem; letter-spacing:.2em; text-transform:uppercase; color:var(--p); margin:0; }
  .ss-lr__headline { font-family:var(--sans); font-weight: 400; letter-spacing: -0.02em; font-size:clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height:1.1; margin:0; }
  @media (max-width:749px){ .ss-lr__headline { line-height:1.12; } }
  .ss-lr__intro { font-family:var(--sans); font-size:15.5px; line-height:1.55; color:var(--body); }
  .ss-lr__intro p { margin:0; }
  .ss-lr__list { list-style:none; margin:14px 0 0; padding:0; border-top:1px solid var(--bd); }
  .ss-lr__item { display:flex; flex-wrap:wrap; gap:4px 14px; align-items:baseline; padding:14px 0; border-bottom:1px solid var(--bd); }
  /* Mobile (2026-06-07): names sit in a plain bordered list, so semibold purple reads as a stack of
     small section titles rather than links. Medium on mobile; desktop restores 600 (min-width:700). */
  .ss-lr__name { font-family:var(--sans); font-weight:500; font-size:15px; color:var(--ink); flex:0 0 auto; text-decoration:none; }
  .ss-lr__name--tag { display:inline-flex; align-items:center; background:rgba(107,63,160,.08); color:var(--p); border:1px solid rgba(107,63,160,.25); border-radius:999px; padding:3px 12px; font-size:13px; }
  a.ss-lr__name { color:var(--p); }
  a.ss-lr__name:hover { text-decoration:underline; }
  a.ss-lr__name::after { content:' \2192'; }
  .ss-lr__note { font-family:var(--sans); font-size:14.5px; line-height:1.5; color:var(--sec); flex:1 1 280px; }
  .ss-lr__closer { font-family:var(--sans); font-size:14.5px; line-height:1.6; color:var(--sec); margin:18px 0 0; }
  .ss-lr__closer p { margin:0; }
  @media (min-width:700px) { .ss-lr__name { flex:0 0 220px; font-weight:600; } }
{%- endstyle -%}

<section class="ss-lr ss-lr--{{ band }}" aria-label="{{ section.settings.headline | default: 'Suited to' | escape }}">
  <div class="ss-lr__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.intro != blank -%}
      <header class="ss-lr__head">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-lr__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-lr__headline">{% render 'senseless-accent', text: section.settings.headline, word: section.settings.accent_word %}</h2>{%- endif -%}
        {%- if section.settings.intro != blank -%}<div class="ss-lr__intro">{{ section.settings.intro }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <ul class="ss-lr__list">
      {%- for block in section.blocks -%}
        <li class="ss-lr__item" {{ block.shopify_attributes }}>
          {%- if block.settings.url != blank -%}
            <a class="ss-lr__name" href="{{ block.settings.url }}">{{ block.settings.label | escape }}</a>
          {%- else -%}
            <span class="ss-lr__name{% if block.settings.as_tag %} ss-lr__name--tag{% endif %}">{{ block.settings.label | escape }}</span>
          {%- endif -%}
          {%- if block.settings.note != blank -%}<span class="ss-lr__note">{{ block.settings.note | escape }}</span>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.closer != blank -%}<div class="ss-lr__closer">{{ section.settings.closer }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Link row",
  "tag": "section",
  "class": "senseless-section senseless-link-row",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "band", "label": "Band background", "default": "surface", "options": [ { "value": "canvas", "label": "Canvas (off-white)" }, { "value": "surface", "label": "Surface (white)" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "text", "id": "accent_word", "label": "Italic accent word (one word, optional)" },
    { "type": "richtext", "id": "intro", "label": "Intro line" },
    { "type": "richtext", "id": "closer", "label": "Closing line" }
  ],
  "blocks": [
    {
      "type": "link_item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "label", "label": "Name" },
        { "type": "text", "id": "note", "label": "One-line why" },
        { "type": "url", "id": "url", "label": "Link (optional — leave blank for descriptive only)" },
        { "type": "checkbox", "id": "as_tag", "label": "Render name as a tag/pill", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Senseless — Link row", "blocks": [ { "type": "link_item" }, { "type": "link_item" }, { "type": "link_item" } ] } ]
}
{% endschema %}
