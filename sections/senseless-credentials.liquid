{%- comment -%}
  Senseless — credentials band (section wrapper).
  Thin host so the single-source senseless-credentials snippet can be placed on JSON templates
  (trade, about, /collections/professional). Factual only — no efficacy. NEW SECTION TYPE.
{%- endcomment -%}
{%- liquid
  assign band = section.settings.band | default: 'canvas'
-%}
{%- style -%}
  .ss-credband { --bg:#f7f7f5; --surf:#ffffff; }
  .ss-credband--canvas { background:var(--bg); }
  .ss-credband--surface { background:var(--surf); }
  .ss-credband__inner { max-width:720px; margin:0 auto; padding-block:28px; padding-inline:20px; }
{%- endstyle -%}
<section class="ss-credband ss-credband--{{ band }}" aria-label="Senseless credentials">
  <div class="ss-credband__inner">
    {%- render 'senseless-credentials', align: section.settings.align, muted: true -%}
  </div>
</section>
{% schema %}
{
  "name": "Senseless — Credentials",
  "tag": "section",
  "class": "senseless-section senseless-credentials",
  "settings": [
    { "type": "select", "id": "band", "label": "Band background", "default": "canvas", "options": [ { "value": "canvas", "label": "Canvas" }, { "value": "surface", "label": "Surface" } ] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ] }
  ],
  "presets": [ { "name": "Senseless — Credentials" } ]
}
{% endschema %}
