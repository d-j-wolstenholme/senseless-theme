{%- comment -%}
  Senseless — Page schema. Emits a WebPage-family JSON-LD node for a content page (no visible output).
  schema_type selects the @type: WebPage (default) / AboutPage / ContactPage (WebPage subtypes — same
  fields) or Service (trade/wholesale — adds provider + serviceType + areaServed).
  BreadcrumbList is already emitted by Horizon on page templates, so we don't duplicate it.
{%- endcomment -%}
{%- liquid
  assign page_name = section.settings.name | default: page.title
  assign desc = section.settings.description
  assign stype = section.settings.schema_type | default: 'WebPage'
-%}
{%- if stype == 'Service' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": {{ page_name | json }},
  "serviceType": {{ section.settings.service_type | default: 'Wholesale supply' | json }},
  "url": {{ canonical_url | json }}{% if desc != blank %},
  "description": {{ desc | strip_html | json }}{% endif %},
  "areaServed": "GB",
  "provider": {
    "@type": "Organization",
    "name": "Senseless",
    "legalName": "Matrix Health Group Ltd"
  }
}
</script>
{%- else -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": {{ stype | json }},
  "name": {{ page_name | json }},
  "url": {{ canonical_url | json }}{% if desc != blank %},
  "description": {{ desc | strip_html | json }}{% endif %},
  "isPartOf": { "@type": "WebSite", "name": {{ shop.name | json }}, "url": {{ shop.url | json }} }
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Senseless — Page schema",
  "tag": "section",
  "class": "senseless-section senseless-page-schema",
  "settings": [
    { "type": "paragraph", "content": "Emits a WebPage-family JSON-LD node (Horizon already provides BreadcrumbList). No visible output. Name defaults to the page title." },
    { "type": "select", "id": "schema_type", "label": "Schema type", "default": "WebPage", "options": [ { "value": "WebPage", "label": "WebPage" }, { "value": "AboutPage", "label": "AboutPage" }, { "value": "ContactPage", "label": "ContactPage" }, { "value": "Service", "label": "Service (trade)" } ] },
    { "type": "text", "id": "service_type", "label": "Service type (Service only)", "default": "Wholesale supply" },
    { "type": "text", "id": "name", "label": "Name override (optional)" },
    { "type": "text", "id": "description", "label": "Description (optional)" }
  ],
  "presets": [ { "name": "Senseless — Page schema" } ]
}
{% endschema %}
