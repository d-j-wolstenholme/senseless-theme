{%- comment -%}
  Senseless — Page schema. Specialises the sitewide #webpage node (no visible output).

  snippets/senseless-structured-data.liquid emits a WebPage node for EVERY page at
  {canonical_url}#webpage, with the page's SEO title and meta description as its name and
  description. This section adds a narrower @type to that SAME node by re-declaring its @id, and
  nothing else: on /pages/about the node reads ["WebPage","AboutPage"].

  Type only, never name or description. JSON-LD merges two statements about one @id as a UNION,
  not an override, so until 23 Sep 2026 this re-declaration left 13 pages (12 in the sitemap, plus
  /pages/contact) with ONE node carrying
  TWO names and TWO descriptions (e.g. /pages/faq: the SEO title and "Numbing cream FAQ"), and
  Google picks between them. It also used to re-declare plain WebPage wherever a description was
  set, which added nothing but the second name; WebPage now emits nothing.

  schema_type: WebPage (default — emits nothing, the sitewide node already covers it) /
  AboutPage / ContactPage (WebPage subtypes — @id + @type only) / Service (trade/wholesale — a
  genuinely different entity, so it stays a separate node with its own @id, name and description,
  and is linked from the page). The Name and Description settings are read by Service only; on
  the other types they are dormant, which is why their labels say so.
{%- endcomment -%}
{%- liquid
  assign page_name = section.settings.name | default: page.title
  assign desc = section.settings.description
  assign stype = section.settings.schema_type | default: 'WebPage'
  assign page_url = canonical_url | default: shop.url
  assign webpage_id = page_url | append: '#webpage'
  assign org_id = shop.url | append: '/#organization'
-%}
{%- if stype == 'Service' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": {{ page_url | append: '#service' | json }},
  "name": {{ page_name | json }},
  "serviceType": {{ section.settings.service_type | default: 'Wholesale supply' | json }},
  "url": {{ page_url | json }}{% if desc != blank %},
  "description": {{ desc | strip_html | json }}{% endif %},
  "areaServed": "GB",
  "mainEntityOfPage": { "@id": {{ webpage_id | json }} },
  "provider": { "@id": {{ org_id | json }} }
}
</script>
{%- elsif stype != 'WebPage' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["WebPage", {{ stype | json }}],
  "@id": {{ webpage_id | json }}
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Senseless — Page schema",
  "tag": "section",
  "class": "senseless-section senseless-page-schema",
  "settings": [
    { "type": "paragraph", "content": "Adds a narrower type (AboutPage / ContactPage) to the sitewide WebPage node, which takes its name and description from the page's SEO title and meta description. No visible output. Service is a separate node and is the only type that uses the name and description below." },
    { "type": "select", "id": "schema_type", "label": "Schema type", "default": "WebPage", "options": [ { "value": "WebPage", "label": "WebPage" }, { "value": "AboutPage", "label": "AboutPage" }, { "value": "ContactPage", "label": "ContactPage" }, { "value": "Service", "label": "Service (trade)" } ] },
    { "type": "text", "id": "service_type", "label": "Service type (Service only)", "default": "Wholesale supply" },
    { "type": "text", "id": "name", "label": "Name override (Service only)" },
    { "type": "text", "id": "description", "label": "Description (Service only)" }
  ],
  "presets": [ { "name": "Senseless — Page schema" } ]
}
{% endschema %}
