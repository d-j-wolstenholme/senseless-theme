{%- comment -%}
  Senseless — Page schema. Specialises the sitewide #webpage node (no visible output).

  snippets/senseless-structured-data.liquid now emits a WebPage node for EVERY page at
  {canonical_url}#webpage. This section no longer emits a second, unrelated WebPage — it
  re-declares the SAME @id with a narrower @type and the curated description, which is how
  JSON-LD merges two statements about one entity. The result on /pages/about is one node typed
  ["WebPage","AboutPage"], not two nodes competing to describe the page.

  schema_type: WebPage (default — emits nothing, the sitewide node already covers it) /
  AboutPage / ContactPage (WebPage subtypes) / Service (trade/wholesale — a genuinely different
  entity, so it stays a separate node with its own @id and is linked from the page).
{%- endcomment -%}
{%- liquid
  assign page_name = section.settings.name | default: page.title
  assign desc = section.settings.description
  assign stype = section.settings.schema_type | default: 'WebPage'
  assign page_url = canonical_url | default: shop.url
  assign webpage_id = page_url | append: '#webpage'
  assign org_id = shop.url | append: '/#organization'
-%}
{%- if stype == 'Service' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": {{ page_url | append: '#service' | json }},
  "name": {{ page_name | json }},
  "serviceType": {{ section.settings.service_type | default: 'Wholesale supply' | json }},
  "url": {{ page_url | json }}{% if desc != blank %},
  "description": {{ desc | strip_html | json }}{% endif %},
  "areaServed": "GB",
  "mainEntityOfPage": { "@id": {{ webpage_id | json }} },
  "provider": { "@id": {{ org_id | json }} }
}
</script>
{%- elsif stype != 'WebPage' or desc != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": {%- if stype == 'WebPage' %} "WebPage"{%- else %} ["WebPage", {{ stype | json }}]{%- endif %},
  "@id": {{ webpage_id | json }},
  "url": {{ page_url | json }},
  "name": {{ page_name | json }}{% if desc != blank %},
  "description": {{ desc | strip_html | json }}{% endif %},
  "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
  "about": { "@id": {{ org_id | json }} },
  "publisher": { "@id": {{ org_id | json }} },
  "inLanguage": "en-GB"
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Senseless — Page schema",
  "tag": "section",
  "class": "senseless-section senseless-page-schema",
  "settings": [
    { "type": "paragraph", "content": "Specialises the sitewide WebPage node (same @id) with a narrower type and a curated description. No visible output. Name defaults to the page title. Leave the type as WebPage and the description empty to rely entirely on the sitewide node." },
    { "type": "select", "id": "schema_type", "label": "Schema type", "default": "WebPage", "options": [ { "value": "WebPage", "label": "WebPage" }, { "value": "AboutPage", "label": "AboutPage" }, { "value": "ContactPage", "label": "ContactPage" }, { "value": "Service", "label": "Service (trade)" } ] },
    { "type": "text", "id": "service_type", "label": "Service type (Service only)", "default": "Wholesale supply" },
    { "type": "text", "id": "name", "label": "Name override (optional)" },
    { "type": "text", "id": "description", "label": "Description (optional)" }
  ],
  "presets": [ { "name": "Senseless — Page schema" } ]
}
{% endschema %}
