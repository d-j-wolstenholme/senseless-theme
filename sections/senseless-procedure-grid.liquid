{%- comment -%}
  Senseless — Procedure grid
  Umbrella-only grid of procedure cards (2-4 col responsive). Header + procedure_card blocks (image, label, optional sub-label, CTA).
  Anchor target #procedure-grid for hero CTAs. Reusable on the Aesthetic Numbing Cream umbrella and commercial landing pages.
{%- endcomment -%}

{%- style -%}

  .ss-procg {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-procg__inner { max-width: 1200px; margin: 0 auto; padding: 44px 20px; }
  .ss-procg__header { text-align: center; max-width: 62ch; margin: 0 auto 28px; display: flex; flex-direction: column; gap: 12px; }
  .ss-procg__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; line-height: 1.2; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-procg__headline { font-family: var(--ss-head); font-weight: 600; font-size: 28px; line-height: 1.2; margin: 0; }
  .ss-procg__body { font-family: var(--ss-sans); font-size: 17px; line-height: 1.55; color: var(--ss-body); margin: 0; }
  .ss-procg__body p { margin: 0; }

  .ss-procg__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }

  .ss-procg__card { position: relative; box-sizing: border-box; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; color: var(--ss-text); transition: transform 200ms ease-out, border-color 200ms ease-out; }
  .ss-procg__card:hover { transform: translateY(-2px); border-color: rgba(26,26,26,0.28); }
  .ss-procg__media { aspect-ratio: 1 / 1; background: var(--ss-bg); position: relative; }
  .ss-procg__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-procg__ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-procg__ph svg { width: 38%; opacity: 0.22; fill: var(--ss-purple); }
  .ss-procg__cbody { padding: 20px; display: flex; flex-direction: column; gap: 6px; flex: 1 1 auto; }
  .ss-procg__title { font-family: var(--ss-head); font-weight: 600; font-size: 18px; line-height: 1.3; margin: 0; }
  .ss-procg__sub { font-family: var(--ss-sans); font-size: 13px; line-height: 1.4; color: var(--ss-body); margin: 0; }
  .ss-procg__cta { margin-top: auto; padding-top: 10px; font-family: var(--ss-sans); font-weight: 500; font-size: 14px; color: var(--ss-purple); display: inline-flex; align-items: center; gap: 6px; }
  .ss-procg__cta::after { content: '\2192'; }

  .ss-procg__foot { margin-top: 32px; display: flex; justify-content: center; }
  .ss-procg__seeall { display: inline-flex; align-items: center; gap: 8px; height: 50px; padding: 0 28px; border-radius: 14px; border: 1px solid var(--ss-purple); color: var(--ss-purple); background: transparent; font-family: var(--ss-sans); font-weight: 600; font-size: 16px; text-decoration: none; transition: background-color 200ms ease-out, color 200ms ease-out; }
  .ss-procg__seeall::after { content: '\2192'; }
  .ss-procg__seeall:hover { background: var(--ss-purple); color: #ffffff; }

  @media (min-width: 768px) {
    .ss-procg--cols-3 .ss-procg__grid { grid-template-columns: repeat(3, 1fr); }
    .ss-procg--cols-4 .ss-procg__grid { grid-template-columns: repeat(4, 1fr); }
    .ss-procg__grid { gap: 24px; }
    .ss-procg__headline { font-size: 32px; }
  }
  @media (min-width: 1024px) { .ss-procg__inner { padding: 96px 40px; } }
  @media (prefers-reduced-motion: reduce) { .ss-procg__card { transition: none; } .ss-procg__card:hover { transform: none; } }
{%- endstyle -%}

<section class="ss-procg ss-procg--cols-{{ section.settings.columns }}" id="{{ section.settings.anchor_id | default: 'procedure-grid' | escape }}" aria-label="{{ section.settings.headline | default: 'Procedures' | escape }}">
  <div class="ss-procg__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.body != blank -%}
      <header class="ss-procg__header">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-procg__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-procg__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-procg__body">{{ section.settings.body }}</div>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="ss-procg__grid">
      {%- for block in section.blocks -%}
        <a class="ss-procg__card" href="{{ block.settings.cta_url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="ss-procg__media">
            {%- render 'senseless-card-image', image: block.settings.image, collection: block.settings.collection, alt: block.settings.image_alt, sizes: '(min-width: 768px) 25vw, 50vw', ph_class: 'ss-procg__ph' -%}
          </div>
          <div class="ss-procg__cbody">
            {%- if block.settings.label != blank -%}<h3 class="ss-procg__title">{{ block.settings.label | escape }}</h3>{%- endif -%}
            {%- if block.settings.sub_label != blank -%}<p class="ss-procg__sub">{{ block.settings.sub_label | escape }}</p>{%- endif -%}
            {%- if block.settings.cta_label != blank -%}<span class="ss-procg__cta">{{ block.settings.cta_label | escape }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="ss-procg__foot">
        <a class="ss-procg__seeall" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Procedures",
  "tag": "section",
  "class": "senseless-section senseless-procedure-grid",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "columns", "label": "Cards per row (desktop)", "default": "4", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "procedure-grid" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "richtext", "id": "body", "label": "Intro body" },
    { "type": "text", "id": "cta_label", "label": "Section CTA label", "info": "Optional 'see all' CTA below the cards." },
    { "type": "url", "id": "cta_url", "label": "Section CTA link" }
  ],
  "blocks": [
    {
      "type": "procedure_card",
      "name": "Procedure card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Linked collection", "info": "Card image is pulled from this collection's image (or its first product) unless an image is set below." },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Editorial product image for this procedure type" },
        { "type": "text", "id": "label", "label": "Procedure name", "default": "Lip Fillers" },
        { "type": "text", "id": "sub_label", "label": "Sub-label", "info": "Optional small line under the title." },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View range" },
        { "type": "url", "id": "cta_url", "label": "CTA link" }
      ]
    }
  ],
  "presets": [
    { "name": "Senseless — Procedure grid", "blocks": [ { "type": "procedure_card" }, { "type": "procedure_card" }, { "type": "procedure_card" } ] }
  ]
}
{% endschema %}
