{%- comment -%}
  Senseless — Policy page (metafield-driven, the Totally Numb way / Strand 5)
  ONE shared custom template for all 6 legal/policy pages (shipping-delivery, returns-refunds,
  privacy-policy, terms-conditions, cookie-policy, rewards-terms). Reads its content from PAGE
  metafields in the `policy` namespace — NOT the page body, NOT inline section settings:
    policy.prose_policy_body  (rich_text_field) — the designed long-form body (headed sections)
    policy.faq                (json: [{question, answer}]) — FAQ accordion
    policy.see_also           (json: [{label, url}]) — related-page links
    policy.last_updated       (date) — "Last updated" version date (Strand 5 versioning)
  Emits WebPage JSON-LD. Same chrome for every policy; content differs per page via metafields.
{%- endcomment -%}
{%- liquid
  assign mf = page.metafields.policy
  assign eyebrow = section.settings.eyebrow | default: 'Information'
  assign updated = mf.last_updated.value
-%}
{%- style -%}
  .ss-pol {
    --ss-purple: #6B3FA0; --ss-bg: #f7f7f5; --ss-surface: #ffffff; --ss-text: #1A1816;
    --ss-body: #2B2730; --ss-secondary: #5C5853; --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg); color: var(--ss-text); font-family: var(--ss-head);
  }
  .ss-pol__hero { background: var(--ss-bg); }
  .ss-pol__hero-inner { max-width: 760px; margin: 0 auto; padding: 56px 20px 24px; display: flex; flex-direction: column; gap: 12px; }
  .ss-pol__eyebrow { font-weight: 600; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-pol__title { font-weight: 400; letter-spacing: -0.02em; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; margin: 0; }
  @media (max-width: 749px) { .ss-pol__title { line-height: 1.12; } }
  .ss-pol__updated { font-size: 13px; color: var(--ss-secondary); margin: 4px 0 0; }
  .ss-pol__prose { background: var(--ss-surface); }
  .ss-pol__prose-inner { max-width: 760px; margin: 0 auto; padding: 40px 20px 48px; font-size: 16px; line-height: 1.65; color: var(--ss-body); }
  .ss-pol__prose-inner h2 { font-family: var(--ss-head); font-weight: 600; font-size: clamp(1.25rem, 1.18rem + 0.3vw, 1.375rem); line-height: 1.25; letter-spacing: -0.01em; color: var(--ss-text); margin: 32px 0 10px; }
  .ss-pol__prose-inner h2:first-child { margin-top: 0; }
  .ss-pol__prose-inner h3 { font-weight: 600; font-size: 16px; line-height: 1.25; letter-spacing: -0.01em; color: var(--ss-text); margin: 22px 0 8px; }
  .ss-pol__prose-inner p { margin: 0 0 14px; }
  .ss-pol__prose-inner ul, .ss-pol__prose-inner ol { margin: 0 0 14px; padding-left: 22px; }
  .ss-pol__prose-inner li { margin: 0 0 6px; }
  .ss-pol__prose-inner a { color: var(--ss-purple); }
  .ss-pol__prose-inner strong { color: var(--ss-text); }
  /* Highlighted delivery-option / threshold cards: any <ul class="ss-pol-cards"> in the prose */
  .ss-pol__prose-inner ul.ss-pol-cards { list-style: none; padding: 0; display: grid; gap: 12px; grid-template-columns: 1fr; margin: 4px 0 18px; }
  .ss-pol__prose-inner ul.ss-pol-cards li { background: var(--ss-bg); border: 1px solid var(--ss-border); border-radius: 4px; padding: 14px 16px; margin: 0; }
  @media (min-width: 700px) { .ss-pol__prose-inner ul.ss-pol-cards { grid-template-columns: 1fr 1fr 1fr; } }
  /* FAQ */
  .ss-pol__faq { background: var(--ss-bg); }
  .ss-pol__faq-inner { max-width: 760px; margin: 0 auto; padding: 44px 20px; }
  .ss-pol__faq-head { font-weight: 400; letter-spacing: -0.02em; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; margin: 0 0 20px; }
  @media (max-width: 749px) { .ss-pol__faq-head { line-height: 1.12; } }
  .ss-pol__item { border-bottom: 1px solid var(--ss-border); }
  .ss-pol__item:first-of-type { border-top: 1px solid var(--ss-border); }
  .ss-pol__q { font-weight: 500; font-size: clamp(1.0625rem, 1.01rem + 0.25vw, 1.125rem); line-height: 1.35; letter-spacing: -0.005em; color: var(--ss-text); cursor: pointer; list-style: none; padding: 18px 36px 18px 0; position: relative; }
  .ss-pol__q::-webkit-details-marker { display: none; }
  .ss-pol__q::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 19px; font-weight: 400; color: var(--ss-purple); line-height: 1; transition: transform 200ms ease-out; }
  .ss-pol__item[open] .ss-pol__q::after { content: '\2212'; }
  .ss-pol__a { font-size: 16px; line-height: 1.6; color: var(--ss-body); padding: 0 0 18px; }
  .ss-pol__a p { margin: 0 0 0.6em; } .ss-pol__a p:last-child { margin-bottom: 0; } .ss-pol__a a { color: var(--ss-purple); }
  /* See also */
  .ss-pol__see { background: var(--ss-surface); border-top: 1px solid var(--ss-border); }
  .ss-pol__see-inner { max-width: 760px; margin: 0 auto; padding: 28px 20px 40px; }
  .ss-pol__see-eyebrow { font-weight: 600; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0 0 10px; }
  .ss-pol__see-links { display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .ss-pol__see-links a { color: var(--ss-purple); text-decoration: none; font-size: 15px; }
  .ss-pol__see-links a:hover { text-decoration: underline; }
  @media (min-width: 990px) { .ss-pol__hero-inner { padding-top: 72px; } }
  @media (prefers-reduced-motion: reduce) { .ss-pol__q::after { transition: none; } }
{%- endstyle -%}
<div class="ss-pol">
  <header class="ss-pol__hero">
    <div class="ss-pol__hero-inner">
      <p class="ss-pol__eyebrow">{{ eyebrow | escape }}</p>
      <h1 class="ss-pol__title">{{ page.title | escape }}</h1>
      {%- if updated -%}<p class="ss-pol__updated">Last updated {{ updated | date: '%-d %B %Y' }}</p>{%- endif -%}
    </div>
  </header>

  {%- if mf.prose_policy_body != blank -%}
    <section class="ss-pol__prose" aria-label="{{ page.title | escape }}">
      <div class="ss-pol__prose-inner">{{ page.metafields.policy.prose_policy_body | metafield_tag }}</div>
    </section>
  {%- endif -%}

  {%- assign faq = mf.faq.value -%}
  {%- if faq != blank and faq.size > 0 -%}
    <section class="ss-pol__faq" id="faq" aria-label="Common questions">
      <div class="ss-pol__faq-inner">
        <h2 class="ss-pol__faq-head">Common questions</h2>
        {%- for item in faq -%}
          <details class="ss-pol__item"{% if forloop.first %} open{% endif %}>
            <summary class="ss-pol__q">{{ item.question | escape }}</summary>
            <div class="ss-pol__a">{{ item.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- assign see = mf.see_also.value -%}
  {%- if see != blank and see.size > 0 -%}
    <section class="ss-pol__see" aria-label="See also">
      <div class="ss-pol__see-inner">
        <p class="ss-pol__see-eyebrow">See also</p>
        <div class="ss-pol__see-links">
          {%- for l in see -%}<a href="{{ l.url }}">{{ l.label | escape }}</a>{%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ page.title | json }},
  "description": {{ page.metafields.global.description_tag.value | default: page.title | json }},
  "url": {{ request.origin | append: page.url | json }}{% if updated %},
  "dateModified": {{ updated | date: '%Y-%m-%d' | json }}{% endif %}
}
</script>

{% schema %}
{
  "name": "Policy page",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Content is read from this page's `policy` metafields (prose_policy_body, faq, see_also, last_updated). Assign this template to legal/policy pages." },
    { "type": "text", "id": "eyebrow", "label": "Hero eyebrow", "default": "Information" }
  ],
  "presets": [{ "name": "Policy page" }]
}
{% endschema %}
