{%- comment -%}
  Senseless — Product showcase
  Richer than a card row: each product is a generous feature row (image one side, roomy details the
  other) that alternates direction down the page. Professional = 2px purple border + filled CTA.
  More room per product than senseless-product-grid. Blocks carry their own copy.
{%- endcomment -%}

{%- style -%}

  .ss-ps {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-secondary: #5C5853;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-ps__inner { max-width: 1080px; margin: 0 auto; padding-block: 96px; padding-inline: 20px; }
  .ss-ps__header { text-align: center; max-width: 60ch; margin: 0 auto 36px; display: flex; flex-direction: column; gap: 12px; }
  .ss-ps__eyebrow { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-ps__headline { font-family: var(--ss-head); font-weight: 400; letter-spacing: -0.02em; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; margin: 0; }
  .ss-ps__intro { font-family: var(--ss-sans); font-size: 16px; line-height: 1.6; color: var(--ss-secondary); }
  .ss-ps__intro p { margin: 0; }

  .ss-ps__list { display: flex; flex-direction: column; gap: 20px; }
  .ss-ps__item { background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; display: grid; grid-template-columns: 1fr; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .ss-ps__item--flagship { border: 2px solid var(--ss-purple); }
  /* Click-through affordance: the row lifts, the image zooms, and a "View product" cue + title underline make the link target to the real PDP unmistakable. */
  .ss-ps__item:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(107,63,160,.14); border-color: #6B3FA0; }
  .ss-ps__item:hover .ss-ps__title a { color: #6B3FA0; text-decoration: underline; }
  .ss-ps__media { position: relative; aspect-ratio: 1 / 1; background: var(--ss-bg); display: block; }
  .ss-ps__media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .ss-ps__item:hover .ss-ps__media img { transform: scale(1.05); }
  .ss-ps__view { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 14px 10px; background: linear-gradient(to top, rgba(26,24,22,.72), rgba(26,24,22,0)); color: #fff; font-family: var(--ss-sans, 'Montserrat'); font-weight: 600; font-size: 13px; letter-spacing: .02em; opacity: 0; transform: translateY(6px); transition: opacity .2s ease, transform .2s ease; pointer-events: none; }
  .ss-ps__item:hover .ss-ps__view { opacity: 1; transform: translateY(0); }
  @media (prefers-reduced-motion: reduce) { .ss-ps__item, .ss-ps__media img, .ss-ps__view { transition: none; } .ss-ps__item:hover { transform: none; } .ss-ps__item:hover .ss-ps__media img { transform: none; } }
  .ss-ps__ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-ps__ph svg { width: 32%; opacity: 0.2; fill: var(--ss-purple); }
  .ss-ps__body { padding: 28px 24px; display: flex; flex-direction: column; gap: 8px; justify-content: center; }
  .ss-ps__label { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-ps__comfort { margin: 4px 0 6px; }
  .ss-ps__title { font-family: var(--ss-head); font-weight: 600; font-size: 22px; line-height: 1.2; margin: 0; }
  .ss-ps__title a { color: inherit; text-decoration: none; }
  .ss-ps__text { font-family: var(--ss-sans); font-size: 15px; line-height: 1.6; color: var(--ss-secondary); margin: 2px 0 0; }
  .ss-ps__text p { margin: 0; }
  .ss-ps__price { font-family: var(--ss-sans); font-weight: 500; font-size: 17px; margin: 6px 0 0; }
  .ss-ps__stars { margin: 2px 0 8px; min-height: 16px; }
  .ss-ps__stars:empty { display: none; }
  .ss-ps__cta { margin-top: 14px; align-self: flex-start; display: inline-flex; align-items: center; justify-content: center; height: 46px; padding: 0 22px; border-radius: 14px; border: 1px solid var(--ss-purple); color: var(--ss-purple); background: transparent; font-family: var(--ss-sans); font-weight: 500; font-size: 14px; text-decoration: none; transition: background-color 200ms ease-out, color 200ms ease-out, border-color 200ms ease-out; }
  .ss-ps__cta:hover { background: var(--ss-purple); color: #fff; border-color: var(--ss-purple); }
  .ss-ps__item--flagship .ss-ps__cta { background: var(--ss-purple); border-color: var(--ss-purple); color: #fff; }
  .ss-ps__item--flagship .ss-ps__cta:hover { background: var(--ss-purple-hover); border-color: var(--ss-purple-hover); }

  @media (min-width: 768px) {
    .ss-ps__item { grid-template-columns: 45% 55%; align-items: stretch; }
    .ss-ps__item--reverse .ss-ps__media { order: 2; }
    .ss-ps__item--reverse .ss-ps__body { order: 1; }
    .ss-ps__media { aspect-ratio: 1 / 1; }
    .ss-ps__body { padding: 36px 40px; }
  }
  @media (min-width: 1024px) { .ss-ps__title { font-size: 26px; } }
  @media (max-width: 989px) { .ss-ps__inner { padding-block: 56px; } }
  @media (max-width: 749px) { .ss-ps__inner { padding-block: 44px; } }
  @media (prefers-reduced-motion: reduce) { .ss-ps__cta { transition: none; } }
{%- endstyle -%}

<section class="ss-ps" aria-label="{{ section.settings.headline | default: 'Products' | escape }}">
  <div class="ss-ps__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.body != blank -%}
      <header class="ss-ps__header">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-ps__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-ps__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-ps__intro">{{ section.settings.body }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="ss-ps__list">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        {%- comment -%} Destination for the card media link: real product first, else the block's CTA url. {%- endcomment -%}
        {%- assign card_href = card_product.url | default: block.settings.cta_url -%}
        {%- comment -%} Resolve the comfort tier from the linked product's tags (PRODUCT cards only). {%- endcomment -%}
        {%- assign card_tier = '' -%}
        {%- if card_product != blank -%}{%- for t in card_product.tags -%}{%- assign tl = t | downcase -%}{%- if tl == 'clinical' or tl == 'advanced' or tl == 'professional' -%}{%- assign card_tier = tl -%}{%- endif -%}{%- endfor -%}{%- endif -%}
        {%- comment -%} Cue text: "View product" for real products, "View range" for a category/editorial card linking elsewhere. {%- endcomment -%}
        {%- if card_product != blank -%}{%- assign card_cue = 'View product' -%}{%- else -%}{%- assign card_cue = block.settings.cta_label | default: 'View' | escape -%}{%- endif -%}
        <div class="ss-ps__item{% if block.settings.flagship %} ss-ps__item--flagship{% endif %}{% cycle '', ' ss-ps__item--reverse' %}" {{ block.shopify_attributes }}>
          {%- if card_href != blank -%}
            <a class="ss-ps__media" href="{{ card_href }}"{% if card_product != blank %} aria-label="{{ card_product.title | escape }}"{% endif %}>
              {%- render 'senseless-card-image', image: block.settings.image, product: block.settings.product, alt: block.settings.image_alt, sizes: '(min-width: 768px) 45vw, 100vw', widths: '400, 700, 900', ph_class: 'ss-ps__ph', ph_icon: 'product-1' -%}
              <span class="ss-ps__view" aria-hidden="true">{{ card_cue }} &rarr;</span>
            </a>
          {%- else -%}
            <div class="ss-ps__media">
              {%- render 'senseless-card-image', image: block.settings.image, product: block.settings.product, alt: block.settings.image_alt, sizes: '(min-width: 768px) 45vw, 100vw', widths: '400, 700, 900', ph_class: 'ss-ps__ph', ph_icon: 'product-1' -%}
            </div>
          {%- endif -%}
          <div class="ss-ps__body">
            {%- if block.settings.label != blank -%}<p class="ss-ps__label">{{ block.settings.label | escape }}</p>{%- endif -%}
            {%- if card_tier != blank -%}<div class="ss-ps__comfort">{% render 'senseless-comfort-mark', tier: card_tier, name: false, size: 15, link: false %}</div>{%- endif -%}
            {%- assign card_title = block.settings.title | default: card_product.title -%}
            {%- if card_title != blank -%}<h3 class="ss-ps__title">{% if card_href != blank %}<a href="{{ card_href }}">{{ card_title | escape }}</a>{% else %}{{ card_title | escape }}{% endif %}</h3>{%- endif -%}
            {%- if block.settings.body != blank -%}<div class="ss-ps__text">{{ block.settings.body }}</div>{%- endif -%}
            {%- if card_product != blank and card_product.price > 0 -%}<p class="ss-ps__price">{{ card_product.price | money }}</p>{%- elsif block.settings.price != blank -%}<p class="ss-ps__price">{{ block.settings.price | escape }}</p>{%- endif -%}
            {%- if card_product != blank -%}<div class="ss-ps__stars jdgm-widget jdgm-preview-badge" data-id="{{ card_product.id }}" data-template="senseless-card"></div>{%- endif -%}
            {%- if block.settings.cta_label != blank -%}<a class="ss-ps__cta" href="{{ card_product.url | default: block.settings.cta_url | default: '#' }}">{{ block.settings.cta_label | escape }}</a>{%- endif -%}
            {%- if card_product != blank -%}{% render 'senseless-quick-add', product: card_product, section_id: section.id, uid: block.id %}{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Showcase",
  "tag": "section",
  "class": "senseless-section senseless-product-showcase",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "The range." },
    { "type": "richtext", "id": "body", "label": "Intro body" }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product", "info": "Image is pulled from this product's featured image unless an image is set below." },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless product on a warm off-white background" },
        { "type": "text", "id": "label", "label": "Label (eyebrow)", "default": "Clinical Strength" },
        { "type": "text", "id": "title", "label": "Title", "default": "Product name" },
        { "type": "richtext", "id": "body", "label": "Body" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View product" },
        { "type": "url", "id": "cta_url", "label": "CTA link" },
        { "type": "checkbox", "id": "flagship", "label": "Professional treatment (purple border + filled CTA)", "default": false }
      ]
    }
  ],
  "presets": [ { "name": "Senseless — Showcase", "blocks": [ { "type": "product_item" }, { "type": "product_item" } ] } ]
}
{% endschema %}
