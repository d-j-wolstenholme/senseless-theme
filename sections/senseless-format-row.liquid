{%- comment -%}
  Senseless — Format row
  The cream / gel / spray decision. Deliberately distinct from the portrait tier card row:
  typographic panels with a top accent rule, a large format name, a short descriptor and a
  text link — no portrait imagery — so the format choice doesn't read like the strength choice.
{%- endcomment -%}

{%- style -%}

  .ss-fr {
    --ss-purple: #6B3FA0;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-secondary: #5C5853;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-fr__inner { max-width: 1100px; margin: 0 auto; padding-block: 96px; padding-inline: 20px; }
  .ss-fr__header { text-align: center; max-width: 60ch; margin: 0 auto 32px; display: flex; flex-direction: column; gap: 12px; }
  .ss-fr__eyebrow { font-family: var(--ss-sans); font-weight: 600; font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-fr__headline { font-family: var(--ss-head); font-weight: 400; letter-spacing: -0.02em; font-size: clamp(1.875rem, 1.2rem + 3vw, 2.75rem); line-height: 1.1; margin: 0; }
  .ss-fr__intro { font-family: var(--ss-sans); font-size: 16px; line-height: 1.6; color: var(--ss-secondary); }
  .ss-fr__intro p { margin: 0; }

  .ss-fr__grid { display: grid; grid-template-columns: 1fr; gap: 16px; justify-content: center; }
  .ss-fr__item { position: relative; box-sizing: border-box; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; padding: 28px 24px 24px; display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ss-text); overflow: hidden; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .ss-fr__item::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--ss-purple); }
  .ss-fr__item:hover { transform: translateY(-4px); box-shadow: 0 14px 34px rgba(107,63,160,.14); border-color: #6B3FA0; }
  .ss-fr__item:hover .ss-fr__name { color: #6B3FA0; text-decoration: underline; }
  .ss-fr__name { font-family: var(--ss-head); font-weight: 600; font-size: clamp(1.25rem, 1.18rem + 0.3vw, 1.375rem); line-height: 1.25; letter-spacing: -0.01em; margin: 4px 0 0; }
  .ss-fr__desc { font-family: var(--ss-sans); font-size: 15px; line-height: 1.55; color: var(--ss-secondary); margin: 0; flex: 1 1 auto; }
  .ss-fr__desc p { margin: 0; }
  .ss-fr__link { margin-top: 8px; font-family: var(--ss-sans); font-weight: 500; font-size: 14px; color: var(--ss-purple); display: inline-flex; align-items: center; gap: 6px; opacity: .75; transform: translateY(2px); transition: opacity .2s ease, transform .2s ease, gap .2s ease; }
  .ss-fr__link::after { content: '\2192'; transition: transform .2s ease; }
  .ss-fr__item:hover .ss-fr__link { opacity: 1; transform: translateY(0); gap: 10px; }
  .ss-fr__item:hover .ss-fr__link::after { transform: translateX(2px); }
  .ss-fr__footer { text-align: center; margin: 28px 0 0; }
  .ss-fr__footerlink { font-family: var(--ss-sans); font-weight: 500; font-size: 14px; color: var(--ss-purple); text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .ss-fr__footerlink::after { content: '\2192'; }

  @media (min-width: 768px) { .ss-fr__grid { grid-template-columns: repeat(auto-fit, minmax(260px, 340px)); gap: 20px; } }
  @media (max-width: 989px) { .ss-fr__inner { padding-block: 56px; } }
  @media (max-width: 749px) { .ss-fr__inner { padding-block: 44px; } }
  @media (prefers-reduced-motion: reduce) { .ss-fr__item, .ss-fr__link, .ss-fr__link::after { transition: none; } .ss-fr__item:hover { transform: none; } .ss-fr__link { opacity: 1; transform: none; } }
{%- endstyle -%}

<section class="ss-fr" aria-label="{{ section.settings.headline | default: 'Formats' | escape }}">
  <div class="ss-fr__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank or section.settings.body != blank -%}
      <header class="ss-fr__header" data-ss-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="ss-fr__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-fr__headline">{% render 'senseless-accent', text: section.settings.headline, word: section.settings.accent_word %}</h2>{%- endif -%}
        {%- if section.settings.body != blank -%}<div class="ss-fr__intro">{{ section.settings.body }}</div>{%- endif -%}
      </header>
    {%- endif -%}
    <div class="ss-fr__grid" data-ss-reveal-group>
      {%- for block in section.blocks -%}
        {%- if block.settings.cta_url != blank -%}
          <a class="ss-fr__item" href="{{ block.settings.cta_url }}" {{ block.shopify_attributes }} data-ss-reveal>
            {%- if block.settings.label != blank -%}<h3 class="ss-fr__name">{{ block.settings.label | escape }}</h3>{%- endif -%}
            {%- if block.settings.body != blank -%}<div class="ss-fr__desc">{{ block.settings.body }}</div>{%- endif -%}
            <span class="ss-fr__link" aria-hidden="true">{{ block.settings.cta_label | default: 'View range' | escape }}</span>
          </a>
        {%- else -%}
          <div class="ss-fr__item" {{ block.shopify_attributes }} data-ss-reveal>
            {%- if block.settings.label != blank -%}<h3 class="ss-fr__name">{{ block.settings.label | escape }}</h3>{%- endif -%}
            {%- if block.settings.body != blank -%}<div class="ss-fr__desc">{{ block.settings.body }}</div>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.footer_label != blank -%}
      <div class="ss-fr__footer"><a class="ss-fr__footerlink" href="{{ section.settings.footer_url | default: '#' }}">{{ section.settings.footer_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Format row",
  "tag": "section",
  "class": "senseless-section senseless-format-row",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "By format" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Choose your format." },
    { "type": "text", "id": "accent_word", "label": "Italic accent word (one word, optional)" },
    { "type": "richtext", "id": "body", "label": "Intro body" },
    { "type": "text", "id": "footer_label", "label": "Footer cross-link label (optional)" },
    { "type": "url", "id": "footer_url", "label": "Footer cross-link URL (optional)" }
  ],
  "blocks": [
    {
      "type": "format_item",
      "name": "Format",
      "settings": [
        { "type": "text", "id": "label", "label": "Format name", "default": "Format" },
        { "type": "richtext", "id": "body", "label": "Descriptor", "default": "<p>The standard format.</p>" },
        { "type": "text", "id": "cta_label", "label": "Link label", "default": "View range" },
        { "type": "url", "id": "cta_url", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Senseless — Format row", "blocks": [ { "type": "format_item" }, { "type": "format_item" }, { "type": "format_item" } ] } ]
}
{% endschema %}
