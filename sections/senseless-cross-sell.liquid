{%- comment -%}
  Senseless — Cross-sell ("complete the system")
  Header + related product cards (label, title, one-line body, price, CTA). Flagship = 2px purple border, no badge.
  Reusable on product pages for the rest of the range and the aftercare cleanser.
{%- endcomment -%}

{%- style -%}

  .ss-xs {
    --ss-purple: #6B3FA0;
    --ss-purple-hover: #5A3489;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-border: #E5E2DC;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background: var(--ss-bg);
    color: var(--ss-text);
  }
  .ss-xs__inner { max-width: 1200px; margin: 0 auto; padding: 44px 20px; }
  .ss-xs__header { text-align: center; max-width: 60ch; margin: 0 auto 28px; display: flex; flex-direction: column; gap: 12px; }
  .ss-xs__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-xs__headline { font-family: var(--ss-head); font-weight: 600; font-size: 28px; line-height: 1.2; margin: 0; }

  .ss-xs__grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .ss-xs__card { position: relative; box-sizing: border-box; background: var(--ss-surface); border: 1px solid var(--ss-border); border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; color: var(--ss-text); transition: transform 200ms ease-out, border-color 200ms ease-out; }
  .ss-xs__cardlink { display: flex; flex-direction: column; text-decoration: none; color: inherit; flex: 1 1 auto; }
  .ss-xs__card .ss-qa { padding: 0 20px 20px; margin-top: 0; }
  .ss-xs__card:hover { transform: translateY(-2px); border-color: rgba(26,26,26,0.28); }
  .ss-xs__card--flagship { border: 2px solid var(--ss-purple); }
  .ss-xs__card--flagship:hover { border-color: var(--ss-purple); }
  .ss-xs__media { aspect-ratio: 1 / 1; background: var(--ss-bg); }
  .ss-xs__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ss-xs__ph { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
  .ss-xs__ph svg { width: 38%; opacity: 0.22; fill: var(--ss-purple); }
  .ss-xs__cbody { padding: 20px; display: flex; flex-direction: column; gap: 6px; flex: 1 1 auto; }
  .ss-xs__label { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-xs__title { font-family: var(--ss-head); font-weight: 600; font-size: 18px; line-height: 1.3; margin: 0; }
  .ss-xs__text { font-family: var(--ss-sans); font-size: 14px; line-height: 1.5; color: var(--ss-body); margin: 0; }
  .ss-xs__text p { margin: 0; }
  .ss-xs__price { font-family: var(--ss-sans); font-weight: 500; font-size: 16px; margin: 2px 0 0; }
  .ss-xs__cta { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; height: 44px; padding: 0 20px; border-radius: 14px; border: 1px solid var(--ss-purple); background: transparent; color: var(--ss-purple); font-family: var(--ss-sans); font-weight: 600; font-size: 14px; }
  .ss-xs__cta::after { content: '\2192'; }
  .ss-xs__card--flagship .ss-xs__cta { background: var(--ss-purple); color: #ffffff; }

  @media (min-width: 768px) {
    .ss-xs--cols-2 .ss-xs__grid { grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 760px; margin: 0 auto; }
    .ss-xs--cols-3 .ss-xs__grid { grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .ss-xs--cols-4 .ss-xs__grid { grid-template-columns: repeat(4, 1fr); gap: 24px; }
    .ss-xs__headline { font-size: 32px; }
  }
  @media (min-width: 1024px) { .ss-xs__inner { padding: 96px 40px; } }
  @media (prefers-reduced-motion: reduce) { .ss-xs__card { transition: none; } .ss-xs__card:hover { transform: none; } }
{%- endstyle -%}

<section class="ss-xs ss-xs--cols-{{ section.settings.columns }}" aria-label="{{ section.settings.headline | default: 'Complete the system' | escape }}">
  <div class="ss-xs__inner">
    {%- if section.settings.eyebrow != blank or section.settings.headline != blank -%}
      <header class="ss-xs__header">
        {%- if section.settings.eyebrow != blank -%}<p class="ss-xs__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.headline != blank -%}<h2 class="ss-xs__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="ss-xs__grid">
      {%- for block in section.blocks -%}
        {%- assign card_product = block.settings.product -%}
        {%- if card_product != blank -%}{%- assign card_href = card_product.url -%}{%- else -%}{%- assign card_href = block.settings.cta_url | default: '#' -%}{%- endif -%}
        <div class="ss-xs__card{% if block.settings.flagship %} ss-xs__card--flagship{% endif %}" {{ block.shopify_attributes }}>
          <a class="ss-xs__cardlink" href="{{ card_href }}">
            <div class="ss-xs__media">
              {%- render 'senseless-card-image', image: block.settings.image, product: block.settings.product, alt: block.settings.image_alt, sizes: '(min-width: 768px) 33vw, 100vw', ph_class: 'ss-xs__ph' -%}
            </div>
            <div class="ss-xs__cbody">
              {%- if block.settings.label != blank -%}<p class="ss-xs__label">{{ block.settings.label | escape }}</p>{%- endif -%}
              {%- if block.settings.title != blank -%}<h3 class="ss-xs__title">{{ block.settings.title | escape }}</h3>{%- elsif card_product != blank -%}<h3 class="ss-xs__title">{{ card_product.title | escape }}</h3>{%- endif -%}
              {%- if block.settings.body != blank -%}<div class="ss-xs__text">{{ block.settings.body }}</div>{%- endif -%}
              {%- if card_product != blank and card_product.price > 0 -%}<p class="ss-xs__price">{{ card_product.price | money }}</p>{%- elsif block.settings.price != blank -%}<p class="ss-xs__price">{{ block.settings.price | escape }}</p>{%- endif -%}
              {%- if card_product == blank and block.settings.cta_label != blank -%}<span class="ss-xs__cta">{{ block.settings.cta_label | escape }}</span>{%- endif -%}
            </div>
          </a>
          {%- if card_product != blank -%}{% render 'senseless-quick-add', product: card_product, section_id: section.id, uid: block.id %}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Cross-sell",
  "tag": "section",
  "class": "senseless-section senseless-cross-sell",
  "max_blocks": 4,
  "settings": [
    { "type": "select", "id": "columns", "label": "Cards per row (desktop)", "default": "3", "options": [ { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Complete the system." }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Linked product", "info": "Card image is pulled from this product's featured image unless an image is set below." },
        { "type": "image_picker", "id": "image", "label": "Image (override)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Senseless product on a warm off-white background" },
        { "type": "text", "id": "label", "label": "Label (eyebrow)", "default": "Clinical Strength" },
        { "type": "text", "id": "title", "label": "Title", "default": "Cream 10g" },
        { "type": "richtext", "id": "body", "label": "One-line body", "default": "<p>Smaller size, single appointment.</p>" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View product" },
        { "type": "url", "id": "cta_url", "label": "CTA link" },
        { "type": "checkbox", "id": "flagship", "label": "Professional treatment (purple border)", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Senseless — Cross-sell", "blocks": [ { "type": "product_card" }, { "type": "product_card" }, { "type": "product_card" } ] }
  ]
}
{% endschema %}
