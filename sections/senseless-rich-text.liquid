{%- comment -%}
  Senseless — Rich text
  Prose section for Guides: eyebrow + headline + rich body + optional CTA. Narrow measure for readability.
  Stack multiple instances for a multi-part guide. Background toggle (canvas / white) for visual rhythm.
{%- endcomment -%}

{%- style -%}

  .ss-rt {
    --ss-purple: #6B3FA0;
    --ss-bg: #f7f7f5;
    --ss-surface: #ffffff;
    --ss-text: #1A1816;
    --ss-body: #2B2730;
    --ss-head: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    --ss-sans: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--ss-text);
  }
  .ss-rt--canvas { background: var(--ss-bg); }
  .ss-rt--white { background: var(--ss-surface); }
  .ss-rt__inner { max-width: 720px; margin: 0 auto; padding: 40px 20px; display: flex; flex-direction: column; gap: 14px; }
  .ss-rt__eyebrow { font-family: var(--ss-sans); font-weight: 500; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ss-purple); margin: 0; }
  .ss-rt__headline { font-family: var(--ss-head); font-weight: 400; letter-spacing: -0.02em; font-size: 26px; line-height: 1.25; margin: 0; }
  .ss-rt__body { font-family: var(--ss-sans); font-size: 16px; line-height: 1.6; color: var(--ss-body); }
  .ss-rt__body p { margin: 0 0 14px; }
  .ss-rt__body h3 { font-family: var(--ss-head); font-weight: 600; font-size: 19px; line-height: 1.3; color: var(--ss-text); margin: 22px 0 8px; }
  .ss-rt__body ul, .ss-rt__body ol { margin: 0 0 14px; padding-left: 22px; }
  .ss-rt__body li { margin: 0 0 6px; }
  .ss-rt__body a { color: var(--ss-purple); }
  .ss-rt__cta { margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--ss-sans); font-weight: 500; font-size: 14px; color: var(--ss-purple); text-decoration: none; align-self: flex-start; }
  .ss-rt__cta::after { content: '\2192'; }

  @media (min-width: 1024px) {
    .ss-rt__inner { padding: 72px 40px; }
    .ss-rt__headline { font-size: 30px; }
  }
{%- endstyle -%}

<section class="ss-rt ss-rt--{{ section.settings.background }}" aria-label="{{ section.settings.headline | default: 'Section' | escape }}">
  <div class="ss-rt__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="ss-rt__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.headline != blank -%}<h2 class="ss-rt__headline">{{ section.settings.headline | escape }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="ss-rt__body">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.cta_label != blank -%}<a class="ss-rt__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Senseless — Rich text",
  "tag": "section",
  "class": "senseless-section senseless-rich-text",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "canvas", "options": [ { "value": "canvas", "label": "Canvas (warm)" }, { "value": "white", "label": "White" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline" },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ],
  "presets": [
    { "name": "Senseless — Rich text", "settings": { "headline": "Section heading", "body": "<p>Body copy.</p>" } }
  ]
}
{% endschema %}
