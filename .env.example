# Shopify — Senseless production store (primary domain: senseless.uk)
SHOPIFY_STORE=senseless-numbing.myshopify.com

# Live (published) theme — source of truth. Legacy var name; holds the LIVE theme id.
SHOPIFY_DEV_THEME_ID=199324434780

# Admin API custom-app credentials (products, collections, metafields, files).
# Requires a custom app installed on senseless-numbing; run scripts/refresh-token.sh
# to mint SHOPIFY_ACCESS_TOKEN from the Client ID/Secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_ACCESS_TOKEN=

# GitHub
GITHUB_TOKEN=
